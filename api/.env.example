PORT=3000
DATA_DIR=./data
# Generate with: bun scripts/set-password.ts <your-password>
ADMIN_PASSWORD_HASH=
# Set with: bun scripts/set-qrz-key.ts <your-qrz-api-key>
QRZ_API_KEY=
# Needed-DX email alerts are configured from /admin, not here — see
# alert_email_config in the database.
# FlexRadio local-network IP (port 4992/4991) for live station status on
# /radio. Set a DHCP reservation for the radio on your router so this stays
# stable. Leave blank to disable the feature entirely.
FLEX_RADIO_IP=
# Public URL this site is reachable at, used only for the "Live spots" link
# in needed-DX/VHF alert emails and pushes. Leave blank to omit the link.
SITE_URL=
# Where nightly database/photos backups are written -- defaults to
# api/backups (outside DATA_DIR on purpose, so a backup meant to protect
# against e.g. an external drive failing isn't stored on that same drive).
BACKUP_DIR=
# How many backups to keep on a rolling basis before pruning the oldest. Defaults to 3.
BACKUP_RETENTION_COUNT=
# systemd unit name for the API service -- only needs setting if you
# renamed it from what setup.sh installs it as ("hamstation-api"). Used to
# restart the service after a database restore (Admin -> Backups) so the
# process reopens the swapped-in file with a clean connection.
API_SERVICE_NAME=
