---
import '../styles/base.css';

interface Props {
  title: string;
  active?: 'home' | 'photos' | 'log' | 'map' | 'awards' | 'stats' | 'activations' | 'tools' | 'electronics' | 'reference' | 'conditions' | 'radio' | 'satellites' | 'kiwisdr' | 'about' | 'admin' | 'status' | 'guestbook';
}
const { title, active } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <!-- The callsign suffix is a placeholder here (this is a static-generated
         page, rendered once at build time) -- the script at the bottom of
         this file patches it to the real admin-configured callsign on load.
         data-page-title carries this page's own title through to that
         script, since {title} isn't otherwise accessible from plain JS. -->
    <title data-page-title={title}>{title} · Ham Station</title>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ham Station" />

    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme.
      const THEMES = ['light', 'dark', 'dracula', 'nord', 'amber', 'green', 'solarized', 'gruvbox', 'tokyonight', 'catppuccin'];
      const saved = localStorage.getItem('hamstation-theme');
      if (THEMES.includes(saved)) document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href="/"><span class="dot"></span><span id="brand-text">Ham Station</span></a>
      <nav id="site-nav">
        <a data-tile-id="about" href="/about" aria-current={active === 'about' ? 'page' : undefined}>About</a>
        <a data-tile-id="guestbook" href="/guestbook" aria-current={active === 'guestbook' ? 'page' : undefined}>Guestbook</a>
        <a data-tile-id="photos" href="/photos" aria-current={active === 'photos' ? 'page' : undefined}>Photos</a>
        <a data-tile-id="log" href="/log" aria-current={active === 'log' ? 'page' : undefined}>QSO Log</a>
        <a data-tile-id="map" href="/map" aria-current={active === 'map' ? 'page' : undefined}>QSO Map</a>
        <a data-tile-id="awards" href="/awards" aria-current={active === 'awards' ? 'page' : undefined}>Awards</a>
        <a data-tile-id="stats" href="/stats" aria-current={active === 'stats' ? 'page' : undefined}>Stats</a>
        <a data-tile-id="activations" href="/activations" aria-current={active === 'activations' ? 'page' : undefined}>Activations</a>
        <a data-tile-id="conditions" href="/conditions" aria-current={active === 'conditions' ? 'page' : undefined}>Conditions</a>
        <a data-tile-id="radio" href="/radio" aria-current={active === 'radio' ? 'page' : undefined}>Radio</a>
        <a data-tile-id="kiwisdr" href="/kiwisdr" aria-current={active === 'kiwisdr' ? 'page' : undefined}>KiwiSDR</a>
        <a data-tile-id="satellites" href="/satellites" aria-current={active === 'satellites' ? 'page' : undefined}>Satellites</a>
        <a data-tile-id="tools" href="/tools" aria-current={active === 'tools' ? 'page' : undefined}>Tools</a>
        <a data-tile-id="electronics" href="/electronics" aria-current={active === 'electronics' ? 'page' : undefined}>Electronics</a>
        <a data-tile-id="reference" href="/reference" aria-current={active === 'reference' ? 'page' : undefined}>Reference</a>
        <a data-tile-id="status" href="/status" aria-current={active === 'status' ? 'page' : undefined}>Status</a>
        <a data-tile-id="admin" href="/admin" aria-current={active === 'admin' ? 'page' : undefined}>Admin</a>
      </nav>
      <div class="theme-picker">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Change theme" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 2.5 2.5 0 0 0 1.8-4.2 1.7 1.7 0 0 1 1.2-2.9H17a5 5 0 0 0 5-5c0-4.4-4.5-8-10-8Z"/><circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="12" cy="7" r="1.2" fill="currentColor" stroke="none"/><circle cx="16.5" cy="10.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </button>
        <div class="theme-menu" id="theme-menu" role="menu" hidden></div>
      </div>
      <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </header>
    <main>
      <slot />
    </main>
    <footer>73 &middot; <span id="footer-callsign">Ham Station</span> &middot; served from a Raspberry Pi &middot; <a href="/about-this-site">Info</a></footer>

    <script>
      import { applyTileLayout } from '../lib/tileLayout';

      const navToggle = document.getElementById('nav-toggle')!;
      const siteNav = document.getElementById('site-nav')!;
      applyTileLayout('nav', siteNav);

      navToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = !siteNav.classList.contains('nav-open');
        siteNav.classList.toggle('nav-open', willOpen);
        navToggle.setAttribute('aria-expanded', String(willOpen));
      });
      document.addEventListener('click', (e) => {
        if (siteNav.classList.contains('nav-open') && !siteNav.contains(e.target as Node) && e.target !== navToggle) {
          siteNav.classList.remove('nav-open');
          navToggle.setAttribute('aria-expanded', 'false');
        }
      });

      const THEMES = [
        { value: '', label: 'Auto (System)', bg: null, accent: null },
        { value: 'light', label: 'Light', bg: '#f7f6f2', accent: '#0d9488' },
        { value: 'dark', label: 'Dark', bg: '#0b0d10', accent: '#5eead4' },
        { value: 'dracula', label: 'Dracula', bg: '#282a36', accent: '#8be9fd' },
        { value: 'nord', label: 'Nord', bg: '#2e3440', accent: '#88c0d0' },
        { value: 'amber', label: 'Amber Terminal', bg: '#120d08', accent: '#ffb000' },
        { value: 'green', label: 'Green Phosphor', bg: '#060a06', accent: '#3ddc84' },
        { value: 'solarized', label: 'Solarized Dark', bg: '#002b36', accent: '#2aa198' },
        { value: 'gruvbox', label: 'Gruvbox Dark', bg: '#282828', accent: '#fe8019' },
        { value: 'tokyonight', label: 'Tokyo Night', bg: '#1a1b26', accent: '#7aa2f7' },
        { value: 'catppuccin', label: 'Catppuccin Mocha', bg: '#1e1e2e', accent: '#cba6f7' },
      ];

      const toggle = document.getElementById('theme-toggle')!;
      const menu = document.getElementById('theme-menu')!;

      function currentTheme(): string {
        return document.documentElement.dataset.theme ?? '';
      }

      function updateMetaThemeColor(bg: string) {
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', bg));
      }

      function applyTheme(value: string) {
        if (value) {
          document.documentElement.dataset.theme = value;
          localStorage.setItem('hamstation-theme', value);
        } else {
          delete document.documentElement.dataset.theme;
          localStorage.removeItem('hamstation-theme');
        }
        const meta = THEMES.find((t) => t.value === value);
        const bg = meta?.bg ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? '#0b0d10' : '#f7f6f2');
        updateMetaThemeColor(bg);
        renderMenu();
      }

      function renderMenu() {
        const active = currentTheme();
        menu.innerHTML = '';
        for (const t of THEMES) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'theme-option' + (t.value === active ? ' active' : '');
          btn.setAttribute('role', 'menuitem');
          const swatch = t.bg
            ? `<span class="theme-swatch" style="background:${t.bg};"><span style="background:${t.accent}"></span></span>`
            : `<span class="theme-swatch theme-swatch-auto"></span>`;
          btn.innerHTML = `${swatch}${t.label}`;
          btn.addEventListener('click', () => {
            applyTheme(t.value);
            closeMenu();
          });
          menu.appendChild(btn);
        }
      }

      function openMenu() {
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      }
      function closeMenu() {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        if (menu.hidden) openMenu();
        else closeMenu();
      });
      document.addEventListener('click', (e) => {
        if (!menu.hidden && !menu.contains(e.target as Node) && e.target !== toggle) closeMenu();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      renderMenu();

      // Patches the build-time "Ham Station" placeholder with the real
      // admin-configured callsign -- this is a static-generated site (no
      // server-rendering per request), so the callsign can't be baked into
      // the HTML at build time the way it could on a per-operator fork;
      // this runs on every page via this shared layout instead. A brief
      // flash of the generic placeholder before this resolves is an
      // accepted tradeoff, same as every other piece of dynamic data on
      // this site (nothing here is server-rendered per request).
      fetch('/api/station-location')
        .then((r) => r.json())
        .then((data: { callsign: string | null }) => {
          if (!data.callsign) return;
          const titleEl = document.querySelector('title')!;
          const pageTitle = titleEl.dataset.pageTitle ?? '';
          document.title = pageTitle ? `${pageTitle} · ${data.callsign}` : data.callsign;
          document.querySelector('meta[name="apple-mobile-web-app-title"]')?.setAttribute('content', data.callsign);
          const brandText = document.getElementById('brand-text');
          if (brandText) brandText.textContent = data.callsign;
          const footerCallsign = document.getElementById('footer-callsign');
          if (footerCallsign) footerCallsign.textContent = data.callsign;
        })
        .catch(() => {
          // Static placeholder branding already shown -- nothing further to do.
        });
    </script>
  </body>
</html>
