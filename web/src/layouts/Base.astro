---
import '../styles/base.css';

interface Props {
  title: string;
  active?: 'home' | 'photos' | 'log' | 'map' | 'awards' | 'stats' | 'activations' | 'tools' | 'electronics' | 'reference' | 'conditions' | 'radio' | 'satellites' | 'kiwisdr' | 'digital-voice' | 'about' | 'admin' | 'status' | 'guestbook';
}
const { title, active } = Astro.props;

// The nav is grouped rather than one flat row of 18 links: dropdowns on
// desktop, a bottom tab bar + sheet on phones (same DOM, restyled in
// base.css). Each link keeps its data-tile-id so /admin's nav hide/reorder
// still applies -- within its group, since applyTileLayout runs per
// container. Icons are 24px stroke paths, drawn inline like the theme toggle.
const NAV_GROUPS = [
  {
    id: 'log',
    label: 'Log',
    icon: 'M4 4h16v16H4zM8 9h8M8 13h8M8 17h5',
    links: [
      { id: 'log', href: '/log', label: 'QSO Log' },
      { id: 'map', href: '/map', label: 'QSO Map' },
      { id: 'awards', href: '/awards', label: 'Awards' },
      { id: 'stats', href: '/stats', label: 'Stats' },
      { id: 'activations', href: '/activations', label: 'Activations' },
    ],
  },
  {
    id: 'onair',
    label: 'On Air',
    icon: 'M12 13v8M9 21h6M8.5 9.5a5 5 0 0 1 7 0M5.6 6.6a9 9 0 0 1 12.8 0M12 12.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
    links: [
      { id: 'conditions', href: '/conditions', label: 'Conditions' },
      { id: 'radio', href: '/radio', label: 'Radio' },
      { id: 'kiwisdr', href: '/kiwisdr', label: 'KiwiSDR' },
      { id: 'digital-voice', href: '/digital-voice', label: 'Digital Voice' },
      { id: 'satellites', href: '/satellites', label: 'Satellites' },
    ],
  },
  {
    id: 'tools',
    label: 'Tools',
    icon: 'M14.7 6.3a4 4 0 0 0-5.4 5.2L3 17.8V21h3.2l6.3-6.3a4 4 0 0 0 5.2-5.4l-2.6 2.6-2.4-.6-.6-2.4z',
    links: [
      { id: 'tools', href: '/tools', label: 'Tools' },
      { id: 'electronics', href: '/electronics', label: 'Electronics' },
      { id: 'reference', href: '/reference', label: 'Reference' },
    ],
  },
  {
    id: 'station',
    label: 'Station',
    icon: 'M3 21h18M5 21V10l7-6 7 6v11M10 21v-6h4v6',
    links: [
      { id: 'about', href: '/about', label: 'About' },
      { id: 'photos', href: '/photos', label: 'Photos' },
      { id: 'guestbook', href: '/guestbook', label: 'Guestbook' },
      { id: 'status', href: '/status', label: 'Status' },
      { id: 'admin', href: '/admin', label: 'Admin' },
    ],
  },
];
const activeGroup = NAV_GROUPS.find((g) => g.links.some((l) => l.id === active))?.id;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <!-- The callsign suffix is a placeholder here (this is a static-generated
         page, rendered once at build time) -- the script at the bottom of
         this file patches it to the real admin-configured callsign on load.
         data-page-title carries this page's own title through to that
         script, since {title} isn't otherwise accessible from plain JS. -->
    <title data-page-title={title}>{title} · Ham Station</title>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ham Station" />

    <script is:inline>
      // Applied before first paint to avoid a flash of the wrong theme/size.
      const THEMES = ['light', 'dark', 'dracula', 'nord', 'amber', 'green', 'solarized', 'gruvbox', 'tokyonight', 'catppuccin'];
      const saved = localStorage.getItem('hamstation-theme');
      if (THEMES.includes(saved)) document.documentElement.dataset.theme = saved;
      const TEXT_SIZES = ['large', 'larger'];
      const savedSize = localStorage.getItem('hamstation-textsize');
      if (TEXT_SIZES.includes(savedSize)) document.documentElement.dataset.textSize = savedSize;
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href="/"><span class="dot"></span><span id="brand-text">Ham Station</span></a>
      <nav id="site-nav" aria-label="Main">
        <a class="nav-home" href="/" aria-current={active === 'home' ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-7 9 7M5 10v10h14V10"/></svg>
          <span>Home</span>
        </a>
        {NAV_GROUPS.map((g) => (
          <div class="nav-group" data-group={g.id}>
            <button type="button" class="nav-group-btn" aria-expanded="false" aria-controls={`nav-menu-${g.id}`} data-active={g.id === activeGroup ? 'true' : undefined}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={g.icon} /></svg>
              <span>{g.label}</span>
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="nav-menu" id={`nav-menu-${g.id}`} hidden>
              <div class="nav-menu-title">{g.label}</div>
              {g.links.map((l) => (
                <a data-tile-id={l.id} href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>
              ))}
            </div>
          </div>
        ))}
      </nav>
      <div class="text-size-picker" role="group" aria-label="Text size">
        <button type="button" class="text-size-btn" id="text-size-normal" aria-label="Normal text size">A</button>
        <button type="button" class="text-size-btn" id="text-size-large" aria-label="Large text size">A</button>
        <button type="button" class="text-size-btn" id="text-size-larger" aria-label="Larger text size">A</button>
      </div>
      <div class="theme-picker">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Change theme" aria-haspopup="true" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 2.5 2.5 0 0 0 1.8-4.2 1.7 1.7 0 0 1 1.2-2.9H17a5 5 0 0 0 5-5c0-4.4-4.5-8-10-8Z"/><circle cx="7.5" cy="10.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="12" cy="7" r="1.2" fill="currentColor" stroke="none"/><circle cx="16.5" cy="10.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </button>
        <div class="theme-menu" id="theme-menu" role="menu" hidden></div>
      </div>
    </header>
    <div class="nav-scrim" id="nav-scrim" hidden></div>
    <main>
      <slot />
    </main>
    <footer>73 &middot; <span id="footer-callsign">Ham Station</span> &middot; served from a Raspberry Pi &middot; <a href="/about-this-site">Info</a> &middot; <a href="/api-docs">API</a></footer>

    <script>
      import { applyTileLayout } from '../lib/tileLayout';

      const siteNav = document.getElementById('site-nav')!;
      const navScrim = document.getElementById('nav-scrim')!;
      const navGroups = Array.from(siteNav.querySelectorAll<HTMLElement>('.nav-group'));

      // Admin hide/reorder, applied per group; a group whose links are all
      // hidden disappears instead of opening an empty menu.
      for (const group of navGroups) {
        const menu = group.querySelector<HTMLElement>('.nav-menu')!;
        applyTileLayout('nav', menu).then(() => {
          group.hidden = !menu.querySelector('a[data-tile-id]:not([hidden])');
        });
      }

      function closeNavMenus(except?: HTMLElement) {
        for (const group of navGroups) {
          if (group === except) continue;
          group.querySelector('.nav-group-btn')!.setAttribute('aria-expanded', 'false');
          group.querySelector<HTMLElement>('.nav-menu')!.hidden = true;
        }
        if (!except) navScrim.hidden = true;
      }
      for (const group of navGroups) {
        const btn = group.querySelector<HTMLButtonElement>('.nav-group-btn')!;
        const menu = group.querySelector<HTMLElement>('.nav-menu')!;
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const willOpen = menu.hidden;
          closeNavMenus(group);
          menu.hidden = !willOpen;
          btn.setAttribute('aria-expanded', String(willOpen));
          navScrim.hidden = !willOpen;
        });
      }
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.nav-menu')) closeNavMenus();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeNavMenus();
      });
      // Pages restored from the back/forward cache keep whatever menu was
      // open when the user tapped away.
      window.addEventListener('pageshow', () => closeNavMenus());

      // Text size -- three plain always-visible buttons rather than a
      // dropdown (like the theme picker), since there are only three states
      // and a reader who actually needs this shouldn't have to open a menu
      // to reach it. Scales the root font-size, which every rem-based size
      // on the site (nearly everything) already cascades from -- one rule
      // instead of touching every page's own font-size declarations.
      const textSizeButtons: Record<string, HTMLButtonElement> = {
        '': document.getElementById('text-size-normal') as HTMLButtonElement,
        large: document.getElementById('text-size-large') as HTMLButtonElement,
        larger: document.getElementById('text-size-larger') as HTMLButtonElement,
      };
      function applyTextSize(value: string) {
        if (value) {
          document.documentElement.dataset.textSize = value;
          localStorage.setItem('hamstation-textsize', value);
        } else {
          delete document.documentElement.dataset.textSize;
          localStorage.removeItem('hamstation-textsize');
        }
        for (const [v, btn] of Object.entries(textSizeButtons)) btn.classList.toggle('active', v === value);
      }
      for (const [value, btn] of Object.entries(textSizeButtons)) {
        btn.addEventListener('click', () => applyTextSize(value));
      }
      applyTextSize(document.documentElement.dataset.textSize ?? '');

      const THEMES = [
        { value: '', label: 'Auto (System)', bg: null, accent: null },
        { value: 'light', label: 'Light', bg: '#f7f6f2', accent: '#0d9488' },
        { value: 'dark', label: 'Dark', bg: '#0b0d10', accent: '#5eead4' },
        { value: 'dracula', label: 'Dracula', bg: '#282a36', accent: '#8be9fd' },
        { value: 'nord', label: 'Nord', bg: '#2e3440', accent: '#88c0d0' },
        { value: 'amber', label: 'Amber Terminal', bg: '#120d08', accent: '#ffb000' },
        { value: 'green', label: 'Green Phosphor', bg: '#060a06', accent: '#3ddc84' },
        { value: 'solarized', label: 'Solarized Dark', bg: '#002b36', accent: '#2aa198' },
        { value: 'gruvbox', label: 'Gruvbox Dark', bg: '#282828', accent: '#fe8019' },
        { value: 'tokyonight', label: 'Tokyo Night', bg: '#1a1b26', accent: '#7aa2f7' },
        { value: 'catppuccin', label: 'Catppuccin Mocha', bg: '#1e1e2e', accent: '#cba6f7' },
      ];

      const toggle = document.getElementById('theme-toggle')!;
      const menu = document.getElementById('theme-menu')!;

      function currentTheme(): string {
        return document.documentElement.dataset.theme ?? '';
      }

      function updateMetaThemeColor(bg: string) {
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute('content', bg));
      }

      function applyTheme(value: string) {
        if (value) {
          document.documentElement.dataset.theme = value;
          localStorage.setItem('hamstation-theme', value);
        } else {
          delete document.documentElement.dataset.theme;
          localStorage.removeItem('hamstation-theme');
        }
        const meta = THEMES.find((t) => t.value === value);
        const bg = meta?.bg ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? '#0b0d10' : '#f7f6f2');
        updateMetaThemeColor(bg);
        renderMenu();
      }

      function renderMenu() {
        const active = currentTheme();
        menu.innerHTML = '';
        for (const t of THEMES) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'theme-option' + (t.value === active ? ' active' : '');
          btn.setAttribute('role', 'menuitem');
          const swatch = t.bg
            ? `<span class="theme-swatch" style="background:${t.bg};"><span style="background:${t.accent}"></span></span>`
            : `<span class="theme-swatch theme-swatch-auto"></span>`;
          btn.innerHTML = `${swatch}${t.label}`;
          btn.addEventListener('click', () => {
            applyTheme(t.value);
            closeMenu();
          });
          menu.appendChild(btn);
        }
      }

      function openMenu() {
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
      }
      function closeMenu() {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        if (menu.hidden) openMenu();
        else closeMenu();
      });
      document.addEventListener('click', (e) => {
        if (!menu.hidden && !menu.contains(e.target as Node) && e.target !== toggle) closeMenu();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      renderMenu();

      // Patches the build-time "Ham Station" placeholder with the real
      // admin-configured callsign -- this is a static-generated site (no
      // server-rendering per request), so the callsign can't be baked into
      // the HTML at build time the way it could on a per-operator fork;
      // this runs on every page via this shared layout instead. A brief
      // flash of the generic placeholder before this resolves is an
      // accepted tradeoff, same as every other piece of dynamic data on
      // this site (nothing here is server-rendered per request).
      fetch('/api/station-location')
        .then((r) => r.json())
        .then((data: { callsign: string | null }) => {
          if (!data.callsign) return;
          const titleEl = document.querySelector('title')!;
          const pageTitle = titleEl.dataset.pageTitle ?? '';
          document.title = pageTitle ? `${pageTitle} · ${data.callsign}` : data.callsign;
          document.querySelector('meta[name="apple-mobile-web-app-title"]')?.setAttribute('content', data.callsign);
          const brandText = document.getElementById('brand-text');
          if (brandText) brandText.textContent = data.callsign;
          const footerCallsign = document.getElementById('footer-callsign');
          if (footerCallsign) footerCallsign.textContent = data.callsign;
        })
        .catch(() => {
          // Static placeholder branding already shown -- nothing further to do.
        });
    </script>
  </body>
</html>
