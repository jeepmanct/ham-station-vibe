---
import Base from '../layouts/Base.astro';
import '../styles/stats.css';
---
<Base title="Stats" active="stats">
  <h1>Stats</h1>
  <p class="lede">Log analytics &mdash; computed from every QSO on file.</p>

  <div class="stats-grid" id="summary-tiles">
    <div class="stat-tile"><div class="label">Total QSOs</div><div class="value" id="stat-total">&mdash;</div></div>
    <div class="stat-tile"><div class="label">Unique Calls</div><div class="value" id="stat-calls">&mdash;</div></div>
    <div class="stat-tile"><div class="label">Years Active</div><div class="value" id="stat-years">&mdash;</div><div class="sub" id="stat-years-sub"></div></div>
    <div class="stat-tile"><div class="label">Busiest Day</div><div class="value" id="stat-busiest">&mdash;</div><div class="sub" id="stat-busiest-sub"></div></div>
    <div class="stat-tile"><div class="label">Longest DX</div><div class="value" id="stat-dx">&mdash;</div><div class="sub" id="stat-dx-sub"></div></div>
  </div>

  <div id="stats-tiles">
  <div class="chart-section" data-tile-id="activity">
    <h2>Activity</h2>
    <p class="chart-desc">Days with at least one logged QSO, roughly the last year (53-week grid).</p>
    <div class="stats-grid" style="margin-top:0;">
      <div class="stat-tile"><div class="label">Longest Streak</div><div class="value" id="stat-longest-streak">&mdash;</div><div class="sub" id="stat-longest-streak-sub"></div></div>
      <div class="stat-tile"><div class="label">Current Streak</div><div class="value" id="stat-current-streak">&mdash;</div><div class="sub" id="stat-current-streak-sub"></div></div>
    </div>
    <div class="activity-heatmap-wrap">
      <div class="activity-heatmap-months" id="activity-heatmap-months"></div>
      <div class="activity-heatmap-body">
        <div class="activity-heatmap-daylabels"><span></span><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span></div>
        <div class="activity-heatmap" id="activity-heatmap"></div>
      </div>
    </div>
    <p class="heatmap-info" id="heatmap-info">Hover for a day's date and count &mdash; tap a day with QSOs to view them in the log.</p>
    <div class="heatmap-legend">
      <span>Less</span>
      <span class="heatmap-cell" data-level="0"></span>
      <span class="heatmap-cell" data-level="1"></span>
      <span class="heatmap-cell" data-level="2"></span>
      <span class="heatmap-cell" data-level="3"></span>
      <span class="heatmap-cell" data-level="4"></span>
      <span>More</span>
    </div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="operating-pattern">
    <h2>Operating Pattern</h2>
    <p class="chart-desc">When QSOs happen, by UTC hour and day of week &mdash; propagation and band conditions are a UTC-time question, not a local-clock one.</p>
    <div id="operating-heatmap"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="best-time-by-band">
    <h2>Best Time by Band</h2>
    <p class="chart-desc">UTC hour of day, top bands by QSO count &mdash; each row is scaled to its own busiest hour, since band volumes aren't comparable to each other. A dark cell means that hour is quiet <em>for that band specifically</em>, not overall.</p>
    <div id="band-hour-heatmap"></div>
  </div>

  <div class="chart-section" data-tile-id="qsos-per-year">
    <h2>QSOs Per Year</h2>
    <div class="chart-svg-wrap" id="chart-by-year"></div>
  </div>

  <div class="chart-row" style="margin-top:2rem;" data-tile-id="by-band-mode">
    <div class="chart-section" style="margin-top:0;">
      <h2>By Band</h2>
      <div class="chart-svg-wrap" id="chart-by-band"></div>
    </div>
    <div class="chart-section" style="margin-top:0;">
      <h2>By Mode</h2>
      <div class="chart-svg-wrap" id="chart-by-mode"></div>
    </div>
  </div>

  <div class="chart-section" data-tile-id="qsl-confirmation">
    <h2>QSL Confirmation</h2>
    <p class="chart-desc">Coverage across LoTW and eQSL &mdash; not paper cards, which this site has no way to track. Looking for who to follow up with? See <a href="/tools#confirmed-nowhere">Confirmed Nowhere</a> on Tools.</p>
    <div class="stats-grid" id="qsl-confirmation-tiles">
      <div class="stat-tile"><div class="label">Confirmed (Either)</div><div class="value" id="qsl-confirmed-either">&mdash;</div></div>
      <div class="stat-tile"><div class="label">LoTW</div><div class="value" id="qsl-confirmed-lotw">&mdash;</div></div>
      <div class="stat-tile"><div class="label">eQSL</div><div class="value" id="qsl-confirmed-eqsl">&mdash;</div></div>
      <div class="stat-tile"><div class="label">Both</div><div class="value" id="qsl-confirmed-both">&mdash;</div></div>
    </div>
    <p class="chart-desc" style="margin:1.25rem 0 0.4rem;">Confirmed by Year</p>
    <div class="chart-svg-wrap" id="chart-qsl-by-year"></div>
    <p class="chart-desc" id="qsl-velocity-note" style="margin-top:0.75rem;"></p>
  </div>

  <div class="chart-section" data-tile-id="distance">
    <h2>Distance</h2>
    <p class="chart-desc">Great-circle distance from home to each contact.</p>
    <div class="chart-row">
      <div>
        <p class="chart-desc" style="margin-bottom:0.4rem;">Distribution (miles)</p>
        <div class="chart-svg-wrap" id="chart-distance"></div>
      </div>
      <div>
        <p class="chart-desc" style="margin-bottom:0.4rem;">Top 10 Farthest DX</p>
        <div id="distance-leaderboard"></div>
      </div>
    </div>
  </div>

  <div class="chart-section" data-tile-id="solar-cycle-history">
    <h2>Solar Cycle History</h2>
    <p class="chart-desc">Yearly averages, 1947&ndash;present (Solar Flux Index has been recorded since 1947; K-index since 1932).</p>
    <div class="chart-row">
      <div>
        <p class="chart-desc" style="margin-bottom:0.4rem;">Solar Flux Index</p>
        <div class="chart-svg-wrap" id="chart-sfi"></div>
      </div>
      <div>
        <p class="chart-desc" style="margin-bottom:0.4rem;">K-Index</p>
        <div class="chart-svg-wrap" id="chart-k"></div>
      </div>
    </div>
    <p class="chart-desc" style="margin:1.25rem 0 0.4rem;">This Cycle vs. the Previous One (Solar Flux Index, aligned by year-into-cycle)</p>
    <div class="chart-svg-wrap" id="chart-cycle-compare"></div>
  </div>
  </div>

  <script>
    import { renderBarChart, renderLineChart, renderMultiLineChart } from '../lib/charts';
    import { fetchDistanceUnit, formatDistance } from '../lib/units';
    import { applyTileLayout, enableInlineTileEditing } from '../lib/tileLayout';

    applyTileLayout('stats', document.getElementById('stats-tiles')!);
    enableInlineTileEditing('stats', [document.getElementById('stats-tiles')!]);

    const style = getComputedStyle(document.documentElement);
    const ACCENT = style.getPropertyValue('--accent').trim();
    const ACCENT2 = style.getPropertyValue('--accent-2').trim();
    const BAND_VARS = ['--band-1', '--band-2', '--band-3', '--band-4', '--band-5', '--band-6', '--band-7', '--band-8'];
    const OTHER_COLOR = style.getPropertyValue('--band-other').trim();

    function formatDate(d: string) {
      if (d.length !== 8) return d;
      return `${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}`;
    }

    // --- Summary ---
    type Summary = {
      total: number;
      distinctCalls: number;
      busiestDay: { qso_date: string; count: number } | null;
      yearsActive: number;
      firstYear: string | null;
      lastYear: string | null;
    };
    fetch('/api/stats/summary')
      .then((r) => r.json())
      .then((s: Summary) => {
        document.getElementById('stat-total')!.textContent = s.total.toLocaleString();
        document.getElementById('stat-calls')!.textContent = s.distinctCalls.toLocaleString();
        // "Years active" needs a first-licensed year, which isn't tracked
        // anywhere in the app -- placeholder example only. Set your own
        // licensing year here, or remove this stat.
        const LICENSED_SINCE_YEAR = new Date().getFullYear();
        document.getElementById('stat-years')!.textContent = String(new Date().getFullYear() - LICENSED_SINCE_YEAR);
        document.getElementById('stat-years-sub')!.textContent = `Licensed since ${LICENSED_SINCE_YEAR}`;
        document.getElementById('stat-busiest')!.textContent = s.busiestDay ? String(s.busiestDay.count) + ' QSOs' : '—';
        document.getElementById('stat-busiest-sub')!.textContent = s.busiestDay ? formatDate(s.busiestDay.qso_date) : '';
      });

    type DistanceResp = {
      longest: { call: string; qsoDate: string; km: number } | null;
      topTen: { call: string; qsoDate: string; band: string | null; km: number }[];
      buckets: { min: number; max: number; count: number }[];
    };
    // The distance histogram itself is excluded from the unit toggle --
    // its buckets are computed server-side in fixed mile-wide ranges (see
    // /api/stats/distance), so re-labeling them in km after the fact would
    // either mislabel the actual bucket boundaries or require the backend
    // to bin twice. The "Longest DX" stat and Top 10 list below aren't
    // binned, so they follow the site-wide preference normally.
    Promise.all([fetch('/api/stats/distance').then((r) => r.json()), fetchDistanceUnit()])
      .then(([d, unit]: [DistanceResp, 'km' | 'mi']) => {
        if (d.longest) {
          document.getElementById('stat-dx')!.textContent = formatDistance(d.longest.km, unit);
          document.getElementById('stat-dx-sub')!.textContent = `${d.longest.call} · ${formatDate(d.longest.qsoDate)}`;
        }
        const chart = document.getElementById('chart-distance')!;
        const formatMi = (n: number) => (n >= 1000 ? `${n / 1000}k` : String(n));
        renderBarChart(
          chart,
          d.buckets.map((b) => ({ label: b.max >= 12500 ? `${formatMi(b.min)}+` : `${formatMi(b.min)}-${formatMi(b.max)}`, value: b.count })),
          ACCENT,
        );

        const leaderboard = document.getElementById('distance-leaderboard')!;
        leaderboard.innerHTML = '';
        d.topTen.forEach((r, i) => {
          const row = document.createElement('div');
          row.className = 'leaderboard-row';
          row.innerHTML = `
            <span class="rank">${i + 1}</span>
            <span><a class="call" href="https://www.qrz.com/db/${encodeURIComponent(r.call)}" target="_blank" rel="noopener">${r.call}</a><span class="band"> &middot; ${r.band ?? '—'} &middot; ${formatDate(r.qsoDate)}</span></span>
            <span class="km">${formatDistance(r.km, unit)}</span>
          `;
          leaderboard.appendChild(row);
        });
      });

    // --- Activity heatmap + streaks ---
    type ActivityResp = {
      daily: { date: string; count: number }[];
      longestStreak: { length: number; startDate: string; endDate: string };
      currentStreak: { length: number; startDate: string; endDate: string; active: boolean };
    };
    fetch('/api/stats/activity')
      .then((r) => r.json())
      .then((d: ActivityResp) => {
        document.getElementById('stat-longest-streak')!.textContent = `${d.longestStreak.length} day${d.longestStreak.length === 1 ? '' : 's'}`;
        document.getElementById('stat-longest-streak-sub')!.textContent = d.longestStreak.length
          ? `${formatDate(d.longestStreak.startDate)} – ${formatDate(d.longestStreak.endDate)}`
          : '';
        document.getElementById('stat-current-streak')!.textContent = `${d.currentStreak.length} day${d.currentStreak.length === 1 ? '' : 's'}`;
        document.getElementById('stat-current-streak-sub')!.textContent = d.currentStreak.length
          ? `${d.currentStreak.active ? 'ongoing, ' : 'ended '}${formatDate(d.currentStreak.endDate)}`
          : '';

        const countByDate = new Map(d.daily.map((r) => [r.date, r.count]));
        const maxCount = Math.max(1, ...d.daily.map((r) => r.count));
        const heatmap = document.getElementById('activity-heatmap')!;
        const monthsRow = document.getElementById('activity-heatmap-months')!;
        const heatmapInfo = document.getElementById('heatmap-info')!;
        heatmap.innerHTML = '';
        monthsRow.innerHTML = '';

        // Padded to start on a Sunday so the grid's 7 rows are consistent
        // calendar weekdays (row 1 = Monday, row 3 = Wednesday, ... matching
        // the Mon/Wed/Fri row labels) -- the un-padded version had no fixed
        // row-to-weekday mapping at all, since "370 days before today" lands
        // on a different weekday depending on what day "today" is.
        const today = new Date();
        const start = new Date(today);
        start.setDate(start.getDate() - 370);
        start.setDate(start.getDate() - start.getDay());

        const monthAbbrevs = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        let lastMonth = -1;
        for (let date = new Date(start); date <= today; date.setDate(date.getDate() + 1)) {
          const dow = date.getDay();
          if (dow === 0) {
            const label = document.createElement('span');
            if (date.getMonth() !== lastMonth) {
              label.textContent = monthAbbrevs[date.getMonth()];
              lastMonth = date.getMonth();
            }
            monthsRow.appendChild(label);
          }

          const isoDate = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
          const key = isoDate.replaceAll('-', '');
          const count = countByDate.get(key) ?? 0;
          const level = count === 0 ? 0 : Math.min(4, Math.ceil((count / maxCount) * 4));
          const cell = document.createElement('div');
          cell.className = 'heatmap-cell';
          cell.dataset.level = String(level);
          const label = `${formatDate(key)}: ${count} QSO${count === 1 ? '' : 's'}${count ? ' — tap to view' : ''}`;
          cell.title = label;
          // The native title tooltip above never shows on a touch device
          // (no hover state exists there) -- this visible info line is what
          // actually makes per-day detail reachable on mobile, via a plain
          // tap. Kept simple (updates one shared line) rather than a
          // per-cell floating tooltip, which would need real positioning
          // logic for comparatively little benefit here. A day with QSOs
          // is also a real link to that day's filtered log (empty days
          // aren't, since there's nothing there to jump to).
          cell.addEventListener('pointerenter', () => { heatmapInfo.textContent = label; });
          if (count > 0) {
            cell.addEventListener('click', () => {
              window.location.href = `/log?from=${isoDate}&to=${isoDate}`;
            });
          } else {
            cell.addEventListener('click', () => { heatmapInfo.textContent = label; });
          }
          heatmap.appendChild(cell);
        }
      });

    // --- Operating pattern (hour of day x day of week) ---
    fetch('/api/stats/activity-pattern')
      .then((r) => r.json())
      .then((d: { dayNames: string[]; grid: number[][] }) => {
        const maxCount = Math.max(1, ...d.grid.flat());
        let html = '<div class="op-heatmap-row op-heatmap-hours"><span></span>';
        for (let h = 0; h < 24; h++) html += `<span>${h % 3 === 0 ? String(h).padStart(2, '0') : ''}</span>`;
        html += '</div>';
        for (let dow = 0; dow < 7; dow++) {
          html += `<div class="op-heatmap-row"><span class="op-heatmap-daylabel">${d.dayNames[dow]}</span>`;
          for (let hour = 0; hour < 24; hour++) {
            const count = d.grid[dow][hour];
            const level = count === 0 ? 0 : Math.min(4, Math.ceil((count / maxCount) * 4));
            html += `<span class="heatmap-cell" data-level="${level}" title="${d.dayNames[dow]} ${String(hour).padStart(2, '0')}:00 UTC — ${count} QSO${count === 1 ? '' : 's'}"></span>`;
          }
          html += '</div>';
        }
        document.getElementById('operating-heatmap')!.innerHTML = html;
      });

    // --- Best time by band (hour of day, one row per band, each row scaled
    // to ITS OWN peak hour rather than a shared max -- band volumes differ
    // by an order of magnitude or more, so a global scale would flatten
    // every band but the busiest into invisible near-blank rows). ---
    fetch('/api/stats/band-hour-pattern')
      .then((r) => r.json())
      .then((d: { bands: string[]; grid: number[][] }) => {
        let html = '<div class="op-heatmap-row op-heatmap-hours"><span></span>';
        for (let h = 0; h < 24; h++) html += `<span>${h % 3 === 0 ? String(h).padStart(2, '0') : ''}</span>`;
        html += '</div>';
        d.bands.forEach((band, i) => {
          const row = d.grid[i];
          const maxCount = Math.max(1, ...row);
          html += `<div class="op-heatmap-row"><span class="op-heatmap-daylabel">${band}</span>`;
          for (let hour = 0; hour < 24; hour++) {
            const count = row[hour];
            const level = count === 0 ? 0 : Math.min(4, Math.ceil((count / maxCount) * 4));
            html += `<span class="heatmap-cell" data-level="${level}" title="${band} ${String(hour).padStart(2, '0')}:00 UTC — ${count} QSO${count === 1 ? '' : 's'}"></span>`;
          }
          html += '</div>';
        });
        document.getElementById('band-hour-heatmap')!.innerHTML = html || '<p class="chart-desc">No band/time data yet.</p>';
      });

    // --- QSOs per year ---
    fetch('/api/stats/by-year')
      .then((r) => r.json())
      .then((rows: { year: string; count: number }[]) => {
        renderBarChart(
          document.getElementById('chart-by-year')!,
          rows.map((r) => ({ label: r.year, value: r.count })),
          ACCENT,
        );
      });

    // --- Band breakdown (reuses the same band color assignment as the map/log pages) ---
    const bandColorIndex = new Map<string, number>();
    function colorForBand(band: string): string {
      if (!bandColorIndex.has(band) && bandColorIndex.size < BAND_VARS.length) {
        bandColorIndex.set(band, bandColorIndex.size);
      }
      const idx = bandColorIndex.get(band);
      return idx === undefined ? OTHER_COLOR : style.getPropertyValue(BAND_VARS[idx]).trim();
    }
    fetch('/api/qsos/bands')
      .then((r) => r.json())
      .then((rows: { band: string; count: number }[]) => {
        renderBarChart(
          document.getElementById('chart-by-band')!,
          rows.map((r) => ({ label: r.band, value: r.count, color: colorForBand(r.band) })),
          ACCENT,
        );
      });

    fetch('/api/qsos/modes')
      .then((r) => r.json())
      .then((rows: { mode: string; count: number }[]) => {
        renderBarChart(
          document.getElementById('chart-by-mode')!,
          rows.map((r) => ({ label: r.mode, value: r.count })),
          ACCENT2,
        );
      });

    // --- QSL confirmation coverage + per-year trend ---
    fetch('/api/stats/qsl-confirmation')
      .then((r) => r.json())
      .then(
        (d: {
          total: number;
          confirmedLotw: number;
          confirmedEqsl: number;
          confirmedEither: number;
          confirmedBoth: number;
          byYear: { year: string; total: number; confirmed: number }[];
        }) => {
          const pct = (n: number) => (d.total ? `${((n / d.total) * 100).toFixed(0)}%` : '—');
          document.getElementById('qsl-confirmed-either')!.textContent = `${pct(d.confirmedEither)} (${d.confirmedEither})`;
          document.getElementById('qsl-confirmed-lotw')!.textContent = `${pct(d.confirmedLotw)} (${d.confirmedLotw})`;
          document.getElementById('qsl-confirmed-eqsl')!.textContent = `${pct(d.confirmedEqsl)} (${d.confirmedEqsl})`;
          document.getElementById('qsl-confirmed-both')!.textContent = `${pct(d.confirmedBoth)} (${d.confirmedBoth})`;
          renderLineChart(
            document.getElementById('chart-qsl-by-year')!,
            d.byYear.map((r) => ({ x: Number(r.year), y: r.total ? (r.confirmed / r.total) * 100 : 0 })),
            ACCENT,
            { minY: 0, suffix: '%' },
          );
        },
      );

    // --- QSL confirmation velocity (projected time to next round-number milestone) ---
    fetch('/api/stats/qsl-velocity')
      .then((r) => r.json())
      .then(
        (d: {
          confirmedTotal: number;
          recentConfirmations90d: number;
          ratePerDay: number;
          nextMilestone: number;
          daysToMilestone: number | null;
          estimatedDate: string | null;
        }) => {
          const note = document.getElementById('qsl-velocity-note')!;
          if (d.daysToMilestone == null || d.ratePerDay <= 0) {
            note.textContent = `${d.recentConfirmations90d} new confirmations in the last 90 days.`;
            return;
          }
          const months = d.daysToMilestone / 30;
          const monthsText = months < 1 ? `${d.daysToMilestone} days` : `~${months.toFixed(1)} months`;
          const est = new Date(`${d.estimatedDate}T00:00:00`).toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
          note.textContent = `At the current pace (${d.recentConfirmations90d} confirmed in the last 90 days, ~${d.ratePerDay}/day), you'll hit ${d.nextMilestone.toLocaleString()} confirmed QSOs in ${monthsText} (around ${est}).`;
        },
      );

    // --- Propagation history (two small multiples, never one dual-axis chart) ---
    fetch('/api/solar/history')
      .then((r) => r.json())
      .then((rows: { year: string; avgSfi: number; avgK: number; avgA: number }[]) => {
        renderLineChart(
          document.getElementById('chart-sfi')!,
          rows.map((r) => ({ x: Number(r.year), y: r.avgSfi })),
          ACCENT,
          { minY: 0 },
        );
        renderLineChart(
          document.getElementById('chart-k')!,
          rows.map((r) => ({ x: Number(r.year), y: r.avgK })),
          ACCENT2,
          { minY: 0 },
        );

        // Cycle 24 started Dec 2008, Cycle 25 started Dec 2019 (both per
        // NOAA/NASA's own Solar Cycle Prediction Panel announcements, not
        // guessed) -- 11 years apart, aligned here by "years into cycle"
        // rather than calendar year so the two lines are actually
        // comparable at a glance instead of just offset copies of the
        // yearly chart above.
        const CURRENT_CYCLE_START = 2019;
        const PREVIOUS_CYCLE_START = 2008;
        const currentCycle = rows
          .filter((r) => Number(r.year) >= CURRENT_CYCLE_START)
          .map((r) => ({ x: Number(r.year) - CURRENT_CYCLE_START, y: r.avgSfi }));
        const previousCycle = rows
          .filter((r) => Number(r.year) >= PREVIOUS_CYCLE_START && Number(r.year) <= CURRENT_CYCLE_START)
          .map((r) => ({ x: Number(r.year) - PREVIOUS_CYCLE_START, y: r.avgSfi }));
        renderMultiLineChart(
          document.getElementById('chart-cycle-compare')!,
          [
            { label: `Cycle 25 (${CURRENT_CYCLE_START}–present)`, color: ACCENT, data: currentCycle },
            { label: `Cycle 24 (${PREVIOUS_CYCLE_START}–${CURRENT_CYCLE_START})`, color: ACCENT2, data: previousCycle },
          ],
          { minY: 0, formatX: (x) => `Yr ${x}` },
        );
      });
  </script>
</Base>
