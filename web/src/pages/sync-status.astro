---
import Base from '../layouts/Base.astro';
import '../styles/syncStatus.css';
---
<Base title="Sync Status" active="sync-status">
  <h1>Sync Status</h1>
  <p class="lede">When each external data source behind this site last actually pulled in fresh data &mdash; not the machine's health (see Device Stats), the data's.</p>

  <div class="card">
    <table>
      <thead>
        <tr><th>Source</th><th>Last Synced</th><th>Status</th></tr>
      </thead>
      <tbody id="sync-status-rows"></tbody>
    </table>
  </div>

  <script>
    type SyncStatus = {
      qrz: string | null;
      eqsl: string | null;
      lotw: string | null;
      solar: string | null;
      satelliteTle: string | null;
      clublogOqrs: string | null;
      clublogMostWanted: string | null;
    };

    // cadenceHours matches each source's actual systemd timer interval
    // (see deploy/*.timer) -- thresholds below are multiples of that, not
    // one fixed number for every source, since a weekly sync being 2 days
    // old is completely normal while a daily one being 2 days old is not.
    const SOURCES: { key: keyof SyncStatus; label: string; cadenceHours: number; cadenceLabel: string }[] = [
      { key: 'qrz', label: 'QRZ Logbook', cadenceHours: 24, cadenceLabel: 'daily' },
      { key: 'eqsl', label: 'eQSL.cc', cadenceHours: 24, cadenceLabel: 'daily' },
      { key: 'lotw', label: 'ARRL LoTW', cadenceHours: 24, cadenceLabel: 'daily' },
      { key: 'solar', label: 'Solar / Geomagnetic Data', cadenceHours: 24, cadenceLabel: 'daily' },
      { key: 'satelliteTle', label: 'Satellite TLEs', cadenceHours: 24, cadenceLabel: 'daily' },
      { key: 'clublogOqrs', label: 'Club Log OQRS List', cadenceHours: 168, cadenceLabel: 'weekly' },
      { key: 'clublogMostWanted', label: 'Club Log Most-Wanted', cadenceHours: 168, cadenceLabel: 'weekly' },
    ];

    // Two different formats show up in this same response: qrz/eqsl/lotw/
    // solar's getters return a real ISO string (their own JS-side trackers
    // already stamp it that way) while satelliteTle/clublogOqrs/
    // clublogMostWanted are a raw SQLite MAX(...) over datetime('now')
    // columns -- "YYYY-MM-DD HH:MM:SS" UTC, no timezone marker at all.
    // Handed straight to `new Date()`, browsers disagree on whether that
    // bare form is UTC or local (V8 treats it as local), which would throw
    // every staleness threshold off by this station's UTC offset. Detect
    // which shape it is rather than assuming one -- an already-ISO string
    // with a 'Z' blindly appended again parses as garbage (caught in
    // testing: real qrz/eqsl/lotw/solar responses already end in 'Z').
    function parseUtc(timestamp: string): Date {
      if (/Z$|[+-]\d{2}:\d{2}$/.test(timestamp)) return new Date(timestamp);
      return new Date(timestamp.replace(' ', 'T') + 'Z');
    }

    function formatAgo(date: Date): string {
      const seconds = Math.max(0, Math.round((Date.now() - date.getTime()) / 1000));
      if (seconds < 60) return 'just now';
      const minutes = Math.round(seconds / 60);
      if (minutes < 60) return `${minutes}m ago`;
      const hours = Math.round(minutes / 60);
      if (hours < 48) return `${hours}h ago`;
      return `${Math.round(hours / 24)}d ago`;
    }

    async function loadSyncStatus() {
      const res = await fetch('/api/sync-status');
      if (!res.ok) return;
      const status: SyncStatus = await res.json();
      const tbody = document.getElementById('sync-status-rows')!;
      tbody.innerHTML = '';

      for (const source of SOURCES) {
        const raw = status[source.key];
        const tr = document.createElement('tr');

        const nameTd = document.createElement('td');
        nameTd.textContent = source.label;
        const cadence = document.createElement('span');
        cadence.className = 'sync-status-cadence';
        cadence.textContent = ` (${source.cadenceLabel})`;
        nameTd.appendChild(cadence);

        const lastTd = document.createElement('td');
        const statusTd = document.createElement('td');
        const dot = document.createElement('span');
        dot.className = 'sync-status-dot';

        if (!raw) {
          lastTd.textContent = 'Never';
          dot.classList.add('critical');
          statusTd.append(dot, 'Never synced');
        } else {
          const date = parseUtc(raw);
          lastTd.textContent = `${formatAgo(date)} (${date.toLocaleString()})`;
          const ageHours = (Date.now() - date.getTime()) / 3_600_000;
          let label = 'Fresh';
          if (ageHours > source.cadenceHours * 3) {
            dot.classList.add('critical');
            label = 'Very stale';
          } else if (ageHours > source.cadenceHours * 1.5) {
            dot.classList.add('warning');
            label = 'Stale';
          }
          statusTd.append(dot, label);
        }

        tr.append(nameTd, lastTd, statusTd);
        tbody.appendChild(tr);
      }
    }

    loadSyncStatus();
    setInterval(loadSyncStatus, 60_000);
  </script>
</Base>
