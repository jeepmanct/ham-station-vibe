---
import Base from '../layouts/Base.astro';
import '../styles/kiwisdr.css';
---
<Base title="KiwiSDR" active="kiwisdr">
  <h1>KiwiSDR</h1>
  <p class="lede">Live audio from KiwiSDR at <span id="kiwi-lede-callsign">this station</span>.</p>

  <div id="kiwi-public-banner" class="card kiwi-public-banner" hidden>
    <span>Listening to a public receiver: <strong id="kiwi-public-banner-label"></strong></span>
    <button type="button" class="btn secondary" id="kiwi-public-reset-btn">Switch back to my station</button>
  </div>
  <button type="button" class="btn secondary" id="kiwi-public-browse-btn" style="margin-bottom:1rem;">Browse Public Receivers&hellip;</button>

  <div id="kiwi-public-modal-backdrop" class="eqsl-modal-backdrop" hidden>
    <div class="eqsl-modal" style="max-width:min(720px,100%);">
      <button type="button" id="kiwi-public-modal-close" class="btn secondary eqsl-modal-close">&times;</button>
      <h2 style="margin-top:0;">Public KiwiSDR Receivers</h2>
      <p class="chart-desc" style="margin:0 0 0.75rem;">Sorted by distance from this station. Only receivers currently online and accepting connections are listed.</p>
      <div class="kiwi-public-search-row">
        <input type="text" id="kiwi-public-search" placeholder="Search by name or location&hellip;" />
        <label class="kiwi-public-fav-filter">
          <input type="checkbox" id="kiwi-public-fav-only" /> &starf; Favorites only
        </label>
      </div>
      <p class="status-line" id="kiwi-public-status">Loading&hellip;</p>
      <div id="kiwi-public-rows" class="kiwi-public-list"></div>
    </div>
  </div>

  <div id="kiwi-unconfigured" class="card kiwi-unconfigured" hidden>
    KiwiSDR isn't configured yet &mdash; an admin needs to set its address under Admin &rarr; KiwiSDR Configuration.
  </div>

  <div id="kiwi-disabled" class="card kiwi-unconfigured" hidden>
    KiwiSDR is currently turned off.
  </div>

  <div id="kiwi-content" hidden>
    <div class="kiwi-viz-controls">
      <label>
        Color
        <select id="kiwi-colormap">
          <option value="inferno">Inferno</option>
          <option value="viridis">Viridis</option>
          <option value="classic">Classic SDR</option>
          <option value="turbo">Turbo</option>
          <option value="phosphor">Green Phosphor</option>
          <option value="ice">Ice</option>
          <option value="grayscale">Grayscale</option>
        </select>
      </label>
      <label>
        Style
        <select id="kiwi-spectrum-style">
          <option value="line">Line</option>
          <option value="bars">Bars</option>
          <option value="peak-hold">Peak Hold</option>
          <option value="filled">Filled Area</option>
          <option value="gradient-bars">Gradient Bars</option>
        </select>
      </label>
      <label>
        <input type="checkbox" id="kiwi-wf-enabled" checked /> Waterfall
      </label>
      <label>
        <input type="checkbox" id="kiwi-spectrum-enabled" checked /> Spectrum
      </label>
      <label>
        Zoom
        <select id="kiwi-wf-zoom">
          <option value="0">Full Band</option>
          <option value="6">Wide</option>
          <option value="10">Normal</option>
          <option value="12">Narrow</option>
          <option value="14">Max</option>
        </select>
      </label>
    </div>

    <div id="kiwi-waterfall-section">
      <div class="kiwi-waterfall-wrap">
        <canvas id="kiwi-spectrum" width="1024" height="90"></canvas>
        <canvas id="kiwi-waterfall" width="1024" height="88"></canvas>
        <div class="kiwi-freq-axis">
          <span id="kiwi-axis-low">&mdash;</span>
          <span id="kiwi-axis-center">&mdash;</span>
          <span id="kiwi-axis-high">&mdash;</span>
        </div>
      </div>
      <p class="status-line" id="kiwi-wf-status" style="margin-top:0.4rem;"></p>
    </div>

    <div class="card">
      <div class="kiwi-freq-display">
        <span id="kiwi-freq">7.2550</span><span class="unit">MHz</span>
        <select id="kiwi-tune-mode" class="kiwi-mode-select">
          <option value="lsb">LSB</option>
          <option value="usb">USB</option>
          <option value="am">AM</option>
          <option value="cw">CW</option>
          <option value="nbfm">NBFM</option>
        </select>
      </div>

      <div class="kiwi-radio-controls">
        <label>
          Bandwidth
          <select id="kiwi-bandwidth">
            <option value="narrow">Narrow</option>
            <option value="normal">Normal</option>
            <option value="wide">Wide</option>
          </select>
        </label>
        <label class="kiwi-agc-toggle">
          <input type="checkbox" id="kiwi-agc-enabled" checked /> AGC
        </label>
        <span class="status-line" id="kiwi-listener-count" style="margin:0;"></span>
        <span class="kiwi-site-listeners" id="kiwi-site-listeners" title="How many browsers on this site currently have audio open to this receiver"></span>
      </div>

      <!-- Only picks which step size the slider below nudges by -- the
           slider itself already covers both directions (drag left/right),
           so a separate plus/minus button for each size would just be a
           second control doing the same thing twice. -->
      <div class="kiwi-step-group">
        <button type="button" class="btn secondary kiwi-step" data-step-khz="1000">1MHz</button>
        <button type="button" class="btn secondary kiwi-step" data-step-khz="100">100kHz</button>
        <button type="button" class="btn secondary kiwi-step" data-step-khz="10">10kHz</button>
        <button type="button" class="btn secondary kiwi-step" data-step-khz="1">1kHz</button>
        <button type="button" class="btn secondary kiwi-step" data-step-khz="0.1">100Hz</button>
      </div>

      <div class="kiwi-slider-row">
        <input type="range" id="kiwi-freq-slider" min="-5" max="5" step="1" value="0" aria-label="Fine tune -- drag left or right" />
        <span class="kiwi-slider-hint" id="kiwi-slider-step-label">10kHz/step</span>
      </div>

      <div class="kiwi-smeter">
        <span class="label" style="color:var(--muted);font-size:0.78rem;">Signal</span>
        <div class="bar-track"><div class="bar-fill" id="kiwi-smeter-fill"></div></div>
        <span class="reading" id="kiwi-smeter-reading">&mdash;</span>
      </div>

      <div class="kiwi-audio-controls">
        <button type="button" class="btn" id="kiwi-startstop-btn">Start</button>
        <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.82rem;color:var(--muted);">
          Volume
          <input type="range" id="kiwi-volume" min="0" max="1" step="0.05" value="0.8" />
        </label>
        <span class="status-line" id="kiwi-audio-status" style="margin:0;"></span>
      </div>

      <div class="kiwi-cw-decoder">
        <label class="kiwi-cw-toggle" title="Adapts to the sender's speed automatically -- the first character or two after enabling (or after a long gap) may come out garbled while it locks on, same as any adaptive CW decoder.">
          <input type="checkbox" id="kiwi-cw-enabled" /> CW Decoder
        </label>
        <span class="status-line" id="kiwi-cw-status" style="margin:0;"></span>
        <button type="button" class="btn secondary" id="kiwi-cw-clear" style="padding:0.25rem 0.6rem;font-size:0.75rem;" hidden>Clear</button>
        <div class="kiwi-cw-output" id="kiwi-cw-output" hidden></div>
      </div>

      <div class="form-grid kiwi-quick-tune">
        <label>Ham Band
          <select id="kiwi-band-select">
            <option value="">Choose a band&hellip;</option>
            <option data-freq="1.900" data-mode="lsb">160m</option>
            <option data-freq="3.750" data-mode="lsb">80m</option>
            <option data-freq="5.357" data-mode="usb">60m</option>
            <option data-freq="7.255" data-mode="lsb">40m</option>
            <option data-freq="10.130" data-mode="cw">30m</option>
            <option data-freq="14.230" data-mode="usb">20m</option>
            <option data-freq="18.130" data-mode="usb">17m</option>
            <option data-freq="21.300" data-mode="usb">15m</option>
            <option data-freq="24.950" data-mode="usb">12m</option>
            <option data-freq="28.400" data-mode="usb">10m</option>
          </select>
        </label>
        <label>WWV
          <select id="kiwi-time-select">
            <option value="">Choose&hellip;</option>
            <option data-freq="2.500" data-mode="am">WWV 2.5 MHz</option>
            <option data-freq="5.000" data-mode="am">WWV 5 MHz</option>
            <option data-freq="10.000" data-mode="am">WWV 10 MHz</option>
            <option data-freq="15.000" data-mode="am">WWV 15 MHz</option>
            <option data-freq="20.000" data-mode="am">WWV 20 MHz</option>
            <option data-freq="3.330" data-mode="am">CHU 3.33 MHz</option>
          </select>
        </label>
        <label>Shortwave
          <select id="kiwi-sw-select">
            <option value="">Choose&hellip;</option>
            <option data-freq="1.000" data-mode="am">Mediumwave AM</option>
            <option data-freq="6.070" data-mode="am">49m Broadcast</option>
            <option data-freq="7.200" data-mode="am">41m Broadcast</option>
            <option data-freq="9.500" data-mode="am">31m Broadcast</option>
            <option data-freq="11.700" data-mode="am">25m Broadcast</option>
            <option data-freq="15.100" data-mode="am">19m Broadcast</option>
          </select>
        </label>
        <p id="kiwi-tune-status" class="status-line"></p>
      </div>
    </div>
  </div>

  <script>
    import { MORSE_DECODE } from '../lib/morse';
    import { dbmToSUnit } from '../lib/units';
    import { pollWhileVisible } from '../lib/polling';

    type KiwiSdrStatus = {
      configured: boolean;
      enabled: boolean;
      sndConnected: boolean;
      wfConnected: boolean;
      freqKhz: number;
      mode: string;
      sampleRate: number | null;
      smeterDbm: number | null;
      bandwidth: 'narrow' | 'normal' | 'wide';
      lowCutHz: number;
      highCutHz: number;
      agcEnabled: boolean;
      wfZoom: number;
      maxWfZoom: number;
      listenerCount: number | null;
      listenerMax: number | null;
      source: { isPublic: boolean; label: string };
      siteListeners: number;
    };

    type PublicKiwiEntry = {
      id: string;
      name: string;
      location: string;
      users: number;
      usersMax: number;
      bestSnr: number | null;
      distanceKm: number | null;
    };

    let stationCallsign = 'this station';
    const ledeCallsignEl = document.getElementById('kiwi-lede-callsign')!;
    fetch('/api/station-location')
      .then((r) => r.json())
      .then((d: { callsign: string | null }) => {
        if (d.callsign) {
          stationCallsign = d.callsign;
          ledeCallsignEl.textContent = stationCallsign;
        }
      })
      .catch(() => {});

    const unconfiguredEl = document.getElementById('kiwi-unconfigured')!;
    const disabledEl = document.getElementById('kiwi-disabled')!;
    const contentEl = document.getElementById('kiwi-content')!;
    const freqEl = document.getElementById('kiwi-freq')!;
    const smeterFill = document.getElementById('kiwi-smeter-fill')!;
    const smeterReading = document.getElementById('kiwi-smeter-reading')!;
    const startStopBtn = document.getElementById('kiwi-startstop-btn') as HTMLButtonElement;
    const volumeSlider = document.getElementById('kiwi-volume') as HTMLInputElement;
    const audioStatus = document.getElementById('kiwi-audio-status')!;
    const wfStatus = document.getElementById('kiwi-wf-status')!;
    const wfWrap = document.querySelector('.kiwi-waterfall-wrap') as HTMLElement;
    const wfEnabledCheckbox = document.getElementById('kiwi-wf-enabled') as HTMLInputElement;
    const spectrumEnabledCheckbox = document.getElementById('kiwi-spectrum-enabled') as HTMLInputElement;
    const canvas = document.getElementById('kiwi-waterfall') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const spectrumCanvas = document.getElementById('kiwi-spectrum') as HTMLCanvasElement;
    const spectrumCtx = spectrumCanvas.getContext('2d')!;
    const axisLow = document.getElementById('kiwi-axis-low')!;
    const axisCenter = document.getElementById('kiwi-axis-center')!;
    const axisHigh = document.getElementById('kiwi-axis-high')!;
    const tuneMode = document.getElementById('kiwi-tune-mode') as HTMLSelectElement;
    const bandwidthSelect = document.getElementById('kiwi-bandwidth') as HTMLSelectElement;
    const agcCheckbox = document.getElementById('kiwi-agc-enabled') as HTMLInputElement;
    const listenerCountEl = document.getElementById('kiwi-listener-count')!;
    const siteListenersEl = document.getElementById('kiwi-site-listeners')!;
    const wfZoomSelect = document.getElementById('kiwi-wf-zoom') as HTMLSelectElement;
    const bandSelect = document.getElementById('kiwi-band-select') as HTMLSelectElement;
    const timeSelect = document.getElementById('kiwi-time-select') as HTMLSelectElement;
    const swSelect = document.getElementById('kiwi-sw-select') as HTMLSelectElement;
    const tuneStatus = document.getElementById('kiwi-tune-status')!;
    const freqSlider = document.getElementById('kiwi-freq-slider') as HTMLInputElement;
    const sliderStepLabel = document.getElementById('kiwi-slider-step-label')!;
    const publicBanner = document.getElementById('kiwi-public-banner')!;
    const publicBannerLabel = document.getElementById('kiwi-public-banner-label')!;

    let lastStatus: KiwiSdrStatus | null = null;
    let lastSourceLabel: string | null = null;
    // Tracks the current frequency in MHz for the controls that need to read
    // it back (mode-only retune, step buttons, click-to-tune) now that there's
    // no visible frequency text field to read from directly.
    let currentFreqMhz = 7.255;

    // Every loadStatus() call gets a ticket; a response only gets applied
    // if no NEWER call has been made since it went out. Without this, the
    // 3s poll interval and an explicit post-action refresh (e.g. right
    // after clicking "Switch back to my station") can have two requests
    // in flight at once, and network timing gives no guarantee the older
    // one's response arrives first -- a stale response landing after the
    // fresh one would silently revert the UI back to the previous
    // receiver until the next poll tick caught up.
    let statusRequestTicket = 0;

    async function loadStatus() {
      const ticket = ++statusRequestTicket;
      const res = await fetch('/api/kiwisdr/status');
      if (ticket !== statusRequestTicket) return;
      if (!res.ok) return;
      const s: KiwiSdrStatus = await res.json();
      if (ticket !== statusRequestTicket) return;
      lastStatus = s;
      // A receiver switch means a different noise floor/signal
      // characteristic entirely -- whatever the CW decoder had adapted
      // to (or was mid-character on) no longer applies.
      if (s.source.label !== lastSourceLabel) {
        lastSourceLabel = s.source.label;
        cwResetDecoder();
      }
      unconfiguredEl.hidden = s.configured;
      disabledEl.hidden = !s.configured || s.enabled;
      contentEl.hidden = !s.configured || !s.enabled;
      publicBanner.hidden = !s.source.isPublic;
      if (s.source.isPublic) {
        publicBannerLabel.textContent = s.source.label;
        ledeCallsignEl.textContent = s.source.label;
      } else {
        publicBannerLabel.textContent = '';
        ledeCallsignEl.textContent = stationCallsign;
      }
      if (!s.configured || !s.enabled) return;

      // Don't stomp on what the visitor is mid-selecting/dragging in the
      // tune controls -- other listeners' retunes (or this device's own
      // last tune) still update everything else whenever it isn't actively
      // in use. The slider is a relative jog, not bound to freqKhz at all,
      // so it's excluded here rather than checked against activeElement.
      if (document.activeElement !== freqSlider) freqEl.textContent = (s.freqKhz / 1000).toFixed(4);
      currentFreqMhz = s.freqKhz / 1000;
      if (document.activeElement !== tuneMode) tuneMode.value = s.mode;
      if (document.activeElement !== bandwidthSelect) bandwidthSelect.value = s.bandwidth;
      if (document.activeElement !== agcCheckbox) agcCheckbox.checked = s.agcEnabled;
      if (document.activeElement !== wfZoomSelect) wfZoomSelect.value = String(s.wfZoom);
      WF_SPAN_KHZ = 30000 / 2 ** s.wfZoom;
      updateFreqAxis(s.freqKhz);
      listenerCountEl.textContent =
        s.listenerCount != null && s.listenerMax != null
          ? `${s.listenerCount} of ${s.listenerMax} receive channel${s.listenerMax === 1 ? '' : 's'} in use`
          : '';
      siteListenersEl.textContent = `🎧 ${s.siteListeners} listening on this site now`;
      cwSyncStatus();

      if (s.smeterDbm == null) {
        smeterFill.style.width = '0%';
        smeterReading.textContent = '—';
      } else {
        const pct = Math.max(0, Math.min(100, ((s.smeterDbm + 127) / 100) * 100));
        smeterFill.style.width = `${pct}%`;
        smeterReading.textContent = `${dbmToSUnit(s.smeterDbm)} (${s.smeterDbm.toFixed(0)}dBm)`;
      }
    }
    loadStatus();
    pollWhileVisible(loadStatus, 3000);

    // --- Public receiver picker ---
    // Switching source is open to everyone, same as tuning -- see
    // switchToPublicReceiver()'s comment in kiwiSdr.ts for why that's safe
    // (the id is validated server-side against its own cached directory
    // fetch, not trusted as a raw host/port).
    const publicModalBackdrop = document.getElementById('kiwi-public-modal-backdrop')!;
    const publicSearchInput = document.getElementById('kiwi-public-search') as HTMLInputElement;
    const publicFavOnlyCheckbox = document.getElementById('kiwi-public-fav-only') as HTMLInputElement;
    const publicStatus = document.getElementById('kiwi-public-status')!;
    const publicRows = document.getElementById('kiwi-public-rows')!;
    let publicEntries: PublicKiwiEntry[] = [];

    // Favorited receivers, by id (hostname:port) -- just the id set, not a
    // copy of the entry's data, since that data (users/SNR/online-ness)
    // only means anything as of the CURRENT directory fetch. A favorited
    // receiver that's gone offline or dropped out of the live list (full,
    // now proxy-relayed, etc.) simply won't appear, same as any other
    // entry -- no separate "stale favorite" state to reconcile.
    const FAVORITES_KEY = 'kiwi_public_favorites';
    function getFavorites(): Set<string> {
      try {
        return new Set(JSON.parse(localStorage.getItem(FAVORITES_KEY) ?? '[]'));
      } catch {
        return new Set();
      }
    }
    function toggleFavorite(id: string) {
      const favs = getFavorites();
      if (favs.has(id)) favs.delete(id);
      else favs.add(id);
      localStorage.setItem(FAVORITES_KEY, JSON.stringify([...favs]));
    }

    function closePublicModal() {
      publicModalBackdrop.setAttribute('hidden', '');
    }
    document.getElementById('kiwi-public-modal-close')!.addEventListener('click', closePublicModal);
    publicModalBackdrop.addEventListener('click', (e) => {
      if (e.target === publicModalBackdrop) closePublicModal();
    });

    function renderPublicRows() {
      const query = publicSearchInput.value.trim().toLowerCase();
      const favs = getFavorites();
      let filtered = query
        ? publicEntries.filter((e) => `${e.name} ${e.location}`.toLowerCase().includes(query))
        : publicEntries;
      if (publicFavOnlyCheckbox.checked) filtered = filtered.filter((e) => favs.has(e.id));
      // Stable sort -- favorites first, otherwise keep the server's
      // distance order (Array.prototype.sort is guaranteed stable, so
      // this doesn't reshuffle within each group).
      filtered = [...filtered].sort((a, b) => Number(favs.has(b.id)) - Number(favs.has(a.id)));
      publicRows.innerHTML = '';
      if (filtered.length === 0) {
        publicStatus.textContent = publicFavOnlyCheckbox.checked
          ? 'No favorites yet -- click the star on a receiver to save it here.'
          : publicEntries.length === 0
            ? 'No public receivers available right now.'
            : 'No receivers match that search.';
        return;
      }
      publicStatus.textContent = '';
      for (const entry of filtered) {
        const row = document.createElement('div');
        row.className = 'kiwi-public-row';

        const favBtn = document.createElement('button');
        favBtn.type = 'button';
        favBtn.className = 'kiwi-public-row-fav';
        const isFav = favs.has(entry.id);
        favBtn.textContent = isFav ? '★' : '☆'; // ★ / ☆
        favBtn.classList.toggle('is-favorite', isFav);
        favBtn.setAttribute('aria-label', isFav ? 'Remove from favorites' : 'Add to favorites');
        favBtn.addEventListener('click', () => {
          toggleFavorite(entry.id);
          renderPublicRows();
        });

        const info = document.createElement('div');
        info.className = 'kiwi-public-row-info';
        const nameEl = document.createElement('div');
        nameEl.className = 'kiwi-public-row-name';
        nameEl.textContent = entry.name;
        const metaEl = document.createElement('div');
        metaEl.className = 'kiwi-public-row-meta';
        const metaParts = [
          entry.location || null,
          entry.distanceKm != null ? `${entry.distanceKm.toLocaleString()} km` : null,
          `${entry.users}/${entry.usersMax} users`,
          entry.bestSnr != null ? `SNR ${entry.bestSnr} dB` : null,
        ].filter(Boolean);
        metaEl.textContent = metaParts.join(' · ');
        info.append(nameEl, metaEl);

        const listenBtn = document.createElement('button');
        listenBtn.type = 'button';
        listenBtn.className = 'btn secondary kiwi-public-row-listen';
        listenBtn.textContent = 'Listen';
        listenBtn.addEventListener('click', () => switchToPublicEntry(entry.id, listenBtn));

        row.append(favBtn, info, listenBtn);
        publicRows.appendChild(row);
      }
    }
    publicSearchInput.addEventListener('input', renderPublicRows);
    publicFavOnlyCheckbox.addEventListener('change', renderPublicRows);

    async function loadPublicDirectory() {
      publicStatus.textContent = 'Loading…';
      publicRows.innerHTML = '';
      try {
        const res = await fetch('/api/kiwisdr/public-directory');
        const body = await res.json();
        if (!res.ok) {
          publicStatus.textContent = body.error ?? 'Could not load the public receiver list.';
          return;
        }
        publicEntries = body.entries;
        renderPublicRows();
      } catch {
        publicStatus.textContent = 'Could not load the public receiver list.';
      }
    }

    document.getElementById('kiwi-public-browse-btn')!.addEventListener('click', () => {
      publicModalBackdrop.removeAttribute('hidden');
      loadPublicDirectory();
    });

    async function switchToPublicEntry(id: string, btn: HTMLButtonElement) {
      btn.disabled = true;
      btn.textContent = 'Connecting…';
      // "Listen" should actually start listening -- if audio isn't already
      // running, start it now, synchronously within this click handler (an
      // AudioContext can only be created/resumed off a real user gesture,
      // which a later `await`-ed fetch's continuation may no longer count
      // as). It'll connect to whatever receiver is currently active and
      // then follow the switch below automatically once that lands, same
      // as picking a different receiver while already listening already
      // does.
      if (!running) startAll();
      try {
        const res = await fetch('/api/kiwisdr/public/switch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          publicStatus.textContent = body.error ?? 'Could not switch receivers.';
          btn.disabled = false;
          btn.textContent = 'Listen';
          return;
        }
        closePublicModal();
        loadStatus();
      } catch {
        publicStatus.textContent = 'Could not switch receivers.';
        btn.disabled = false;
        btn.textContent = 'Listen';
      }
    }

    document.getElementById('kiwi-public-reset-btn')!.addEventListener('click', async () => {
      await fetch('/api/kiwisdr/public/reset', { method: 'POST' });
      loadStatus();
    });

    // Retuning always goes straight to the server, whether or not this
    // visitor has clicked Start -- this is one shared receiver, so a band
    // pick or step press here immediately moves what everyone currently
    // listening hears (see this page's lede). Starting only opens/closes
    // THIS visitor's own audio+waterfall connections; it doesn't gate
    // tuning.
    async function tune(freqMhz: number, mode: string) {
      tuneStatus.textContent = 'Tuning…';
      const res = await fetch('/api/kiwisdr/tune', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ freqKhz: freqMhz * 1000, mode }),
      });
      if (res.ok) {
        tuneStatus.textContent = '';
        loadStatus();
      } else {
        const body = await res.json().catch(() => ({}));
        tuneStatus.textContent = body.error ?? 'Tune failed.';
      }
    }

    // Picking a mode on its own (not paired with a Band/WWV/Shortwave pick)
    // previously just sat there until something else triggered a retune --
    // apply it immediately, at whatever frequency is currently showing.
    tuneMode.addEventListener('change', () => {
      tune(currentFreqMhz, tuneMode.value);
    });

    bandwidthSelect.addEventListener('change', async () => {
      const res = await fetch('/api/kiwisdr/bandwidth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bandwidth: bandwidthSelect.value }),
      });
      if (res.ok) loadStatus();
    });

    agcCheckbox.addEventListener('change', async () => {
      const res = await fetch('/api/kiwisdr/agc', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: agcCheckbox.checked }),
      });
      if (res.ok) loadStatus();
    });

    wfZoomSelect.addEventListener('change', async () => {
      const res = await fetch('/api/kiwisdr/zoom', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ zoom: Number(wfZoomSelect.value) }),
      });
      if (res.ok) loadStatus();
    });

    // Shared by the Ham Band / WWV / Shortwave dropdowns -- each is just a
    // different curated list feeding the same tune() call, reset back to
    // its placeholder after firing so re-picking the same entry twice in a
    // row still fires a change event.
    function wireQuickTuneSelect(select: HTMLSelectElement) {
      select.addEventListener('change', () => {
        const opt = select.selectedOptions[0];
        if (!opt?.dataset.freq) return;
        const freqMhz = Number(opt.dataset.freq);
        const mode = opt.dataset.mode!;
        currentFreqMhz = freqMhz;
        tuneMode.value = mode;
        tune(freqMhz, mode);
        select.value = '';
      });
    }
    wireQuickTuneSelect(bandSelect);
    wireQuickTuneSelect(timeSelect);
    wireQuickTuneSelect(swSelect);

    // The step buttons double as the slider's step-size picker -- whichever
    // one was clicked most recently (by magnitude, sign doesn't matter)
    // becomes what the slider below nudges by. Defaults to 10kHz.
    let activeStepKhz = 10;

    function updateSliderStepLabel() {
      const label = activeStepKhz >= 1000 ? `${activeStepKhz / 1000}MHz` : activeStepKhz >= 1 ? `${activeStepKhz}kHz` : `${Math.round(activeStepKhz * 1000)}Hz`;
      sliderStepLabel.textContent = `${label}/step`;
    }
    function highlightActiveStep() {
      document.querySelectorAll<HTMLButtonElement>('.kiwi-step').forEach((btn) => {
        btn.classList.toggle('active', Math.abs(Number(btn.dataset.stepKhz)) === activeStepKhz);
      });
    }
    highlightActiveStep();
    updateSliderStepLabel();

    // Step buttons only pick which step size the slider below uses -- they
    // don't retune anything themselves. Actual frequency movement happens
    // exclusively by dragging the slider.
    document.querySelectorAll<HTMLButtonElement>('.kiwi-step').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeStepKhz = Math.abs(Number(btn.dataset.stepKhz));
        highlightActiveStep();
        updateSliderStepLabel();
      });
    });

    // The slider is a relative jog, not an absolute frequency control: it
    // always sits at 0, and dragging it to N nudges (value * activeStepKhz)
    // away from wherever the receiver was tuned WHEN THE DRAG STARTED --
    // captured once into dragBaseKhz rather than read fresh on every
    // `input` event, so a concurrent retune by another visitor on this
    // shared receiver (see this page's lede) can't yank the base out from
    // under an in-progress drag. `input` fires continuously while dragging
    // (preview only, no network call); `change` fires once on release,
    // which is when this actually retunes and the slider snaps back to 0,
    // ready for the next nudge.
    let dragBaseKhz: number | null = null;

    freqSlider.addEventListener('input', () => {
      if (dragBaseKhz === null) dragBaseKhz = lastStatus?.freqKhz ?? 7255;
      const previewKhz = Math.max(0, dragBaseKhz + Number(freqSlider.value) * activeStepKhz);
      freqEl.textContent = (previewKhz / 1000).toFixed(4);
    });
    freqSlider.addEventListener('change', () => {
      const baseKhz = dragBaseKhz ?? lastStatus?.freqKhz ?? 7255;
      const nextKhz = Math.max(0, baseKhz + Number(freqSlider.value) * activeStepKhz);
      const mode = lastStatus?.mode ?? tuneMode.value;
      currentFreqMhz = nextKhz / 1000;
      tune(currentFreqMhz, mode);
      freqSlider.value = '0';
      dragBaseKhz = null;
    });

    // --- Waterfall -- scrolls a new row of colorized bins in at the top,
    // shifting everything else down by one pixel via a self-drawImage copy
    // (cheaper than redrawing the whole thing every frame). A handful of
    // palettes are offered via the Color picker -- Inferno (matplotlib's
    // perceptually-uniform black->purple->orange->pale-yellow scale, the
    // recognizable modern-scientific-viz look most current SDR software
    // like SDR++/GQRX defaults to or offers), Viridis (another
    // perceptually-uniform matplotlib scale, blue->green->yellow),
    // Classic SDR (the blue/green/yellow/red heat scale this waterfall
    // itself started with, closer to stock KiwiSDR/SDR#), Turbo (Google's
    // improved rainbow scale -- more contrast than the old "jet" colormap
    // some WebSDR frontends use), Green Phosphor (the black/green look of
    // classic CRT radar and oscilloscope displays), Ice (a cool blue/cyan
    // scale -- the one non-warm-toned, non-rainbow option), and a plain
    // Grayscale for a minimal look. Choice is a personal viewing
    // preference, not a site-wide setting -- saved per-browser. ---
    type ColormapKey = 'inferno' | 'viridis' | 'classic' | 'turbo' | 'phosphor' | 'ice' | 'grayscale';
    const COLORMAP_STOPS: Record<ColormapKey, [number, number, number, number][]> = {
      inferno: [
        [0, 0, 0, 4],
        [0.2, 40, 11, 84],
        [0.4, 101, 21, 110],
        [0.6, 159, 42, 99],
        [0.75, 212, 72, 66],
        [0.9, 245, 125, 21],
        [1, 252, 255, 164],
      ],
      viridis: [
        [0, 68, 1, 84],
        [0.25, 59, 82, 139],
        [0.5, 33, 145, 140],
        [0.75, 94, 201, 98],
        [1, 253, 231, 37],
      ],
      classic: [
        [0, 0, 0, 0],
        [0.15, 0, 0, 140],
        [0.35, 0, 120, 200],
        [0.55, 0, 200, 80],
        [0.75, 230, 220, 0],
        [1, 230, 20, 20],
      ],
      turbo: [
        [0, 48, 18, 59],
        [0.125, 63, 85, 191],
        [0.25, 39, 168, 224],
        [0.375, 62, 210, 154],
        [0.5, 158, 231, 63],
        [0.625, 245, 205, 47],
        [0.75, 244, 130, 37],
        [0.875, 204, 66, 33],
        [1, 122, 4, 3],
      ],
      phosphor: [
        [0, 0, 0, 0],
        [0.5, 0, 140, 40],
        [0.85, 60, 255, 90],
        [1, 220, 255, 220],
      ],
      ice: [
        [0, 0, 0, 8],
        [0.3, 8, 40, 90],
        [0.6, 20, 110, 190],
        [0.85, 110, 210, 240],
        [1, 220, 250, 255],
      ],
      grayscale: [
        [0, 0, 0, 0],
        [1, 255, 255, 255],
      ],
    };

    function colorFromStops(v: number, stops: [number, number, number, number][]): [number, number, number] {
      const t = v / 255;
      for (let i = 1; i < stops.length; i++) {
        const [t0, r0, g0, b0] = stops[i - 1];
        const [t1, r1, g1, b1] = stops[i];
        if (t <= t1) {
          const f = t1 === t0 ? 0 : (t - t0) / (t1 - t0);
          return [r0 + (r1 - r0) * f, g0 + (g1 - g0) * f, b0 + (b1 - b0) * f];
        }
      }
      const [, r, g, b] = stops[stops.length - 1];
      return [r, g, b];
    }

    const palette = new Uint8Array(256 * 3);
    function buildPalette(key: ColormapKey) {
      const stops = COLORMAP_STOPS[key];
      for (let i = 0; i < 256; i++) {
        const [r, g, b] = colorFromStops(i, stops);
        palette[i * 3] = r;
        palette[i * 3 + 1] = g;
        palette[i * 3 + 2] = b;
      }
    }

    const COLORMAP_STORAGE_KEY = 'kiwi_colormap';
    const colormapSelect = document.getElementById('kiwi-colormap') as HTMLSelectElement;
    const savedColormap = localStorage.getItem(COLORMAP_STORAGE_KEY);
    const initialColormap: ColormapKey = savedColormap && savedColormap in COLORMAP_STOPS ? (savedColormap as ColormapKey) : 'inferno';
    colormapSelect.value = initialColormap;
    buildPalette(initialColormap);
    colormapSelect.addEventListener('change', () => {
      const key = colormapSelect.value as ColormapKey;
      localStorage.setItem(COLORMAP_STORAGE_KEY, key);
      buildPalette(key);
    });

    // The waterfall/spectrum's zoom window is always centered exactly on
    // the tuned frequency (kiwiSdr.ts sends `cf=` as the current
    // frequency, same value updateFreqAxis's axisCenter already shows) --
    // so the tuned-frequency marker is always dead center, no per-frame
    // frequency-to-pixel math needed, just a redraw at the same x each
    // time. Drawn as an overlay on top rather than baked into the
    // waterfall's scrolling image, so it doesn't need touching the
    // row-shift logic above it.
    function drawCenterLine(context: CanvasRenderingContext2D, w: number, h: number) {
      context.save();
      context.strokeStyle = 'rgba(255, 255, 255, 0.55)';
      context.lineWidth = 1;
      context.beginPath();
      const x = Math.round(w / 2) + 0.5; // +0.5 keeps a 1px line crisp instead of antialiased across two pixels
      context.moveTo(x, 0);
      context.lineTo(x, h);
      context.stroke();
      context.restore();
    }

    function drawWaterfallRow(bins: Uint8Array) {
      const w = canvas.width;
      const h = canvas.height;
      ctx.drawImage(canvas, 0, 0, w, h - 1, 0, 1, w, h - 1);
      const row = ctx.createImageData(w, 1);
      const n = Math.min(w, bins.length);
      for (let x = 0; x < n; x++) {
        const v = bins[x];
        const i = x * 4;
        row.data[i] = palette[v * 3];
        row.data[i + 1] = palette[v * 3 + 1];
        row.data[i + 2] = palette[v * 3 + 2];
        row.data[i + 3] = 255;
      }
      ctx.putImageData(row, 0, 0);
      drawCenterLine(ctx, w, h);
    }

    // --- Live spectrum analyzer -- the classic line-graph-above-a-waterfall
    // layout every modern SDR app uses, redrawn from scratch each frame
    // (cheap: it's one 1024-point line, not a scrolling image). Glowing
    // accent-colored line + fading fill beneath it, matching the site's own
    // teal accent rather than an unrelated color. Style (Line/Bars/Peak
    // Hold) is a personal viewing preference like the waterfall colormap --
    // saved per-browser, not site-wide. ---
    const spectrumAccent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#5eead4';
    const peakAccent = getComputedStyle(document.documentElement).getPropertyValue('--accent-2').trim() || '#f5a962';

    type SpectrumStyle = 'line' | 'bars' | 'peak-hold' | 'filled' | 'gradient-bars';
    const SPECTRUM_STYLES: SpectrumStyle[] = ['line', 'bars', 'peak-hold', 'filled', 'gradient-bars'];
    const SPECTRUM_STYLE_STORAGE_KEY = 'kiwi_spectrum_style';
    const spectrumStyleSelect = document.getElementById('kiwi-spectrum-style') as HTMLSelectElement;
    const savedSpectrumStyle = localStorage.getItem(SPECTRUM_STYLE_STORAGE_KEY);
    let spectrumStyle: SpectrumStyle =
      savedSpectrumStyle && (SPECTRUM_STYLES as string[]).includes(savedSpectrumStyle) ? (savedSpectrumStyle as SpectrumStyle) : 'line';
    spectrumStyleSelect.value = spectrumStyle;
    // Slowly-decaying per-bin peak track, only used in 'peak-hold' -- reset
    // whenever the style changes so an old session's peaks don't linger.
    let peakLevels: Float32Array | null = null;
    spectrumStyleSelect.addEventListener('change', () => {
      spectrumStyle = spectrumStyleSelect.value as SpectrumStyle;
      localStorage.setItem(SPECTRUM_STYLE_STORAGE_KEY, spectrumStyle);
      peakLevels = null;
    });

    // The server already contrast-stretches each waterfall row to its own
    // observed 2nd/98th-percentile range (see kiwiSdr.ts) so the waterfall
    // itself isn't a flat, low-contrast smear -- but that means these same
    // bin values are already close to using the full 0-255 range on nearly
    // every frame, ordinary noise floor included. A plain linear v/255
    // mapping to height made routine noise look almost as tall as a real
    // peak, and a bigger headroom margin (tried 0.6, then 0.85) only ever
    // trades "too much empty space above the trace" against "the trace
    // fills too much of it" -- it can't fix peaks-vs-noise separation on
    // its own, since scaling everything by the same constant preserves
    // their relative heights exactly.
    //
    // SPECTRUM_GAMMA > 1 compresses low/mid values toward the bottom
    // disproportionately more than high ones (v/255 raised to a power <1
    // stays close to 1), so ordinary noise sits low and only genuinely
    // strong bins rise up sharply -- the same reason real spectrum
    // analyzers use a non-linear (usually dB/log) response instead of raw
    // linear amplitude.
    const SPECTRUM_HEADROOM = 0.85;
    const SPECTRUM_GAMMA = 1.8;
    function binHeight(v: number, h: number): number {
      return (v / 255) ** SPECTRUM_GAMMA * h * SPECTRUM_HEADROOM;
    }

    function drawSpectrumLine(bins: Uint8Array, n: number, w: number, h: number) {
      spectrumCtx.beginPath();
      spectrumCtx.moveTo(0, h);
      for (let x = 0; x < n; x++) spectrumCtx.lineTo(x, h - binHeight(bins[x], h));
      spectrumCtx.lineTo(n, h);
      spectrumCtx.closePath();
      const gradient = spectrumCtx.createLinearGradient(0, 0, 0, h);
      gradient.addColorStop(0, spectrumAccent);
      gradient.addColorStop(1, 'transparent');
      spectrumCtx.globalAlpha = 0.3;
      spectrumCtx.fillStyle = gradient;
      spectrumCtx.fill();
      spectrumCtx.globalAlpha = 1;

      spectrumCtx.beginPath();
      for (let x = 0; x < n; x++) {
        const y = h - binHeight(bins[x], h);
        if (x === 0) spectrumCtx.moveTo(x, y);
        else spectrumCtx.lineTo(x, y);
      }
      spectrumCtx.strokeStyle = spectrumAccent;
      spectrumCtx.lineWidth = 1.5;
      spectrumCtx.shadowColor = spectrumAccent;
      spectrumCtx.shadowBlur = 6;
      spectrumCtx.stroke();
      spectrumCtx.shadowBlur = 0;
    }

    // Coarser grouped bars (an equalizer look) rather than one bar per
    // pixel-wide bin -- one bar per bin would just look like a spikier line.
    const SPECTRUM_BAR_COUNT = 96;
    function drawSpectrumBars(bins: Uint8Array, n: number, w: number, h: number) {
      const binsPerBar = Math.max(1, Math.floor(n / SPECTRUM_BAR_COUNT));
      const barWidth = w / SPECTRUM_BAR_COUNT;
      const gap = barWidth * 0.15;
      spectrumCtx.fillStyle = spectrumAccent;
      spectrumCtx.shadowColor = spectrumAccent;
      spectrumCtx.shadowBlur = 4;
      for (let i = 0; i < SPECTRUM_BAR_COUNT; i++) {
        const start = i * binsPerBar;
        const end = Math.min(n, start + binsPerBar);
        let peak = 0;
        for (let x = start; x < end; x++) peak = Math.max(peak, bins[x]);
        const barH = binHeight(peak, h);
        spectrumCtx.fillRect(i * barWidth + gap / 2, h - barH, barWidth - gap, barH);
      }
      spectrumCtx.shadowBlur = 0;
    }

    // Decays a couple of points per frame -- slow enough that a weak signal
    // flickering in and out still leaves a visible mark for a few seconds,
    // fast enough that the display doesn't just fill up solid.
    const PEAK_DECAY_PER_FRAME = 1.5;
    function drawSpectrumPeaks(bins: Uint8Array, n: number, h: number) {
      if (!peakLevels || peakLevels.length !== n) peakLevels = new Float32Array(n);
      spectrumCtx.beginPath();
      for (let x = 0; x < n; x++) {
        peakLevels[x] = Math.max(bins[x], peakLevels[x] - PEAK_DECAY_PER_FRAME);
        const y = h - binHeight(peakLevels[x], h);
        if (x === 0) spectrumCtx.moveTo(x, y);
        else spectrumCtx.lineTo(x, y);
      }
      spectrumCtx.strokeStyle = peakAccent;
      spectrumCtx.lineWidth = 1;
      spectrumCtx.stroke();
    }

    // A solid wash with no stroke line on top -- the calmer, more minimal
    // counterpart to 'line', which draws the same fill plus a glowing edge.
    function drawSpectrumFilled(bins: Uint8Array, n: number, w: number, h: number) {
      spectrumCtx.beginPath();
      spectrumCtx.moveTo(0, h);
      for (let x = 0; x < n; x++) spectrumCtx.lineTo(x, h - binHeight(bins[x], h));
      spectrumCtx.lineTo(n, h);
      spectrumCtx.closePath();
      // Anchored to the tallest point a bin can actually reach (h * (1 -
      // SPECTRUM_HEADROOM)), not the canvas top -- a gradient spanning the
      // full 0-h range wastes its most opaque stops on the headroom margin
      // no bin ever draws into, leaving the visible fill sampling only the
      // already-fading tail of the gradient and looking washed out.
      const gradient = spectrumCtx.createLinearGradient(0, h * (1 - SPECTRUM_HEADROOM), 0, h);
      gradient.addColorStop(0, spectrumAccent);
      gradient.addColorStop(1, 'transparent');
      spectrumCtx.globalAlpha = 0.95;
      spectrumCtx.fillStyle = gradient;
      spectrumCtx.fill();
      spectrumCtx.globalAlpha = 1;
    }

    // Same grouped bars as 'bars', but each bar is colored by its own
    // amplitude using the active waterfall palette -- a VU-meter look where
    // switching the Color picker also restyles the spectrum.
    function drawSpectrumGradientBars(bins: Uint8Array, n: number, w: number, h: number) {
      const binsPerBar = Math.max(1, Math.floor(n / SPECTRUM_BAR_COUNT));
      const barWidth = w / SPECTRUM_BAR_COUNT;
      const gap = barWidth * 0.15;
      for (let i = 0; i < SPECTRUM_BAR_COUNT; i++) {
        const start = i * binsPerBar;
        const end = Math.min(n, start + binsPerBar);
        let peak = 0;
        for (let x = start; x < end; x++) peak = Math.max(peak, bins[x]);
        const barH = binHeight(peak, h);
        spectrumCtx.fillStyle = `rgb(${palette[peak * 3]}, ${palette[peak * 3 + 1]}, ${palette[peak * 3 + 2]})`;
        spectrumCtx.fillRect(i * barWidth + gap / 2, h - barH, barWidth - gap, barH);
      }
    }

    function drawSpectrum(bins: Uint8Array) {
      const w = spectrumCanvas.width;
      const h = spectrumCanvas.height;
      spectrumCtx.clearRect(0, 0, w, h);
      const n = Math.min(w, bins.length);

      if (spectrumStyle === 'bars') {
        drawSpectrumBars(bins, n, w, h);
      } else if (spectrumStyle === 'gradient-bars') {
        drawSpectrumGradientBars(bins, n, w, h);
      } else if (spectrumStyle === 'filled') {
        drawSpectrumFilled(bins, n, w, h);
      } else {
        drawSpectrumLine(bins, n, w, h);
        if (spectrumStyle === 'peak-hold') drawSpectrumPeaks(bins, n, h);
      }
      drawCenterLine(spectrumCtx, w, h);
    }
    function clearSpectrum() {
      spectrumCtx.clearRect(0, 0, spectrumCanvas.width, spectrumCanvas.height);
      peakLevels = null;
    }

    // Recomputed in loadStatus() from the server's current wfZoom (see the
    // Zoom picker) -- 30000kHz / 2^zoom, same formula kiwiSdr.ts uses
    // server-side. Starts at the default zoom's span; the first loadStatus()
    // response settles it to whatever the server actually reports.
    let WF_SPAN_KHZ = 30000 / 2 ** 10;
    function updateFreqAxis(freqKhz: number) {
      const halfSpan = WF_SPAN_KHZ / 2;
      axisLow.textContent = ((freqKhz - halfSpan) / 1000).toFixed(3);
      axisCenter.textContent = (freqKhz / 1000).toFixed(3);
      axisHigh.textContent = ((freqKhz + halfSpan) / 1000).toFixed(3);
    }

    // Click anywhere on the waterfall or spectrum to jump straight to that
    // frequency -- both canvases share the same x-axis (the current
    // WF_SPAN_KHZ window centered on the tuned frequency), so one handler
    // covers both. Uses getBoundingClientRect() rather than the click
    // event's offsetX/offsetY, since the canvas's internal resolution
    // (1024px) and its CSS-scaled display width aren't the same thing.
    function tuneFromCanvasClick(e: MouseEvent, canvasEl: HTMLCanvasElement) {
      const centerKhz = lastStatus?.freqKhz ?? 7255;
      const mode = lastStatus?.mode ?? tuneMode.value;
      const rect = canvasEl.getBoundingClientRect();
      const xFraction = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const targetKhz = centerKhz - WF_SPAN_KHZ / 2 + xFraction * WF_SPAN_KHZ;
      currentFreqMhz = targetKhz / 1000;
      tune(currentFreqMhz, mode);
    }
    canvas.addEventListener('click', (e) => tuneFromCanvasClick(e, canvas));
    spectrumCanvas.addEventListener('click', (e) => tuneFromCanvasClick(e, spectrumCanvas));

    function clearWaterfall() {
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      clearSpectrum();
    }
    clearWaterfall();

    // --- Audio + waterfall connections. Start opens audio always, and the
    // waterfall too if its checkbox is checked; Stop tears both all the way
    // down -- closing the WebSocket to this API, which in turn closes this
    // server's upstream connection to the Kiwi once no listener is left
    // (see kiwiSdr.ts's registerAudioListener/registerWaterfallListener),
    // actually freeing the channel rather than just muting playback.
    //
    // The waterfall's own on/off checkbox is independent of Start/Stop --
    // it can be flipped off mid-session to free that one channel (and skip
    // the render cost) while audio keeps playing, or back on without
    // restarting audio. The waterfall and spectrum are two independently
    // toggleable *displays* of that single channel -- either, both, or
    // neither can be showing; the underlying WebSocket stays open as long
    // as at least one of them wants data, and only actually closes once
    // both are off. syncWaterfallConnection() is the single place that
    // reconciles "should the channel be connected right now" against
    // `running` and both checkboxes, called after any of them changes. ---
    let running = false;
    let wfEnabled = wfEnabledCheckbox.checked;
    let spectrumEnabled = spectrumEnabledCheckbox.checked;
    let audioSocket: WebSocket | null = null;
    let wfSocket: WebSocket | null = null;
    let audioCtx: AudioContext | null = null;
    let gainNode: GainNode | null = null;
    let nextPlayTime = 0;

    function startWaterfall() {
      wfStatus.textContent = 'Connecting…';
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wws = new WebSocket(`${proto}//${location.host}/ws/kiwisdr-waterfall`);
      wws.binaryType = 'arraybuffer';
      wfSocket = wws;
      wws.addEventListener('open', () => {
        wfStatus.textContent = '';
      });
      wws.addEventListener('message', (ev) => {
        if (typeof ev.data === 'string') {
          const parsed = JSON.parse(ev.data);
          wfStatus.textContent = parsed.error ?? 'Waterfall stream stopped.';
          wfSocket = null;
          return;
        }
        const bins = new Uint8Array(ev.data as ArrayBuffer);
        if (wfEnabled) drawWaterfallRow(bins);
        if (spectrumEnabled) drawSpectrum(bins);
      });
      wws.addEventListener('close', () => {
        if (wfSocket !== wws) return;
        wfSocket = null;
        // A drop here doesn't take audio down with it -- the waterfall is
        // independently toggleable now, so treat this the same as the user
        // having flipped both checkboxes off, not a fatal error for the
        // whole session.
        if (running && (wfEnabled || spectrumEnabled)) wfStatus.textContent = 'Waterfall disconnected.';
      });
      wws.addEventListener('error', () => wws.close());
    }

    function stopWaterfall() {
      wfSocket?.close();
      wfSocket = null;
      wfStatus.textContent = '';
      clearWaterfall();
    }

    function syncWaterfallConnection() {
      canvas.classList.toggle('kiwi-canvas-hidden', !wfEnabled);
      spectrumCanvas.classList.toggle('kiwi-canvas-hidden', !spectrumEnabled);
      wfWrap.hidden = !wfEnabled && !spectrumEnabled;
      const shouldBeConnected = running && (wfEnabled || spectrumEnabled);
      if (shouldBeConnected && !wfSocket) startWaterfall();
      else if (!shouldBeConnected && wfSocket) stopWaterfall();
      else if (!shouldBeConnected) wfStatus.textContent = '';
    }

    wfEnabledCheckbox.addEventListener('change', () => {
      wfEnabled = wfEnabledCheckbox.checked;
      syncWaterfallConnection();
    });
    spectrumEnabledCheckbox.addEventListener('change', () => {
      spectrumEnabled = spectrumEnabledCheckbox.checked;
      syncWaterfallConnection();
    });
    syncWaterfallConnection();

    function stopAll(message: string) {
      running = false;
      audioSocket?.close();
      audioSocket = null;
      audioCtx?.close();
      audioCtx = null;
      gainNode = null;
      startStopBtn.textContent = 'Start';
      startStopBtn.classList.remove('listening');
      audioStatus.textContent = message;
      syncWaterfallConnection();
    }

    function startAll() {
      running = true;
      startStopBtn.textContent = 'Stop';
      startStopBtn.classList.add('listening');
      audioStatus.textContent = 'Connecting…';
      syncWaterfallConnection();

      audioCtx = new AudioContext();
      // A fresh AudioContext can start life 'suspended' rather than
      // 'running' even from a real click, depending on the browser's own
      // autoplay-policy heuristics -- nothing here throws when that
      // happens, scheduled playback just silently never produces sound
      // while everything else (waterfall included, a separate Canvas/
      // WebSocket path with no AudioContext involved) keeps working fine.
      // resume() is a harmless no-op if it's already running.
      audioCtx.resume().catch(() => {});
      gainNode = audioCtx.createGain();
      gainNode.gain.value = Number(volumeSlider.value);
      gainNode.connect(audioCtx.destination);
      nextPlayTime = 0;

      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const aws = new WebSocket(`${proto}//${location.host}/ws/kiwisdr-audio`);
      aws.binaryType = 'arraybuffer';
      audioSocket = aws;
      aws.addEventListener('open', () => {
        audioStatus.textContent = '';
      });
      aws.addEventListener('message', (ev) => {
        if (typeof ev.data === 'string') {
          const parsed = JSON.parse(ev.data);
          stopAll(parsed.error ?? 'Audio stream stopped.');
          return;
        }
        if (!audioCtx || !gainNode) return;
        if (audioCtx.state === 'suspended') audioCtx.resume().catch(() => {});
        // Read the sample rate fresh per frame rather than capturing it
        // once at Start time -- switching to a different public receiver
        // mid-session (which the picker's "Listen" button now does without
        // requiring a separate Start click) can mean a different sample
        // rate takes over the same still-open audio socket, and playing
        // its frames back at the OLD rate would just come out pitch-
        // shifted/sped up rather than erroring. loadStatus()'s poll keeps
        // lastStatus.sampleRate caught up to whatever's actually connected.
        const sampleRate = Math.round(lastStatus?.sampleRate ?? 12000);
        const pcm = new Int16Array(ev.data as ArrayBuffer);
        if (cwEnabledCheckbox.checked && lastStatus?.mode === 'cw') cwProcessFrame(pcm, sampleRate);
        const buffer = audioCtx.createBuffer(1, pcm.length, sampleRate);
        const channel = buffer.getChannelData(0);
        for (let i = 0; i < pcm.length; i++) channel[i] = pcm[i] / 0x8000;
        const source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.connect(gainNode);
        const startAt = Math.max(nextPlayTime, audioCtx.currentTime + 0.05);
        source.start(startAt);
        nextPlayTime = startAt + buffer.duration;
      });
      aws.addEventListener('close', () => {
        if (audioSocket === aws && running) stopAll('');
      });
      aws.addEventListener('error', () => {
        if (audioSocket === aws) stopAll('Audio connection error.');
      });
    }

    // --- Live CW (Morse) decoder -- runs entirely client-side against the
    // same demodulated PCM already flowing to the speaker, no server
    // changes needed. A Goertzel filter tracks the tone's power at the
    // CW passband's center frequency (narrower than a full FFT, and all
    // that's needed for a single known tone); an adaptive on/off
    // threshold and a self-adjusting dit-length estimate mean it doesn't
    // need a WPM setting -- same "read the actual signal instead of
    // trusting a fixed assumption" spirit as the waterfall's own
    // per-receiver contrast stretch. ---
    const cwEnabledCheckbox = document.getElementById('kiwi-cw-enabled') as HTMLInputElement;
    const cwStatus = document.getElementById('kiwi-cw-status')!;
    const cwOutput = document.getElementById('kiwi-cw-output')!;
    const cwClearBtn = document.getElementById('kiwi-cw-clear') as HTMLButtonElement;

    function goertzelMagnitude(samples: Int16Array, sampleRate: number, targetFreqHz: number): number {
      const n = samples.length;
      const k = Math.round((n * targetFreqHz) / sampleRate);
      const omega = (2 * Math.PI * k) / n;
      const coeff = 2 * Math.cos(omega);
      let s1 = 0;
      let s2 = 0;
      for (let i = 0; i < n; i++) {
        const s0 = samples[i] / 32768 + coeff * s1 - s2;
        s2 = s1;
        s1 = s0;
      }
      const real = s1 - s2 * Math.cos(omega);
      const imag = s2 * Math.sin(omega);
      return Math.sqrt(real * real + imag * imag);
    }

    let cwIsOn = false;
    let cwStateElapsedMs = 0;
    let cwDitLenMs = 60; // ~20 WPM starting guess, adapts from real dit durations as they're observed
    let cwNoiseLevel = 0;
    let cwSignalLevel = 1;
    let cwPattern = '';
    let cwCharGapFlushed = false;
    let cwWordGapFlushed = false;
    const CW_MAX_LINE_CHARS = 400; // scrolling transcript, not an unbounded log
    // Roughly 4-60 WPM -- covers real hand-sent through very fast machine-
    // sent CW with margin either side. Without this floor, band noise (no
    // clean tone at all, confirmed live tuning to an NCDXF beacon
    // frequency with no beacon in its active slot at that moment) can
    // trigger rapid spurious on/off transitions that shrink the estimate
    // every time, in an unbounded feedback loop -- each shrink makes the
    // classification threshold shorter, which makes the NEXT noise blip
    // more likely to also read as a "dit", confirmed live to run away
    // toward a WPM reading in the sextillions within seconds.
    const CW_MIN_DIT_MS = 20;
    const CW_MAX_DIT_MS = 300;

    function cwResetDecoder() {
      cwIsOn = false;
      cwStateElapsedMs = 0;
      cwDitLenMs = 60;
      cwNoiseLevel = 0;
      cwSignalLevel = 1;
      cwPattern = '';
      cwCharGapFlushed = false;
      cwWordGapFlushed = false;
    }

    function cwAppend(text: string) {
      cwOutput.textContent = (cwOutput.textContent + text).slice(-CW_MAX_LINE_CHARS);
      cwOutput.scrollTop = cwOutput.scrollHeight;
    }

    function cwFlushCharacter() {
      if (!cwPattern) return;
      cwAppend(MORSE_DECODE[cwPattern] ?? '·');
      cwPattern = '';
    }

// A real Kiwi audio frame arrives roughly every ~45ms (confirmed live:
    // 87 frames over 4s against this station's own receiver) -- fine for
    // playback, but coarse next to a dit length (66ms at 18 WPM, down to
    // ~34ms at 35 WPM): timing a whole incoming frame as one on/off
    // sample rounds every element's duration to the nearest frame
    // boundary, which is a large relative error on short elements.
    // Subdividing each frame into smaller windows for the Goertzel/timing
    // analysis costs nothing extra over the network (still one frame per
    // ~45ms) since the full-resolution samples are already in hand --
    // just more (cheap) analysis passes over data already received.
    const CW_WINDOW_SAMPLES = 128; // ~10.7ms at 12kHz, ~4x finer than one frame

    /** One on/off timing sample -- called once per CW_WINDOW_SAMPLES-sized
     * slice with that slice's own duration (derived from its real sample
     * count/rate, not wall-clock arrival time, which would be thrown off
     * by network jitter) -- same "trust the audio's own clock" approach
     * nextPlayTime already uses for gapless playback scheduling. */
    function cwProcessWindow(magnitude: number, windowMs: number) {
      // Hysteresis around the midpoint between the tracked noise and
      // signal levels -- using the SAME threshold both directions would
      // let magnitude readings right at that line chatter rapidly.
      const onThreshold = cwNoiseLevel + (cwSignalLevel - cwNoiseLevel) * 0.55;
      const offThreshold = cwNoiseLevel + (cwSignalLevel - cwNoiseLevel) * 0.35;
      const nowOn = cwIsOn ? magnitude > offThreshold : magnitude > onThreshold;

      // Each reading nudges whichever level it's currently classified
      // under -- lets both track a moving target (band noise changing,
      // AGC adjusting, a different receiver entirely after a switch)
      // rather than freezing at whatever they started at.
      if (nowOn) cwSignalLevel = cwSignalLevel * 0.95 + magnitude * 0.05;
      else cwNoiseLevel = cwNoiseLevel * 0.95 + magnitude * 0.05;

      if (nowOn !== cwIsOn) {
        const finishedMs = cwStateElapsedMs;
        if (cwIsOn) {
          // A tone just ended -- classify it as a dit or dah by comparing
          // against the current estimate, then let genuine dits (not
          // dahs, which would drag the estimate long) adjust that
          // estimate for next time.
          if (finishedMs < cwDitLenMs * 1.7) {
            cwPattern += '.';
            cwDitLenMs = Math.min(CW_MAX_DIT_MS, Math.max(CW_MIN_DIT_MS, cwDitLenMs * 0.8 + finishedMs * 0.2));
          } else {
            cwPattern += '-';
          }
        }
        // A gap just ended (tone starting again) -- nothing to do beyond
        // resetting the per-gap flush flags; cwFlushCharacter() already
        // ran proactively below while the gap was still ongoing, if it
        // was long enough to warrant it.
        cwIsOn = nowOn;
        cwStateElapsedMs = 0;
        cwCharGapFlushed = false;
        cwWordGapFlushed = false;
      } else {
        cwStateElapsedMs += windowMs;
      }

      // Flush proactively on a long-enough gap rather than waiting for
      // the NEXT tone to start -- otherwise the last character/word of a
      // transmission would sit buffered and invisible until someone
      // keyed again.
      if (!cwIsOn) {
        if (!cwCharGapFlushed && cwStateElapsedMs > cwDitLenMs * 2.5) {
          cwFlushCharacter();
          cwCharGapFlushed = true;
        }
        if (!cwWordGapFlushed && cwStateElapsedMs > cwDitLenMs * 6) {
          cwAppend(' ');
          cwWordGapFlushed = true;
        }
      }
    }

    function cwProcessFrame(pcm: Int16Array, sampleRate: number) {
      const targetFreq = lastStatus ? (lastStatus.lowCutHz + lastStatus.highCutHz) / 2 || 500 : 500;
      const windowMs = (CW_WINDOW_SAMPLES / sampleRate) * 1000;
      for (let i = 0; i < pcm.length; i += CW_WINDOW_SAMPLES) {
        const window = pcm.subarray(i, Math.min(i + CW_WINDOW_SAMPLES, pcm.length));
        if (window.length === 0) continue;
        const magnitude = goertzelMagnitude(window, sampleRate, Math.abs(targetFreq));
        // The last window in a frame is often shorter than the others
        // (pcm.length isn't guaranteed to divide evenly) -- time it by
        // its own actual sample count rather than the full window
        // duration, or the running elapsed-time clock would drift ahead.
        cwProcessWindow(magnitude, (window.length / sampleRate) * 1000 || windowMs);
      }
    }

    function cwSyncStatus() {
      if (!cwEnabledCheckbox.checked) {
        cwStatus.textContent = '';
        cwOutput.hidden = true;
        cwClearBtn.hidden = true;
        return;
      }
      cwOutput.hidden = false;
      cwClearBtn.hidden = false;
      cwStatus.textContent = lastStatus?.mode === 'cw' ? `~${Math.round(1200 / cwDitLenMs)} WPM` : 'Switch to CW mode to decode';
    }
    cwEnabledCheckbox.addEventListener('change', () => {
      cwResetDecoder();
      cwSyncStatus();
    });
    cwClearBtn.addEventListener('click', () => {
      cwOutput.textContent = '';
    });

    startStopBtn.addEventListener('click', () => {
      if (running) stopAll('');
      else startAll();
    });
    volumeSlider.addEventListener('input', () => {
      if (gainNode) gainNode.gain.value = Number(volumeSlider.value);
    });
  </script>
</Base>
