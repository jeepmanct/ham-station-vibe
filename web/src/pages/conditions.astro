---
import Base from '../layouts/Base.astro';
import '../styles/conditions.css';
import '../styles/lastHeardTable.css';
---
<Base title="Conditions" active="conditions">
  <h1>Conditions</h1>
  <p class="lede">Right-now propagation numbers, live DX spots, upcoming DXpeditions, and contests.</p>

  <div class="stat-grid">
    <div class="stat-tile">
      <div class="label">Solar Flux</div>
      <div class="value" id="cond-sfi">&mdash;</div>
    </div>
    <div class="stat-tile">
      <div class="label">A-Index</div>
      <div class="value" id="cond-a">&mdash;</div>
    </div>
    <div class="stat-tile">
      <div class="label">K-Index</div>
      <div class="value" id="cond-k">&mdash;</div>
    </div>
    <div class="stat-tile">
      <div class="label">Sunspot No.</div>
      <div class="value" id="cond-sn">&mdash;</div>
    </div>
    <div class="stat-tile">
      <div class="label">HF Grade</div>
      <div class="value" id="cond-grade">&mdash;</div>
      <div class="sub" id="cond-grade-sub"></div>
    </div>
  </div>
  <p class="status-line" id="cond-date"></p>
  <p class="status-line" id="cond-year-ago"></p>
  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;margin:0.5rem 0;">
    <button type="button" class="btn secondary" id="cond-solar-sync">Sync solar data now</button>
    <button type="button" class="btn secondary" id="cond-solar-full-sync">Full Resync</button>
    <span id="cond-solar-last-synced" class="status-line" style="margin:0;font-size:0.8rem;"></span>
  </div>
  <p id="cond-solar-sync-status" class="status-line"></p>

  <h2 class="page-group-heading">Propagation &amp; Solar</h2>
  <div id="conditions-tiles-propagation">
  <div class="card" style="margin-top:1.5rem;" data-tile-id="propagation-trend">
    <h2>Propagation Trend</h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">Last 90 days, from the same daily solar data behind the numbers above.</p>
    <select id="trend-metric" style="margin-bottom:0.75rem;">
      <option value="sfi">Solar Flux Index</option>
      <option value="kIndex">K-Index</option>
      <option value="aIndex">A-Index</option>
      <option value="sunspotNumber">Sunspot Number</option>
    </select>
    <div class="chart-svg-wrap" id="trend-chart"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="forecast-27day">
    <h2>27-Day Forecast</h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">NOAA's predicted SFI/A/Kp for the next 27 days &mdash; what's coming, not what's happened.</p>
    <select id="forecast-metric" style="margin-bottom:0.75rem;">
      <option value="sfi">Solar Flux Index</option>
      <option value="kIndex">K-Index</option>
      <option value="aIndex">A-Index</option>
    </select>
    <div class="chart-svg-wrap" id="forecast-chart"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="muf-map">
    <h2>Real-Time MUF Map</h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">Maximum Usable Frequency for a 3000km hop, via <a href="https://prop.kc2g.com" target="_blank" rel="noopener">prop.kc2g.com</a>. A "16" contour means a long-hop 20m path may be open there; higher numbers mean higher bands are open.</p>
    <img id="muf-map" alt="Live worldwide MUF map" style="width:100%;border-radius:var(--radius);border:1px solid var(--border);display:block;" />
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="ncdxf-beacons">
    <h2>NCDXF/IARU Beacons</h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">Which of the 18 <a href="https://www.ncdxf.org/beacon/" target="_blank" rel="noopener">NCDXF/IARU beacons</a> is on each band right now &mdash; computed client-side from the fixed schedule, no live data pulled.</p>
    <div class="beacon-table" id="beacon-table"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="band-noise-floor">
    <h2>Band Noise Floor <span style="color:var(--muted);font-weight:400;font-size:0.85rem;">(KiwiSDR)</span></h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
      A one-shot spot-check on whatever the <a href="/kiwisdr">KiwiSDR</a> is tuned to &mdash; that one frequency, not the whole band. Doesn't poll continuously, so it won't hold the receiver open.
    </p>
    <div id="noise-floor-content">
      <p class="status-line" id="noise-floor-status">Checking…</p>
      <p style="margin:0.15rem 0 0;color:var(--muted);font-size:0.78rem;" id="noise-floor-checked-at"></p>
    </div>
    <button type="button" class="btn secondary" id="noise-floor-refresh" style="margin-top:0.5rem;">Check again</button>
  </div>
  </div>

  <h2 class="page-group-heading">Sky &amp; Weather</h2>
  <div id="conditions-tiles-sky">
  <div class="card" style="margin-top:1.5rem;" data-tile-id="lightning">
    <h2>Lightning</h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
      Strikes within <span id="lightning-display-radius">100km</span> of the QTH, last 2 hours, via <a href="https://www.blitzortung.org/" target="_blank" rel="noopener">Blitzortung.org</a>. Solid circle is the <span id="lightning-alert-radius">20km</span> "consider disconnecting antennas" radius.
    </p>
    <div id="lightning-unavailable" class="status-line" hidden></div>
    <div id="lightning-content" hidden>
      <p class="status-line" id="lightning-status"></p>
      <div id="lightning-map" style="height:320px;border-radius:var(--radius);"></div>
    </div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="sun-grayline">
    <h2>Sun &amp; Grayline</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">For the station QTH<span id="sun-grid"></span>, computed client-side when the page loads &mdash; reload for a new day's times.</p>
    <div class="stat-grid" style="margin-top:1rem;">
      <div class="stat-tile">
        <div class="label">Sunrise</div>
        <div class="value" id="sun-sunrise">&mdash;</div>
      </div>
      <div class="stat-tile">
        <div class="label">Sunset</div>
        <div class="value" id="sun-sunset">&mdash;</div>
      </div>
      <div class="stat-tile">
        <div class="label">Solar Noon</div>
        <div class="value" id="sun-noon">&mdash;</div>
      </div>
      <div class="stat-tile">
        <div class="label">Day Length</div>
        <div class="value" id="sun-daylength">&mdash;</div>
      </div>
    </div>
    <p class="status-line" id="sun-status"></p>
  </div>
  </div>

  <h2 class="page-group-heading">Live Activity</h2>
  <div id="conditions-tiles-activity">
  <div class="card" style="margin-top:1.5rem;" data-tile-id="live-dx-spots">
    <h2>Live DX Spots</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">Via <a href="https://dxheat.com" target="_blank" rel="noopener">dxheat.com</a>. <strong style="color:var(--status-warning);">Needed</strong> flags a DXCC entity not yet worked &mdash; a convenience list, not a certified award tracker.</p>
    <p style="margin:0.15rem 0 0;color:var(--muted);font-size:0.78rem;" id="spot-updated-at"></p>
    <div class="spot-table" id="spot-table"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="band-activity">
    <h2>Band Activity</h2>
    <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">How much of the live spot feed above is on each band right now &mdash; a rough proxy for which bands are actually open, not a real propagation prediction.</p>
    <div id="band-activity-bars"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="dx-operations">
    <h2>Announced DX Operations</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">Via <a href="https://www.ng3k.com/Misc/adxo.html" target="_blank" rel="noopener">NG3K's ADXO list</a>. <strong style="color:var(--status-warning);">Needed</strong> flags an entity not yet worked.</p>
    <div class="dxpedition-list" id="dxpedition-list"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="upcoming-contests">
    <h2>Upcoming Contests</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">Via the <a href="https://www.contestcalendar.com" target="_blank" rel="noopener">WA7BNM Contest Calendar</a>.</p>
    <div class="contest-list" id="contest-list"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="psk-reporter">
    <h2>Recently Heard (PSK Reporter)</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">Who's decoding this station's signal, via <a href="https://pskreporter.info" target="_blank" rel="noopener">PSK Reporter</a> &mdash; FT8/FT4/digital, last hour.</p>
    <p style="margin:0.15rem 0 0;color:var(--muted);font-size:0.78rem;" id="psk-updated-at"></p>
    <div id="psk-map"></div>
    <div class="psk-table" id="psk-table"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="wspr-reports">
    <h2>WSPR Reception Reports</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">Who's decoding this station's WSPR beacon, via <a href="https://wspr.live" target="_blank" rel="noopener">wspr.live</a>. Empty unless actively beaconing WSPR.</p>
    <p style="margin:0.15rem 0 0;color:var(--muted);font-size:0.78rem;" id="wspr-updated-at"></p>
    <div id="wspr-map"></div>
    <div class="psk-table" id="wspr-table"></div>
  </div>

  <div class="card" style="margin-top:1.5rem;" data-tile-id="rbn-reports">
    <h2>CW/RTTY Skimmer Reports (Reverse Beacon Network)</h2>
    <p style="margin:0;color:var(--muted);font-size:0.85rem;">Who's decoding this station's CW/RTTY signal, via the <a href="https://www.reversebeacon.net" target="_blank" rel="noopener">Reverse Beacon Network</a>. Empty unless currently on CW or RTTY.</p>
    <p style="margin:0.15rem 0 0;color:var(--muted);font-size:0.78rem;" id="rbn-updated-at"></p>
    <div id="rbn-map"></div>
    <div class="psk-table" id="rbn-table"></div>
  </div>
  </div>

  <script>
    import { sunriseSunset } from '../lib/grayline';
    import { renderLineChart } from '../lib/charts';
    import { escapeHtml } from '../lib/escapeHtml';
    import 'leaflet/dist/leaflet.css';
    import L from 'leaflet';
    import { fetchDistanceUnit, formatDistance, type DistanceUnit } from '../lib/units';
    import { greatCircleArc } from '../lib/geo';
    import { gridToLatLon } from '../lib/maidenhead';
    import { applyTileLayout } from '../lib/tileLayout';

    for (const id of ['conditions-tiles-propagation', 'conditions-tiles-sky', 'conditions-tiles-activity']) {
      applyTileLayout('conditions', document.getElementById(id)!);
    }

    const TOKEN_KEY = 'hamstation_admin_token';

    // --- Propagation trend (last 90 days) — distinct from /stats' yearly
    // solar-cycle-context chart; this answers "how has it been lately,"
    // using the same daily solar_data rows already synced for the numbers
    // above, no new data collection needed. ---
    type RecentSolar = { date: string; sfi: number | null; aIndex: number | null; kIndex: number | null; sunspotNumber: number | null };
    let recentSolar: RecentSolar[] = [];

    function daysSinceEpoch(yyyymmdd: string): number {
      const d = Date.UTC(Number(yyyymmdd.slice(0, 4)), Number(yyyymmdd.slice(4, 6)) - 1, Number(yyyymmdd.slice(6, 8)));
      return Math.floor(d / 86400000);
    }
    function formatTrendDate(days: number): string {
      const d = new Date(days * 86400000);
      return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
    }

    const trendAccent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#5eead4';

    function renderTrendChart() {
      const metric = (document.getElementById('trend-metric') as HTMLSelectElement).value as keyof RecentSolar;
      const container = document.getElementById('trend-chart')!;
      const points = recentSolar.filter((r) => r[metric] != null).map((r) => ({ x: daysSinceEpoch(r.date), y: Number(r[metric]) }));
      renderLineChart(container, points, trendAccent, { minY: 0, formatX: formatTrendDate });
    }

    fetch('/api/solar/recent?days=90')
      .then((r) => r.json())
      .then((rows: RecentSolar[]) => {
        recentSolar = rows;
        renderTrendChart();
      });
    document.getElementById('trend-metric')!.addEventListener('change', renderTrendChart);

    // --- 27-day forecast — distinct from the trend chart above (that's
    // historical; this is NOAA's own predicted SFI/A/Kp going forward). ---
    type ForecastRow = { date: string; sfi: number; aIndex: number; kIndex: number };
    let solarForecast: ForecastRow[] = [];
    const forecastAccent = getComputedStyle(document.documentElement).getPropertyValue('--accent-2').trim() || '#f5a962';

    function renderForecastChart() {
      const metric = (document.getElementById('forecast-metric') as HTMLSelectElement).value as keyof ForecastRow;
      const container = document.getElementById('forecast-chart')!;
      const points = solarForecast.map((r) => ({ x: daysSinceEpoch(r.date), y: Number(r[metric]) }));
      renderLineChart(container, points, forecastAccent, { minY: 0, formatX: formatTrendDate });
    }

    fetch('/api/solar/forecast')
      .then((r) => r.json())
      .then((rows: ForecastRow[]) => {
        solarForecast = rows;
        renderForecastChart();
      });
    document.getElementById('forecast-metric')!.addEventListener('change', renderForecastChart);

    // Live SVG re-rendered server-side by prop.kc2g.com roughly every 15
    // minutes from real ionosonde network data -- embedded directly rather
    // than reimplemented client-side, since correctly computing MUF from
    // raw foF2 station data requires real ionospheric-propagation formulas
    // this project has no way to verify independently, unlike e.g. the
    // antenna-takeoff-angle calculator which had textbook reference values
    // to check against. Cache-busted on each refresh since it's a plain
    // <img>, not a fetch(), so the browser would otherwise keep serving a
    // stale cached copy for the image's own cache lifetime.
    function refreshMufMap() {
      const img = document.getElementById('muf-map') as HTMLImageElement;
      img.src = `https://prop.kc2g.com/renders/current/mufd-normal-now.svg?_=${Date.now()}`;
    }
    refreshMufMap();
    setInterval(refreshMufMap, 5 * 60 * 1000);

    // NCDXF/IARU beacon schedule, verified against the official schedule
    // table at ncdxf.org/beacon/beaconschedule.html (2026-08-10) -- no live
    // data needed at all, the whole thing is a fixed, UTC-synchronized
    // rotation: beacon index B starts transmitting on band index F at
    // second 10*((B+F) mod 18) within each repeating 3-minute (180s) cycle,
    // so at any instant every band has a different beacon active
    // simultaneously. Verified by reproducing the published table's start
    // times for the first and last beacon before trusting the formula.
    const BEACONS = [
      { call: '4U1UN', place: 'United Nations, NY' },
      { call: 'VE8AT', place: 'Canada (Inuvik, NT)' },
      { call: 'W6WX', place: 'United States (Mt. Umunhum, CA)' },
      { call: 'KH6RS', place: 'Hawaii (Maui)' },
      { call: 'ZL6B', place: 'New Zealand (Masterton)' },
      { call: 'VK6RBP', place: 'Australia (Rolystone)' },
      { call: 'JA2IGY', place: 'Japan (Mt. Asama)' },
      { call: 'RR9O', place: 'Russia (Novosibirsk)' },
      { call: 'VR2B', place: 'Hong Kong' },
      { call: '4S7B', place: 'Sri Lanka (Colombo)' },
      { call: 'ZS6DN', place: 'South Africa (Pretoria)' },
      { call: '5Z4B', place: 'Kenya (Kikuyu)' },
      { call: '4X6TU', place: 'Israel (Tel Aviv)' },
      { call: 'OH2B', place: 'Finland (Lohja)' },
      { call: 'CS3B', place: 'Madeira (São Jorge)' },
      { call: 'LU4AA', place: 'Argentina (Buenos Aires)' },
      { call: 'OA4B', place: 'Peru (Lima)' },
      { call: 'YV5B', place: 'Venezuela (Caracas)' },
    ];
    const BEACON_BANDS = [
      { mhz: 14.1, label: '20m' },
      { mhz: 18.11, label: '17m' },
      { mhz: 21.15, label: '15m' },
      { mhz: 24.93, label: '12m' },
      { mhz: 28.2, label: '10m' },
    ];

    function renderBeaconTable() {
      const nowSec = Math.floor(Date.now() / 1000);
      const secondsIntoCycle = nowSec % 180;
      const slotIndex = Math.floor(secondsIntoCycle / 10);
      const secondsLeft = 10 - (secondsIntoCycle % 10);

      const table = document.getElementById('beacon-table')!;
      table.innerHTML = BEACON_BANDS.map((band, bandIndex) => {
        const beaconIndex = (slotIndex - bandIndex + 18) % 18;
        const beacon = BEACONS[beaconIndex];
        return `
          <div class="beacon-row">
            <span class="beacon-freq">${band.mhz.toFixed(3)} (${band.label})</span>
            <span class="beacon-call">${beacon.call}</span>
            <span class="beacon-place">${beacon.place}</span>
            <span class="beacon-countdown">${secondsLeft}s</span>
          </div>
        `;
      }).join('');
    }
    renderBeaconTable();
    setInterval(renderBeaconTable, 1000);

    type Today = { date: string; sfi: number | null; aIndex: number | null; kIndex: number | null; sunspotNumber: number | null } | null;
    type Spot = { spotter: string; call: string; frequency: string; band: number; mode: string; comment: string; time: string; continent: string; grid: string; lotw: boolean; needed: 'needed' | 'worked' | null };
    type Contest = { title: string; link: string; description: string };
    type HomeCoords = { lat: number; lon: number; grid: string | null } | null;
    type Dxpedition = { entity: string; dateRange: string; call: string; qslVia: string; info: string; needed: boolean | null };

    function formatDate(d: string) {
      if (d.length !== 8) return d;
      return `${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}`;
    }

    function formatClock(d: Date) {
      return d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    }

    fetch('/api/conditions/home')
      .then((r) => r.json())
      .then((home: HomeCoords) => {
        if (!home) return;
        if (home.grid) document.getElementById('sun-grid')!.textContent = ` (${home.grid.slice(0, 6)})`;
        const now = new Date();
        const sun = sunriseSunset(now, home.lat, home.lon);
        if (!sun) {
          document.getElementById('sun-status')!.textContent = 'Sun never rises or sets today at this latitude (polar day/night).';
          return;
        }
        document.getElementById('sun-sunrise')!.textContent = formatClock(sun.sunrise);
        document.getElementById('sun-sunset')!.textContent = formatClock(sun.sunset);
        document.getElementById('sun-noon')!.textContent = formatClock(sun.solarNoon);
        const dayMinutes = Math.round((sun.sunset.getTime() - sun.sunrise.getTime()) / 60000);
        document.getElementById('sun-daylength')!.textContent = `${Math.floor(dayMinutes / 60)}h ${dayMinutes % 60}m`;
        const status = now < sun.sunrise || now > sun.sunset ? 'Currently dark' : 'Currently daylight';
        document.getElementById('sun-status')!.textContent = `${status} at the station QTH · see the grayline overlay on the Map page for the current worldwide day/night line.`;
      });

    // Rough A-F shorthand for "is HF propagation good right now" -- SFI
    // (higher is better, more ionization/higher MUF) and K-index (lower is
    // better, geomagnetic disturbance degrades HF) are the two numbers hams
    // actually glance at first; A-index is deliberately left out since it's
    // just K's own daily-average restated on a different scale, not a
    // second independent signal. Thresholds are standard, commonly-cited
    // tiers (e.g. K>=5 is NOAA's own "storm" threshold), but the combined
    // grade itself is this page's own simplified heuristic, not a
    // certified forecast -- same "don't overclaim precision" spirit as the
    // MUF map and coax-loss table elsewhere on this site.
    function gradeConditions(sfi: number, kIndex: number): { grade: string; color: string } {
      const sfiPoints = sfi >= 160 ? 4 : sfi >= 130 ? 3 : sfi >= 100 ? 2 : sfi >= 70 ? 1 : 0;
      const kPoints = kIndex <= 1 ? 4 : kIndex <= 2 ? 3 : kIndex <= 3 ? 2 : kIndex <= 4 ? 1 : 0;
      const total = sfiPoints + kPoints;
      if (total >= 7) return { grade: 'A', color: 'var(--status-good)' };
      if (total >= 5) return { grade: 'B', color: 'var(--status-good)' };
      if (total >= 3) return { grade: 'C', color: 'var(--status-warning)' };
      if (total >= 1) return { grade: 'D', color: 'var(--status-warning)' };
      return { grade: 'F', color: 'var(--status-critical)' };
    }

    function loadToday() {
      fetch('/api/conditions/today')
      .then((r) => r.json())
      .then((data: Today) => {
        if (!data) return;
        document.getElementById('cond-sfi')!.textContent = data.sfi != null ? String(data.sfi) : '—';
        document.getElementById('cond-a')!.textContent = data.aIndex != null ? String(data.aIndex) : '—';
        document.getElementById('cond-k')!.textContent = data.kIndex != null ? data.kIndex.toFixed(1) : '—';
        document.getElementById('cond-sn')!.textContent = data.sunspotNumber != null ? String(data.sunspotNumber) : '—';
        document.getElementById('cond-date')!.textContent = `As of ${formatDate(data.date)} (most recent available solar data)`;

        const gradeEl = document.getElementById('cond-grade')!;
        const gradeSubEl = document.getElementById('cond-grade-sub')!;
        if (data.sfi != null && data.kIndex != null) {
          const { grade, color } = gradeConditions(data.sfi, data.kIndex);
          gradeEl.textContent = grade;
          gradeEl.style.color = color;
          gradeSubEl.textContent = `SFI ${data.sfi}, K ${data.kIndex.toFixed(1)} · rough estimate`;
        } else {
          gradeEl.textContent = '—';
          gradeSubEl.textContent = 'Not enough data';
        }

        // "This day last year" -- relative to data.date (the most recent
        // day with real data), not new Date(), so it stays consistent with
        // whatever the tiles above are actually showing even if solar sync
        // is a day or two behind.
        const y = Number(data.date.slice(0, 4));
        const m = Number(data.date.slice(4, 6));
        const d = Number(data.date.slice(6, 8));
        const yearAgo = new Date(Date.UTC(y - 1, m - 1, d));
        const yearAgoStr = `${yearAgo.getUTCFullYear()}${String(yearAgo.getUTCMonth() + 1).padStart(2, '0')}${String(yearAgo.getUTCDate()).padStart(2, '0')}`;
        fetch(`/api/solar/on-date?date=${yearAgoStr}`)
          .then((r) => r.json())
          .then((prior: { sfi: number | null; kIndex: number | null } | null) => {
            const el = document.getElementById('cond-year-ago')!;
            if (!prior || prior.sfi == null || prior.kIndex == null || data.sfi == null || data.kIndex == null) return;
            // Round to the same 1 decimal shown in the tiles *before*
            // subtracting, not after -- otherwise the displayed delta can
            // silently disagree with the two displayed numbers it's
            // supposedly the difference of (e.g. "2.3, +1.4 since 1.0" isn't
            // self-consistent even though it's the mathematically correct
            // delta of the raw, unrounded values).
            const priorSfi = Number(prior.sfi.toFixed(1));
            const priorK = Number(prior.kIndex.toFixed(1));
            const nowSfi = Number(data.sfi.toFixed(1));
            const nowK = Number(data.kIndex.toFixed(1));
            const sfiDelta = nowSfi - priorSfi;
            const kDelta = nowK - priorK;
            el.textContent =
              `This day last year (${formatDate(yearAgoStr)}): SFI ${priorSfi} (${sfiDelta >= 0 ? '+' : ''}${sfiDelta.toFixed(1)} since)` +
              `, K ${priorK.toFixed(1)} (${kDelta >= 0 ? '+' : ''}${kDelta.toFixed(1)} since)`;
          })
          .catch(() => {});
      });
    }
    loadToday();

    // --- Manual solar-data sync trigger, moved here from the QSO Log page
    // -- it populates this page's own SFI/A/K tiles and the trend chart
    // above, not QSO-log content. Admin-gated like every other sync button
    // on the site; reuses whatever session token logging in on Admin/Log/
    // Radio already stored, rather than requiring a separate login form
    // just for this one button. ---
    async function syncSolarData(full: boolean) {
      const status = document.getElementById('cond-solar-sync-status')!;
      const token = sessionStorage.getItem(TOKEN_KEY);
      if (!token) {
        status.textContent = 'Log in via Admin, Log, or Radio first, then come back to sync.';
        return;
      }
      status.textContent = 'Syncing…';
      const res = await fetch(`/api/solar/sync${full ? '?full=1' : ''}`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const { imported, from, to } = await res.json();
        status.textContent = `Synced ${imported} days (${from}–${to}).`;
        loadToday();
        loadLastSynced();
      } else if (res.status === 401) {
        sessionStorage.removeItem(TOKEN_KEY);
        status.textContent = 'Session expired — log in again via Admin, Log, or Radio.';
      } else {
        const body = await res.json().catch(() => ({}));
        status.textContent = body.error ?? 'Solar sync failed.';
      }
    }
    document.getElementById('cond-solar-sync')!.addEventListener('click', () => syncSolarData(false));
    document.getElementById('cond-solar-full-sync')!.addEventListener('click', () => syncSolarData(true));

    function loadLastSynced() {
      fetch('/api/sync-status')
        .then((r) => r.json())
        .then((status: { solar: string | null }) => {
          const el = document.getElementById('cond-solar-last-synced')!;
          el.textContent = status.solar ? `Last synced ${new Date(status.solar).toLocaleString()}` : 'Never synced';
        });
    }
    loadLastSynced();

    // Reuses the same spot feed the table below already fetches -- no
    // second request to dxheat just to also show it grouped by band. Sorted
    // by descending band-in-meters, which is naturally 160m-\>2m in the
    // right ham-band order without needing a hardcoded band list. Excludes
    // sub-1m "bands" -- confirmed live these are real but rare geostationary
    // satellite crossband spots (dxheat reports QO-100 traffic at its true
    // ~10GHz/0.03m), not terrestrial propagation, which is what this gauge
    // is actually meant to represent.
    function renderBandActivity(spots: Spot[]) {
      const container = document.getElementById('band-activity-bars')!;
      const counts = new Map<number, number>();
      for (const s of spots) {
        if (s.band < 1) continue;
        counts.set(s.band, (counts.get(s.band) ?? 0) + 1);
      }
      if (!counts.size) {
        container.innerHTML = '<p class="status-line">No spots available right now.</p>';
        return;
      }
      const maxCount = Math.max(...counts.values());
      const bands = [...counts.keys()].sort((a, b) => b - a);
      container.innerHTML = bands
        .map((band) => {
          const count = counts.get(band)!;
          const pct = ((count / maxCount) * 100).toFixed(0);
          return `
            <div class="band-activity-row">
              <span class="band-activity-label">${band}M</span>
              <div class="meter-track"><div class="meter-fill" style="width:${pct}%;"></div></div>
              <span class="band-activity-count">${count}</span>
            </div>
          `;
        })
        .join('');
    }

    function loadSpots() {
      fetch('/api/conditions/spots')
        .then((r) => r.json())
        .then((spots: Spot[]) => {
          // Only touched on a successful fetch -- if a later poll fails,
          // this keeps showing when the feed was last actually refreshed
          // rather than going blank or silently looking current.
          document.getElementById('spot-updated-at')!.textContent = `Last updated ${new Date().toLocaleTimeString()}`;
          renderBandActivity(spots);
          const table = document.getElementById('spot-table')!;
          if (!spots.length) {
            table.innerHTML = '<p class="status-line">No spots available right now.</p>';
            return;
          }
          table.innerHTML = '';
          for (const s of spots) {
            const row = document.createElement('div');
            row.className = 'spot-row';
            if (s.needed === 'needed') row.classList.add('needed');
            const freqMhz = (Number(s.frequency) / 1000).toFixed(3);
            const comment = escapeHtml(s.comment ?? '');
            row.innerHTML = `
              <span class="call">${escapeHtml(s.call)}${s.needed === 'needed' ? ' <span class="needed-badge">Needed</span>' : ''}</span>
              <span class="freq">${freqMhz}</span>
              <span>${escapeHtml(s.mode ?? '')}</span>
              <span class="comment" title="${comment}">${comment}</span>
              <span class="time">${escapeHtml(s.time ?? '')}z</span>
            `;
            table.appendChild(row);
          }
        })
        .catch(() => {
          document.getElementById('spot-table')!.innerHTML = '<p class="status-line">Could not load spots.</p>';
          document.getElementById('band-activity-bars')!.innerHTML = '<p class="status-line">Could not load spots.</p>';
        });
    }
    loadSpots();
    setInterval(loadSpots, 60000);

    function loadDxpeditions() {
      fetch('/api/conditions/dxpeditions')
        .then((r) => r.json())
        .then((ops: Dxpedition[]) => {
          const list = document.getElementById('dxpedition-list')!;
          if (!ops.length) {
            list.innerHTML = '<p class="status-line">No DXpedition data available right now.</p>';
            return;
          }
          list.innerHTML = '';
          for (const op of ops) {
            const row = document.createElement('div');
            row.className = 'dxpedition-row';
            if (op.needed) row.classList.add('needed');
            row.innerHTML = `
              <div class="headline">
                <span class="call">${escapeHtml(op.call)}</span>
                <span class="entity">${escapeHtml(op.entity)}${op.needed ? ' <span class="needed-badge">Needed</span>' : ''}</span>
                <span class="dates">${escapeHtml(op.dateRange)}</span>
              </div>
              <div class="info">${escapeHtml(op.info)}${op.qslVia ? ` &mdash; QSL via ${escapeHtml(op.qslVia)}` : ''}</div>
            `;
            list.appendChild(row);
          }
        })
        .catch(() => {
          document.getElementById('dxpedition-list')!.innerHTML = '<p class="status-line">Could not load DXpedition calendar.</p>';
        });
    }
    loadDxpeditions();

    fetch('/api/conditions/contests')
      .then((r) => r.json())
      .then((contests: Contest[]) => {
        const list = document.getElementById('contest-list')!;
        if (!contests.length) {
          list.innerHTML = '<p class="status-line">No contest data available right now.</p>';
          return;
        }
        list.innerHTML = '';
        for (const contest of contests) {
          const row = document.createElement('div');
          row.className = 'contest-row';
          // Only accept a plain http(s) link as an href -- the feed is
          // external (contestcalendar.com), so a malicious/compromised
          // entry could otherwise supply a `javascript:` URI.
          const safeLink = /^https?:\/\//i.test(contest.link) ? escapeHtml(contest.link) : '#';
          row.innerHTML = `
            <a href="${safeLink}" target="_blank" rel="noopener">${escapeHtml(contest.title)}</a>
            <div class="when">${escapeHtml(contest.description)}</div>
          `;
          list.appendChild(row);
        }
      })
      .catch(() => {
        document.getElementById('contest-list')!.innerHTML = '<p class="status-line">Could not load contest calendar.</p>';
      });

    // --- KiwiSDR noise floor -- a one-shot spot-check on page load, plus a
    // manual re-check button, never an auto-poll (see the card's own
    // description for why: polling would mean quietly holding a receiver
    // channel open just for this page to exist). ---
    function dbmToSUnit(dbm: number): string {
      const sUnits = 9 + (dbm + 73) / 6;
      if (sUnits >= 9) {
        const over = Math.round((sUnits - 9) * 6);
        return over > 0 ? `S9+${over}dB` : 'S9';
      }
      return `S${Math.max(1, Math.round(sUnits))}`;
    }

    function checkNoiseFloor() {
      const status = document.getElementById('noise-floor-status')!;
      const checkedAt = document.getElementById('noise-floor-checked-at')!;
      status.textContent = 'Checking…';
      fetch('/api/kiwisdr/noise-floor')
        .then(async (r) => {
          if (!r.ok) {
            const body = await r.json().catch(() => ({}));
            status.textContent = body.error ?? 'Could not read the KiwiSDR right now.';
            return;
          }
          const d: { smeterDbm: number; freqKhz: number; mode: string } = await r.json();
          status.textContent =
            `${dbmToSUnit(d.smeterDbm)} (${d.smeterDbm.toFixed(0)}dBm) on ${(d.freqKhz / 1000).toFixed(3)} MHz ${d.mode.toUpperCase()}`;
          // Only updated on a successful read -- if a later check fails, this
          // keeps showing when the last GOOD reading actually happened
          // instead of going blank or silently looking current.
          const now = new Date();
          checkedAt.textContent = `Checked ${now.toLocaleDateString()} ${now.toLocaleTimeString()}`;
        })
        .catch(() => {
          status.textContent = 'Could not reach the KiwiSDR.';
        });
    }
    checkNoiseFloor();
    document.getElementById('noise-floor-refresh')!.addEventListener('click', checkNoiseFloor);

    // --- Lightning map -- polled every 20s (not a WebSocket), which is
    // plenty responsive for situational awareness on strikes that are
    // already up to 2 hours old by the time they age out of the feed. ---
    type LightningStatus = {
      enabled: boolean;
      locationConfigured: boolean;
      homeLat: number | null;
      homeLon: number | null;
      connected: boolean;
      strikeCount: number;
      closestDistanceKm: number | null;
      displayRadiusKm: number;
      alertRadiusKm: number;
    };
    type Strike = { lat: number; lon: number; distanceKm: number; timestamp: number };

    const lightningUnavailable = document.getElementById('lightning-unavailable')!;
    const lightningContent = document.getElementById('lightning-content')!;
    const lightningStatusEl = document.getElementById('lightning-status')!;
    let lightningMap: L.Map | null = null;
    let lightningMarkers: L.CircleMarker[] = [];
    let lightningStrikes: Strike[] = [];
    // Loaded once; the description spans and any already-fetched strikes are
    // re-rendered once this resolves, since loadLightning() may have already
    // run once with the 'mi' default before the fetch completes.
    let distanceUnit: DistanceUnit = 'mi';
    fetchDistanceUnit().then((u) => {
      distanceUnit = u;
      renderStrikes(lightningStrikes);
    });

    function clearLightningMarkers() {
      for (const m of lightningMarkers) m.remove();
      lightningMarkers = [];
    }

    function strikeColor(ageMinutes: number): string {
      // Bright/hot for a fresh strike, fading toward muted as it ages out
      // of the 2h retention window -- an "is this still happening" read at
      // a glance, not just a flat list of dots.
      const t = Math.min(1, ageMinutes / 120);
      const critical = getComputedStyle(document.documentElement).getPropertyValue('--status-critical').trim() || '#d03b3b';
      const muted = getComputedStyle(document.documentElement).getPropertyValue('--muted').trim() || '#8d98a1';
      return t < 0.5 ? critical : muted;
    }

    function renderStrikes(strikes: Strike[]) {
      lightningStrikes = strikes;
      if (!lightningMap) return;
      clearLightningMarkers();
      const now = Date.now();
      for (const s of strikes) {
        const ageMinutes = (now - s.timestamp) / 60000;
        const color = strikeColor(ageMinutes);
        const marker = L.circleMarker([s.lat, s.lon], {
          radius: 4,
          color,
          fillColor: color,
          fillOpacity: 0.7,
          weight: 1,
        })
          .bindTooltip(`${formatDistance(s.distanceKm, distanceUnit)} away, ${ageMinutes < 1 ? 'just now' : `${Math.round(ageMinutes)}m ago`}`, { sticky: true })
          .addTo(lightningMap);
        lightningMarkers.push(marker);
      }
    }

    function initLightningMap(lat: number, lon: number, displayRadiusKm: number, alertRadiusKm: number) {
      if (lightningMap) return;
      lightningMap = L.map('lightning-map').setView([lat, lon], 7);
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      L.tileLayer(`https://{s}.basemaps.cartocdn.com/${isDark ? 'dark_all' : 'light_all'}/{z}/{x}/{y}{r}.png`, {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 18,
      }).addTo(lightningMap);
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#5eead4';
      L.marker([lat, lon]).addTo(lightningMap).bindTooltip('Station QTH');
      L.circle([lat, lon], { radius: alertRadiusKm * 1000, color: accent, fill: false, weight: 2 }).addTo(lightningMap);
      L.circle([lat, lon], { radius: displayRadiusKm * 1000, color: accent, fill: false, weight: 1, dashArray: '4 6', opacity: 0.5 }).addTo(lightningMap);
    }

    function loadLightning() {
      fetch('/api/lightning/status')
        .then((r) => r.json())
        .then((s: LightningStatus) => {
          if (!s.locationConfigured) {
            lightningUnavailable.hidden = false;
            lightningUnavailable.textContent = 'No station location configured under Admin — lightning tracking needs one to know what "nearby" means.';
            lightningContent.hidden = true;
            return;
          }
          if (!s.enabled) {
            lightningUnavailable.hidden = false;
            lightningUnavailable.textContent = 'Lightning monitoring is currently off.';
            lightningContent.hidden = true;
            return;
          }
          lightningUnavailable.hidden = true;
          lightningContent.hidden = false;
          if (s.homeLat != null && s.homeLon != null) initLightningMap(s.homeLat, s.homeLon, s.displayRadiusKm, s.alertRadiusKm);
          document.getElementById('lightning-display-radius')!.textContent = formatDistance(s.displayRadiusKm, distanceUnit);
          document.getElementById('lightning-alert-radius')!.textContent = formatDistance(s.alertRadiusKm, distanceUnit);

          if (!s.connected) {
            lightningStatusEl.textContent = 'Connecting…';
            return;
          }
          const closest =
            s.closestDistanceKm != null ? `, closest ${formatDistance(s.closestDistanceKm, distanceUnit)}` : '';
          lightningStatusEl.textContent =
            `${s.strikeCount} strike${s.strikeCount === 1 ? '' : 's'} in the last 2 hours${closest} — as of ${new Date().toLocaleTimeString()}`;

          fetch('/api/lightning/strikes')
            .then((r) => r.json())
            .then((strikes: Strike[]) => renderStrikes(strikes));
        })
        .catch(() => {
          lightningUnavailable.hidden = false;
          lightningUnavailable.textContent = 'Could not load lightning status.';
          lightningContent.hidden = true;
        });
    }
    loadLightning();
    setInterval(loadLightning, 20000);

    // --- PSK Reporter / WSPR / RBN reception reports -- moved here from
    // /radio: these are propagation evidence (who's hearing this station,
    // from where), not radio-control features. ---
    type PskReport = { receiver: string; receiverGrid: string | null; receiverDxcc: string | null; frequency: number | null; mode: string | null; snr: number | null; time: number | null };
    type WsprReport = { receiver: string; receiverGrid: string | null; lat: number | null; lon: number | null; frequency: number | null; snr: number | null; distanceKm: number | null; time: number | null };
    type RbnReport = { skimmer: string; lat: number | null; lon: number | null; frequency: number | null; db: number | null; wpm: number | null; mode: string | null; time: number | null };

    function formatTimeAgo(unixSeconds: number | null): string {
      if (!unixSeconds) return '';
      const seconds = Math.max(0, Math.round(Date.now() / 1000 - unixSeconds));
      if (seconds < 60) return `${seconds}s ago`;
      const minutes = Math.round(seconds / 60);
      if (minutes < 60) return `${minutes}m ago`;
      return `${Math.round(minutes / 60)}h ago`;
    }

    // --- Reception maps: great-circle arcs from home to each receiver's grid
    // square, redrawn every time each load*Reports() refreshes (60s cycle). ---
    const pskMap = L.map('psk-map', { worldCopyJump: true }).setView([20, 0], 2);
    const pskIsDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    L.tileLayer(`https://{s}.basemaps.cartocdn.com/${pskIsDark ? 'dark_all' : 'light_all'}/{z}/{x}/{y}{r}.png`, {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 18,
    }).addTo(pskMap);
    const pskRenderer = L.canvas({ padding: 0.5 });
    const pskLayer = L.layerGroup().addTo(pskMap);
    const pskAccent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#5eead4';

    const wsprMap = L.map('wspr-map', { worldCopyJump: true }).setView([20, 0], 2);
    L.tileLayer(`https://{s}.basemaps.cartocdn.com/${pskIsDark ? 'dark_all' : 'light_all'}/{z}/{x}/{y}{r}.png`, {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 18,
    }).addTo(wsprMap);
    const wsprRenderer = L.canvas({ padding: 0.5 });
    const wsprLayer = L.layerGroup().addTo(wsprMap);
    const wsprAccent = getComputedStyle(document.documentElement).getPropertyValue('--accent-2').trim() || '#f5a962';

    const rbnMap = L.map('rbn-map', { worldCopyJump: true }).setView([20, 0], 2);
    L.tileLayer(`https://{s}.basemaps.cartocdn.com/${pskIsDark ? 'dark_all' : 'light_all'}/{z}/{x}/{y}{r}.png`, {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 18,
    }).addTo(rbnMap);
    const rbnRenderer = L.canvas({ padding: 0.5 });
    const rbnLayer = L.layerGroup().addTo(rbnMap);
    const rbnAccent = getComputedStyle(document.documentElement).getPropertyValue('--band-3').trim() || '#199e70';

    let pskHome: { lat: number; lon: number } | null = null;
    let lastPskReports: PskReport[] = [];
    let lastWsprReports: WsprReport[] = [];
    let lastRbnReports: RbnReport[] = [];
    fetch('/api/conditions/home')
      .then((r) => r.json())
      .then((home: { lat: number; lon: number } | null) => {
        pskHome = home;
        if (home) {
          L.circleMarker([home.lat, home.lon], { radius: 6, color: pskAccent, fillColor: pskAccent, fillOpacity: 1, weight: 2, renderer: pskRenderer })
            .bindTooltip('Home', { permanent: true, direction: 'top', className: 'home-tooltip' })
            .addTo(pskMap);
          drawPskMap(lastPskReports);
          L.circleMarker([home.lat, home.lon], { radius: 6, color: wsprAccent, fillColor: wsprAccent, fillOpacity: 1, weight: 2, renderer: wsprRenderer })
            .bindTooltip('Home', { permanent: true, direction: 'top', className: 'home-tooltip' })
            .addTo(wsprMap);
          drawWsprMap(lastWsprReports);
          L.circleMarker([home.lat, home.lon], { radius: 6, color: rbnAccent, fillColor: rbnAccent, fillOpacity: 1, weight: 2, renderer: rbnRenderer })
            .bindTooltip('Home', { permanent: true, direction: 'top', className: 'home-tooltip' })
            .addTo(rbnMap);
          drawRbnMap(lastRbnReports);
        }
      });

    function drawPskMap(reports: PskReport[]) {
      pskLayer.clearLayers();
      if (!pskHome) return;
      for (const r of reports) {
        if (!r.receiverGrid) continue;
        const loc = gridToLatLon(r.receiverGrid);
        if (!loc) continue;
        const arc = greatCircleArc(pskHome.lat, pskHome.lon, loc.lat, loc.lon, 16);
        const tooltipText = `${escapeHtml(r.receiver)}${r.receiverDxcc ? ` (${escapeHtml(r.receiverDxcc)})` : ''} · ${r.snr != null ? `${r.snr > 0 ? '+' : ''}${r.snr}dB` : '—'} · ${formatTimeAgo(r.time)}`;
        const line = L.polyline(arc, { color: pskAccent, weight: 1.5, opacity: 0.6, renderer: pskRenderer });
        line.bindTooltip(tooltipText, { sticky: true });
        pskLayer.addLayer(line);
        const dot = L.circleMarker([loc.lat, loc.lon], { radius: 4, color: pskAccent, fillColor: pskAccent, fillOpacity: 1, weight: 1, renderer: pskRenderer });
        dot.bindTooltip(tooltipText, { sticky: true });
        pskLayer.addLayer(dot);
      }
    }

    function drawWsprMap(reports: WsprReport[]) {
      wsprLayer.clearLayers();
      if (!pskHome) return;
      for (const r of reports) {
        if (r.lat == null || r.lon == null) continue;
        const arc = greatCircleArc(pskHome.lat, pskHome.lon, r.lat, r.lon, 16);
        const tooltipText = `${escapeHtml(r.receiver)} · ${r.snr != null ? `${r.snr > 0 ? '+' : ''}${r.snr}dB` : '—'} · ${r.distanceKm != null ? formatDistance(r.distanceKm, distanceUnit) : ''} · ${formatTimeAgo(r.time)}`;
        const line = L.polyline(arc, { color: wsprAccent, weight: 1.5, opacity: 0.6, renderer: wsprRenderer });
        line.bindTooltip(tooltipText, { sticky: true });
        wsprLayer.addLayer(line);
        const dot = L.circleMarker([r.lat, r.lon], { radius: 4, color: wsprAccent, fillColor: wsprAccent, fillOpacity: 1, weight: 1, renderer: wsprRenderer });
        dot.bindTooltip(tooltipText, { sticky: true });
        wsprLayer.addLayer(dot);
      }
    }

    function loadWsprReports() {
      fetch('/api/conditions/wspr')
        .then((r) => r.json())
        .then((reports: WsprReport[]) => {
          lastWsprReports = reports;
          drawWsprMap(reports);
          document.getElementById('wspr-updated-at')!.textContent = `Last updated ${new Date().toLocaleTimeString()}`;
          const table = document.getElementById('wspr-table')!;
          if (!reports.length) {
            table.innerHTML = '<p class="status-line">No WSPR reception reports in the last hour &mdash; station likely not currently beaconing WSPR.</p>';
            return;
          }
          table.innerHTML = '';
          for (const r of reports) {
            const row = document.createElement('div');
            row.className = 'psk-row';
            const freqMhz = r.frequency != null ? (r.frequency / 1e6).toFixed(4) : '—';
            const snrClass = r.snr == null ? '' : r.snr >= -15 ? 'strong' : r.snr <= -25 ? 'weak' : '';
            row.innerHTML = `
              <span class="call">${escapeHtml(r.receiver)}</span>
              <span class="place">${escapeHtml(r.receiverGrid ?? '')}${r.distanceKm != null ? ` · ${formatDistance(r.distanceKm, distanceUnit)}` : ''}</span>
              <span class="freq">${freqMhz}</span>
              <span class="snr ${snrClass}">${r.snr != null ? `${r.snr > 0 ? '+' : ''}${r.snr}dB` : '—'}</span>
              <span class="ago">${formatTimeAgo(r.time)}</span>
            `;
            table.appendChild(row);
          }
        })
        .catch(() => {
          document.getElementById('wspr-table')!.innerHTML = '<p class="status-line">Could not load WSPR reception data.</p>';
        });
    }
    loadWsprReports();
    setInterval(loadWsprReports, 60000);

    function drawRbnMap(reports: RbnReport[]) {
      rbnLayer.clearLayers();
      if (!pskHome) return;
      for (const r of reports) {
        if (r.lat == null || r.lon == null) continue;
        const arc = greatCircleArc(pskHome.lat, pskHome.lon, r.lat, r.lon, 16);
        const tooltipText = `${escapeHtml(r.skimmer)} · ${escapeHtml(r.mode ?? '—')}${r.wpm != null ? ` ${r.wpm}wpm` : ''} · ${r.db != null ? `${r.db}dB` : '—'} · ${formatTimeAgo(r.time)}`;
        const line = L.polyline(arc, { color: rbnAccent, weight: 1.5, opacity: 0.6, renderer: rbnRenderer });
        line.bindTooltip(tooltipText, { sticky: true });
        rbnLayer.addLayer(line);
        const dot = L.circleMarker([r.lat, r.lon], { radius: 4, color: rbnAccent, fillColor: rbnAccent, fillOpacity: 1, weight: 1, renderer: rbnRenderer });
        dot.bindTooltip(tooltipText, { sticky: true });
        rbnLayer.addLayer(dot);
      }
    }

    function loadRbnReports() {
      fetch('/api/conditions/rbn')
        .then((r) => r.json())
        .then((reports: RbnReport[]) => {
          lastRbnReports = reports;
          drawRbnMap(reports);
          document.getElementById('rbn-updated-at')!.textContent = `Last updated ${new Date().toLocaleTimeString()}`;
          const table = document.getElementById('rbn-table')!;
          if (!reports.length) {
            table.innerHTML = '<p class="status-line">No CW/RTTY skimmer reports in the last hour &mdash; station likely not currently on CW or RTTY.</p>';
            return;
          }
          table.innerHTML = '';
          for (const r of reports) {
            const row = document.createElement('div');
            row.className = 'psk-row';
            const freqMhz = r.frequency != null ? (r.frequency / 1e6).toFixed(4) : '—';
            const dbClass = r.db == null ? '' : r.db >= 20 ? 'strong' : r.db <= 5 ? 'weak' : '';
            row.innerHTML = `
              <span class="call">${escapeHtml(r.skimmer)}</span>
              <span class="place">${escapeHtml(r.mode ?? '')}${r.wpm != null ? ` ${r.wpm}wpm` : ''}</span>
              <span class="freq">${freqMhz}</span>
              <span class="snr ${dbClass}">${r.db != null ? `${r.db}dB` : '—'}</span>
              <span class="ago">${formatTimeAgo(r.time)}</span>
            `;
            table.appendChild(row);
          }
        })
        .catch(() => {
          document.getElementById('rbn-table')!.innerHTML = '<p class="status-line">Could not load RBN reception data.</p>';
        });
    }
    loadRbnReports();
    setInterval(loadRbnReports, 60000);

    function loadPskReports() {
      fetch('/api/conditions/pskreporter')
        .then((r) => r.json())
        .then((reports: PskReport[]) => {
          lastPskReports = reports;
          drawPskMap(reports);
          document.getElementById('psk-updated-at')!.textContent = `Last updated ${new Date().toLocaleTimeString()}`;
          const table = document.getElementById('psk-table')!;
          if (!reports.length) {
            table.innerHTML = '<p class="status-line">No reception reports in the last hour &mdash; station likely not currently transmitting a decodable digital mode.</p>';
            return;
          }
          table.innerHTML = '';
          for (const r of reports) {
            const row = document.createElement('div');
            row.className = 'psk-row';
            const freqMhz = r.frequency != null ? (r.frequency / 1e6).toFixed(3) : '—';
            const snrClass = r.snr == null ? '' : r.snr >= -6 ? 'strong' : r.snr <= -18 ? 'weak' : '';
            row.innerHTML = `
              <span class="call">${escapeHtml(r.receiver)}</span>
              <span class="place">${escapeHtml(r.receiverDxcc ?? '')}${r.receiverGrid ? ` (${escapeHtml(r.receiverGrid.slice(0, 6))})` : ''}</span>
              <span class="freq">${freqMhz}</span>
              <span class="snr ${snrClass}">${r.snr != null ? `${r.snr > 0 ? '+' : ''}${r.snr}dB` : '—'}</span>
              <span class="ago">${formatTimeAgo(r.time)}</span>
            `;
            table.appendChild(row);
          }
        })
        .catch(() => {
          document.getElementById('psk-table')!.innerHTML = '<p class="status-line">Could not load PSK Reporter data.</p>';
        });
    }
    loadPskReports();
    setInterval(loadPskReports, 60000);
  </script>
