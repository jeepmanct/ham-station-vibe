---
import Base from '../layouts/Base.astro';
import FilterPanel from '../components/FilterPanel.astro';
import '../styles/map.css';
---
<Base title="QSO Map" active="map">
  <h1>QSO Map</h1>
  <p class="lede">Great-circle paths from home to every logged contact &mdash; enable a band, mode, country, state, or date range below to plot contacts on the map.</p>

  <FilterPanel />

  <label style="display:inline-flex;align-items:center;gap:0.5rem;margin-top:1rem;font-size:0.9rem;cursor:pointer;">
    <input type="checkbox" id="grayline-toggle" />
    Show day/night grayline
  </label>
  <label style="display:inline-flex;align-items:center;gap:0.5rem;margin-top:1rem;margin-left:1.25rem;font-size:0.9rem;cursor:pointer;">
    <input type="checkbox" id="aurora-toggle" />
    Show aurora forecast
  </label>
  <span class="status-line" id="aurora-status" style="margin-left:0.5rem;"></span>

  <div class="map-view-toggle" style="margin-top:1rem;">
    <button type="button" class="btn secondary active" id="view-2d-btn">2D Map</button>
    <button type="button" class="btn secondary" id="view-3d-btn">3D Globe</button>
  </div>

  <div id="qso-map"></div>
  <div id="qso-globe-wrap" hidden>
    <canvas id="qso-globe" width="900" height="900"></canvas>
    <p class="chart-desc" style="margin-top:0.5rem;">Drag to rotate &mdash; spins on its own when you let go.</p>
  </div>
  <p id="map-status" class="status-line" style="margin-top:0.5rem;"></p>

  <script>
    import 'leaflet/dist/leaflet.css';
    import L from 'leaflet';
    import { greatCircleArc } from '../lib/geo';
    import { initQsoFilters } from '../lib/qsoFilters';
    import { terminatorPoints, subsolarPoint } from '../lib/grayline';
    import { escapeHtml } from '../lib/escapeHtml';
    import { projectPoint, loadLandPolygons } from '../lib/globe';

    type Point = {
      call: string;
      qsoDate: string;
      band: string | null;
      mode: string | null;
      gridsquare: string | null;
      country: string | null;
      state: string | null;
      lat: number;
      lon: number;
      sfi: number | null;
      aIndex: number | null;
      kIndex: number | null;
    };
    type GeoResponse = { home: { lat: number; lon: number } | null; points: Point[] };

    const style = getComputedStyle(document.documentElement);
    const BAND_VARS = ['--band-1', '--band-2', '--band-3', '--band-4', '--band-5', '--band-6', '--band-7', '--band-8'];
    const OTHER_COLOR = style.getPropertyValue('--band-other').trim() || '#8d98a1';
    const ACCENT_COLOR = style.getPropertyValue('--accent').trim() || '#5eead4';
    const ACCENT_2_COLOR = style.getPropertyValue('--accent-2').trim() || '#f5a962';

    // Self-assigning: the first call for a given band claims the next palette
    // slot. Since chip creation calls this once per band in frequency order
    // (before any map data loads), the top BAND_VARS.length bands by frequency
    // get distinct hues and the rest fall back to OTHER_COLOR.
    const bandColorIndex = new Map<string, number>();
    function colorForBand(band: string | null): string {
      if (!band) return OTHER_COLOR;
      if (!bandColorIndex.has(band) && bandColorIndex.size < BAND_VARS.length) {
        bandColorIndex.set(band, bandColorIndex.size);
      }
      const idx = bandColorIndex.get(band);
      if (idx === undefined) return OTHER_COLOR;
      return style.getPropertyValue(BAND_VARS[idx]).trim() || OTHER_COLOR;
    }

    function formatDate(d: string) {
      if (d.length !== 8) return d;
      return `${d.slice(0, 4)}-${d.slice(4, 6)}-${d.slice(6, 8)}`;
    }

    function formatSolar(p: Point): string {
      const parts = [];
      if (p.sfi != null) parts.push(`SFI ${p.sfi}`);
      if (p.aIndex != null) parts.push(`A ${p.aIndex}`);
      if (p.kIndex != null) parts.push(`K ${p.kIndex.toFixed(1)}`);
      return parts.join(' · ');
    }

    // --- Map setup ---
    const map = L.map('qso-map', { worldCopyJump: true }).setView([20, 0], 2);
    const isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const cartoStyle = isDarkMode ? 'dark_all' : 'light_all';
    L.tileLayer(`https://{s}.basemaps.cartocdn.com/${cartoStyle}/{z}/{x}/{y}{r}.png`, {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 18,
    }).addTo(map);

    const renderer = L.canvas({ padding: 0.5 });
    let dataLayer = L.layerGroup().addTo(map);
    let homeMarker: L.CircleMarker | null = null;
    const mapStatus = document.getElementById('map-status')!;

    // --- Grayline (day/night terminator) ---
    const graylineLayer = L.layerGroup();
    let graylineTimer: ReturnType<typeof setInterval> | undefined;

    function drawGrayline() {
      graylineLayer.clearLayers();
      const now = new Date();
      L.polyline(terminatorPoints(now), { color: ACCENT_2_COLOR, weight: 2, opacity: 0.8, dashArray: '6 6', renderer }).addTo(graylineLayer);
      const sun = subsolarPoint(now);
      L.circleMarker([sun.lat, sun.lon], { radius: 6, color: ACCENT_2_COLOR, fillColor: ACCENT_2_COLOR, fillOpacity: 1, weight: 1, renderer })
        .bindTooltip('Sun overhead here', { direction: 'top' })
        .addTo(graylineLayer);
    }

    document.getElementById('grayline-toggle')!.addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked;
      if (on) {
        drawGrayline();
        graylineLayer.addTo(map);
        graylineTimer = setInterval(drawGrayline, 5 * 60 * 1000);
      } else {
        map.removeLayer(graylineLayer);
        clearInterval(graylineTimer);
      }
    });

    // --- Real-time aurora forecast, from NOAA SWPC's own OVATION model
    // output (server-side proxy in api/src/routes/aurora.ts) -- not a
    // hand-derived oval from just the Kp index. Rendered on the same
    // canvas renderer the grayline/QSO arcs already use rather than
    // creating a second one, since Leaflet's canvas renderer batches
    // everything drawn through it onto one shared <canvas> regardless of
    // how many separate layers use it. ---
    const auroraLayer = L.layerGroup();
    let auroraTimer: ReturnType<typeof setInterval> | undefined;
    const auroraStatus = document.getElementById('aurora-status')!;

    async function drawAurora() {
      try {
        const res = await fetch('/api/aurora');
        const body = await res.json();
        if (!res.ok) {
          auroraStatus.textContent = body.error ?? 'Could not load aurora data.';
          return;
        }
        const { points, kp }: { points: [number, number, number][]; kp: number | null } = body;
        auroraLayer.clearLayers();
        for (const [lon, lat, aurora] of points) {
          // 3 (the server's own cutoff) to ~100 mapped onto a modest
          // opacity range -- low-probability edges of the oval fade in
          // rather than looking identical to its bright core.
          const opacity = Math.min(0.75, 0.12 + (aurora / 100) * 0.7);
          L.circleMarker([lat, lon], {
            radius: 3,
            stroke: false,
            fillColor: '#4ade80',
            fillOpacity: opacity,
            renderer,
          }).addTo(auroraLayer);
        }
        auroraStatus.textContent = kp != null ? `Planetary K-index: ${kp.toFixed(1)}` : '';
      } catch {
        auroraStatus.textContent = 'Could not load aurora data.';
      }
    }

    document.getElementById('aurora-toggle')!.addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked;
      if (on) {
        auroraStatus.textContent = 'Loading…';
        drawAurora();
        auroraLayer.addTo(map);
        auroraTimer = setInterval(drawAurora, 5 * 60 * 1000);
      } else {
        map.removeLayer(auroraLayer);
        clearInterval(auroraTimer);
        auroraStatus.textContent = '';
      }
    });

    // --- 3D globe view -- an orthographic projection (see lib/globe.ts)
    // rendered in a plain <canvas>, no WebGL/3D library. Reuses the same
    // QSO arc data the 2D map already fetches/computes rather than
    // running its own separate query. ---
    type GlobeArc = { points: [number, number][]; color: string; destLat: number; destLon: number };
    let lastGlobeData: { home: { lat: number; lon: number }; arcs: GlobeArc[] } | null = null;
    let globeActive = false;
    let landPolygons: [number, number][][] | null = null;

    const globeStyle = getComputedStyle(document.documentElement);
    const GLOBE_OCEAN = globeStyle.getPropertyValue('--globe-ocean').trim();
    const GLOBE_LAND = globeStyle.getPropertyValue('--globe-land').trim();
    const GLOBE_GRATICULE = globeStyle.getPropertyValue('--globe-graticule').trim();

    const globeCanvas = document.getElementById('qso-globe') as HTMLCanvasElement;
    const globeCtx = globeCanvas.getContext('2d')!;
    let centerLat = 15;
    let centerLon = -40;
    let rotateSpeedDegPerSec = 6;
    let lastFrameTime: number | null = null;
    let globeRafId: number | null = null;

    function toScreen(lat: number, lon: number, R: number, cx: number, cy: number) {
      const p = projectPoint(lat, lon, centerLat, centerLon);
      // Canvas y grows downward; the projection's y grows "up" (toward the
      // north pole when centered on the equator), so it's flipped here
      // rather than baked into the shared projection helper.
      return { x: cx + p.x * R, y: cy - p.y * R, z: p.z };
    }

    function renderGlobeFrame() {
      const w = globeCanvas.width;
      const h = globeCanvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const R = Math.min(w, h) * 0.46;
      globeCtx.clearRect(0, 0, w, h);

      const grad = globeCtx.createRadialGradient(cx - R * 0.3, cy - R * 0.35, R * 0.05, cx, cy, R);
      grad.addColorStop(0, GLOBE_OCEAN);
      grad.addColorStop(1, GLOBE_LAND === GLOBE_OCEAN ? GLOBE_OCEAN : GLOBE_OCEAN);
      globeCtx.beginPath();
      globeCtx.arc(cx, cy, R, 0, Math.PI * 2);
      globeCtx.fillStyle = grad;
      globeCtx.fill();

      // Graticule -- meridians every 30°, parallels at ±30/±60, drawn as
      // separate visible-only subpaths (see the module comment above) so
      // a line doesn't zigzag across the disc when it crosses the horizon.
      globeCtx.strokeStyle = GLOBE_GRATICULE;
      globeCtx.lineWidth = 1;
      for (let lon = -180; lon < 180; lon += 30) {
        globeCtx.beginPath();
        let drawing = false;
        for (let lat = -90; lat <= 90; lat += 3) {
          const pt = toScreen(lat, lon, R, cx, cy);
          if (pt.z > 0) {
            if (drawing) globeCtx.lineTo(pt.x, pt.y);
            else {
              globeCtx.moveTo(pt.x, pt.y);
              drawing = true;
            }
          } else {
            drawing = false;
          }
        }
        globeCtx.stroke();
      }
      for (let lat = -60; lat <= 60; lat += 30) {
        globeCtx.beginPath();
        let drawing = false;
        for (let lon = -180; lon <= 180; lon += 3) {
          const pt = toScreen(lat, lon, R, cx, cy);
          if (pt.z > 0) {
            if (drawing) globeCtx.lineTo(pt.x, pt.y);
            else {
              globeCtx.moveTo(pt.x, pt.y);
              drawing = true;
            }
          } else {
            drawing = false;
          }
        }
        globeCtx.stroke();
      }

      // Land -- only fills a ring when every one of its points is
      // currently on the visible hemisphere. A ring straddling the
      // horizon just doesn't render THIS frame rather than risking a
      // wrong fill shape from naively closing a path across the back of
      // the globe; it rotates into (or stays in) view a few frames
      // later, same as it left.
      if (landPolygons) {
        globeCtx.fillStyle = GLOBE_LAND;
        for (const ring of landPolygons) {
          let visible = true;
          const screenPts: { x: number; y: number }[] = [];
          for (const [lon, lat] of ring) {
            const pt = toScreen(lat, lon, R, cx, cy);
            if (pt.z <= 0) {
              visible = false;
              break;
            }
            screenPts.push(pt);
          }
          if (!visible || screenPts.length < 3) continue;
          globeCtx.beginPath();
          globeCtx.moveTo(screenPts[0].x, screenPts[0].y);
          for (let i = 1; i < screenPts.length; i++) globeCtx.lineTo(screenPts[i].x, screenPts[i].y);
          globeCtx.closePath();
          globeCtx.fill();
        }
      }

      // QSO arcs + destination dots + home marker.
      if (lastGlobeData) {
        for (const arc of lastGlobeData.arcs) {
          globeCtx.strokeStyle = arc.color;
          globeCtx.lineWidth = 1.2;
          globeCtx.beginPath();
          let prev: { x: number; y: number; z: number } | null = null;
          for (const [lat, lon] of arc.points) {
            const pt = toScreen(lat, lon, R, cx, cy);
            if (prev && prev.z > 0 && pt.z > 0) {
              globeCtx.moveTo(prev.x, prev.y);
              globeCtx.lineTo(pt.x, pt.y);
            }
            prev = pt;
          }
          globeCtx.stroke();

          const dest = toScreen(arc.destLat, arc.destLon, R, cx, cy);
          if (dest.z > 0) {
            globeCtx.beginPath();
            globeCtx.arc(dest.x, dest.y, 2.5, 0, Math.PI * 2);
            globeCtx.fillStyle = arc.color;
            globeCtx.fill();
          }
        }

        const homePt = toScreen(lastGlobeData.home.lat, lastGlobeData.home.lon, R, cx, cy);
        if (homePt.z > 0) {
          globeCtx.beginPath();
          globeCtx.arc(homePt.x, homePt.y, 5, 0, Math.PI * 2);
          globeCtx.fillStyle = ACCENT_COLOR;
          globeCtx.fill();
          globeCtx.lineWidth = 1.5;
          globeCtx.strokeStyle = '#fff';
          globeCtx.stroke();
        }
      }
    }

    function globeAnimationStep(t: number) {
      if (!globeActive) {
        globeRafId = null;
        lastFrameTime = null;
        return;
      }
      const dt = lastFrameTime == null ? 0 : (t - lastFrameTime) / 1000;
      lastFrameTime = t;
      if (!dragging) {
        centerLon += rotateSpeedDegPerSec * dt;
        if (centerLon > 180) centerLon -= 360;
      }
      renderGlobeFrame();
      globeRafId = requestAnimationFrame(globeAnimationStep);
    }

    function requestGlobeRedraw() {
      if (!globeActive || globeRafId != null) return;
      globeRafId = requestAnimationFrame(globeAnimationStep);
    }

    // Drag-to-rotate -- pointer events cover mouse and touch in one
    // handler set rather than separate mouse/touchstart listeners.
    let dragging = false;
    let dragLastX = 0;
    let dragLastY = 0;
    globeCanvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      dragLastX = e.clientX;
      dragLastY = e.clientY;
      globeCanvas.setPointerCapture(e.pointerId);
    });
    globeCanvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragLastX;
      const dy = e.clientY - dragLastY;
      dragLastX = e.clientX;
      dragLastY = e.clientY;
      // 0.35 deg/px -- tuned so a full canvas-width drag rotates a bit
      // more than halfway around, a comfortable one-swipe amount rather
      // than needing several drags to spin the globe around.
      centerLon += dx * 0.35;
      centerLat = Math.max(-85, Math.min(85, centerLat + dy * 0.35));
      if (centerLon > 180) centerLon -= 360;
      if (centerLon < -180) centerLon += 360;
    });
    const endDrag = () => {
      dragging = false;
    };
    globeCanvas.addEventListener('pointerup', endDrag);
    globeCanvas.addEventListener('pointercancel', endDrag);

    const view2dBtn = document.getElementById('view-2d-btn')!;
    const view3dBtn = document.getElementById('view-3d-btn')!;
    const globeWrap = document.getElementById('qso-globe-wrap')!;
    const mapDiv = document.getElementById('qso-map')!;

    async function activateGlobeView() {
      globeActive = true;
      view3dBtn.classList.add('active');
      view2dBtn.classList.remove('active');
      mapDiv.style.display = 'none';
      globeWrap.hidden = false;
      if (!landPolygons) {
        try {
          landPolygons = await loadLandPolygons();
        } catch {
          landPolygons = [];
        }
      }
      requestGlobeRedraw();
    }
    function activate2dView() {
      globeActive = false;
      view2dBtn.classList.add('active');
      view3dBtn.classList.remove('active');
      globeWrap.hidden = true;
      mapDiv.style.display = '';
      map.invalidateSize();
    }
    view3dBtn.addEventListener('click', activateGlobeView);
    view2dBtn.addEventListener('click', activate2dView);

    // The home marker is a fixed reference point, not "QSO data" — shown
    // immediately regardless of the filter state below, via its own fetch
    // rather than piggybacking on the (possibly-skipped) filtered one.
    fetch('/api/conditions/home')
      .then((r) => r.json())
      .then((home: { lat: number; lon: number } | null) => {
        if (!home || homeMarker) return;
        homeMarker = L.circleMarker([home.lat, home.lon], {
          radius: 7,
          color: ACCENT_COLOR,
          fillColor: ACCENT_COLOR,
          fillOpacity: 1,
          weight: 2,
          renderer,
        })
          .bindTooltip('Home', { permanent: true, direction: 'top', className: 'home-tooltip' })
          .addTo(map);
      });

    async function loadData(query: string) {
      dataLayer.clearLayers();

      if (!query) {
        mapStatus.textContent = 'No filters enabled — select a band, mode, country, state, or date range above to plot contacts.';
        return;
      }

      mapStatus.textContent = 'Loading…';
      const res = await fetch(`/api/qsos/geo?${query}`);
      const data: GeoResponse = await res.json();

      if (!data.home) {
        mapStatus.textContent = `Showing ${data.points.length} contacts (no home location on file)`;
        return;
      }

      // Reused by the 3D globe view below -- same arc points already
      // being computed for the 2D map's polylines, just kept around
      // instead of thrown away, so switching views doesn't mean
      // re-running greatCircleArc's spherical-slerp math a second time.
      const globeArcs: { points: [number, number][]; color: string; destLat: number; destLon: number }[] = [];

      for (const p of data.points) {
        const arc = greatCircleArc(data.home.lat, data.home.lon, p.lat, p.lon, 16);
        const color = colorForBand(p.band);
        globeArcs.push({ points: arc, color, destLat: p.lat, destLon: p.lon });
        const tooltipText = `${escapeHtml(p.call)} · ${escapeHtml(p.band ?? '—')} · ${escapeHtml(p.mode ?? '—')}`;
        const popupHtml = `<div class="qso-popup">
            <strong>${escapeHtml(p.call)}</strong><br/>
            ${formatDate(p.qsoDate)} · ${escapeHtml(p.band ?? '—')} · ${escapeHtml(p.mode ?? '—')}<br/>
            ${p.country || p.state || p.gridsquare ? `${escapeHtml(p.country ?? '')}${p.state ? `, ${escapeHtml(p.state)}` : ''}${p.gridsquare ? ` (${escapeHtml(p.gridsquare)})` : ''}<br/>` : ''}
            ${formatSolar(p) ? `<span style="color:var(--muted);">${escapeHtml(formatSolar(p))}</span><br/>` : ''}
            <a class="btn" href="https://www.qrz.com/db/${encodeURIComponent(p.call)}" target="_blank" rel="noopener">View on QRZ.com ↗</a>
            <a class="btn" href="https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${p.lat},${p.lon}" target="_blank" rel="noopener">Street View ↗</a>
          </div>`;

        const line = L.polyline(arc, { color, weight: 1.5, opacity: 0.65, renderer });
        line.bindTooltip(tooltipText, { sticky: true });
        line.bindPopup(popupHtml);
        dataLayer.addLayer(line);

        // A small dot at the destination — an easier click/hover target than the thin line.
        const dot = L.circleMarker([p.lat, p.lon], {
          radius: 4,
          color,
          fillColor: color,
          fillOpacity: 1,
          weight: 1,
          renderer,
        });
        dot.bindTooltip(tooltipText, { sticky: true });
        dot.bindPopup(popupHtml);
        dataLayer.addLayer(dot);
      }

      mapStatus.textContent = `Showing ${data.points.length} contacts`;
      lastGlobeData = { home: data.home, arcs: globeArcs };
      if (globeActive) requestGlobeRedraw();
    }

    initQsoFilters(loadData, { colorForBand, startUnselected: true });
  </script>
</Base>
