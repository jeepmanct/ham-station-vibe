  <style is:global>
    /* is:global -- these rows are created dynamically via
       document.createElement() in client JS, not present in this file's
       static markup, so Astro's default scoped-style hash attribute never
       gets attached to them and a normal scoped <style> block silently
       fails to match them at all (confirmed via the compiled output:
       .tl-row[data-astro-cid-...] {...} -- an attribute selector no
       dynamically-created element can ever satisfy). */
    .tl-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.7rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg);
      cursor: grab;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    .tl-row.dragging {
      opacity: 0.5;
      cursor: grabbing;
    }
    .tl-handle {
      color: var(--muted);
      font-size: 1.3rem;
      line-height: 1;
    }
    .tl-label {
      flex: 1;
    }
  </style>
