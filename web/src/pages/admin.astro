    async function saveServiceCredentials(body: Record<string, unknown>, statusEl: HTMLElement) {
      statusEl.textContent = 'Saving…';
      const res = await fetch('/api/service-credentials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
        body: JSON.stringify(body),
      });
      if (res.ok) {
        const cfg: ServiceCredentialsPublic = await res.json();
        crQrzKey.placeholder = cfg.qrzApiKeyConfigured ? 'leave blank to keep existing' : 'not yet set';
        crEqslPass.placeholder = cfg.eqslPasswordConfigured ? 'leave blank to keep existing' : 'not yet set';
        crLotwPass.placeholder = cfg.lotwPasswordConfigured ? 'leave blank to keep existing' : 'not yet set';
        crOrKey.placeholder = cfg.openRepeaterApiKeyConfigured ? 'leave blank to keep existing' : 'not yet set';
        crFlexIp.value = cfg.flexRadioIp;
        crOrLat.value = cfg.openRepeaterLat != null ? String(cfg.openRepeaterLat) : '';
        crOrLng.value = cfg.openRepeaterLng != null ? String(cfg.openRepeaterLng) : '';
        crOrRadius.value = String(cfg.openRepeaterRadiusKm);
        crHamqthUser.value = cfg.hamqthUsername;
        crHamqthPass.placeholder = cfg.hamqthPasswordConfigured ? 'leave blank to keep existing' : 'not yet set';
        crDmrTgs.value = cfg.brandmeisterTalkgroups;
        statusEl.textContent = 'Saved.';
      } else {
        const errBody = await res.json().catch(() => ({}));
        statusEl.textContent = errBody.error ?? 'Save failed.';
      }
    }

