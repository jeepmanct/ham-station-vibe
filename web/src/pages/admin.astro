    // --- Backups ---
    type BackupEntry = { name: string; date: string; sizeBytes: number };
    function formatBackupBytes(bytes: number): string {
      const mb = bytes / 1024 ** 2;
      return mb >= 1024 ? `${(mb / 1024).toFixed(1)} GB` : `${mb.toFixed(1)} MB`;
    }

    async function loadBackupStatus() {
      const res = await fetch('/api/backup/status', {
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
      });
      if (!res.ok) return;
      const { destination, backups }: { destination: string; backups: BackupEntry[] } = await res.json();
      document.getElementById('backup-destination')!.textContent = destination;
      const list = document.getElementById('backup-list')!;
      list.innerHTML = '';
      if (!backups.length) {
        list.innerHTML = '<p class="status-line" style="margin:0;">No backups yet.</p>';
        return;
      }
      for (const b of backups) {
        const row = document.createElement('div');
        row.style.cssText = 'border:1px solid var(--border);border-radius:8px;padding:0.6rem 0.75rem;';
        row.innerHTML = `
          <div style="display:flex;justify-content:space-between;align-items:center;gap:0.75rem;flex-wrap:wrap;">
            <span style="font-size:0.85rem;">${new Date(b.date).toLocaleString()} <span style="color:var(--muted);">(${formatBackupBytes(b.sizeBytes)})</span></span>
            <div style="display:flex;gap:0.4rem;">
              <a class="btn secondary" style="font-size:0.8rem;padding:0.35rem 0.7rem;" href="/api/backup/${encodeURIComponent(b.name)}/download" id="dl-${b.name}">Download</a>
              <button type="button" class="btn secondary" style="font-size:0.8rem;padding:0.35rem 0.7rem;color:var(--status-critical);" data-restore-name="${b.name}">Restore&hellip;</button>
            </div>
          </div>
          <div class="restore-confirm" id="restore-confirm-${b.name}" hidden style="margin-top:0.6rem;padding-top:0.6rem;border-top:1px solid var(--border);">
            <p style="margin:0 0 0.5rem;color:var(--status-critical);font-size:0.85rem;">This replaces the live database and photos with this backup's contents. A safety backup of the current state is taken first automatically, and the site restarts afterward. Type <strong>RESTORE</strong> to confirm:</p>
            <div style="display:flex;gap:0.5rem;">
              <input type="text" class="restore-confirm-input" placeholder="RESTORE" style="max-width:160px;" />
              <button type="button" class="btn" style="background:var(--status-critical);" data-restore-confirm-name="${b.name}">Confirm Restore</button>
              <button type="button" class="btn secondary" data-restore-cancel-name="${b.name}">Cancel</button>
            </div>
            <p class="status-line restore-status" id="restore-status-${b.name}"></p>
          </div>
        `;
        // The download link needs auth like everything else here, but a
        // plain <a href> can't send an Authorization header -- fetch the
        // file as the logged-in admin instead, then hand the browser a
        // local blob: URL to actually save, same end result for the user.
        row.querySelector<HTMLAnchorElement>(`#dl-${b.name}`)!.addEventListener('click', async (e) => {
          e.preventDefault();
          const dlRes = await fetch(`/api/backup/${encodeURIComponent(b.name)}/download`, {
            headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
          });
          if (!dlRes.ok) return;
          const blob = await dlRes.blob();
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${b.name}.tar.gz`;
          a.click();
          URL.revokeObjectURL(url);
        });
        row.querySelector<HTMLButtonElement>('[data-restore-name]')!.addEventListener('click', () => {
          document.getElementById(`restore-confirm-${b.name}`)!.hidden = false;
        });
        row.querySelector<HTMLButtonElement>('[data-restore-cancel-name]')!.addEventListener('click', () => {
          document.getElementById(`restore-confirm-${b.name}`)!.hidden = true;
        });
        row.querySelector<HTMLButtonElement>('[data-restore-confirm-name]')!.addEventListener('click', async () => {
          const input = row.querySelector<HTMLInputElement>('.restore-confirm-input')!;
          const restoreStatus = document.getElementById(`restore-status-${b.name}`)!;
          if (input.value !== 'RESTORE') {
            restoreStatus.textContent = 'Type RESTORE exactly to confirm.';
            return;
          }
          restoreStatus.textContent = 'Restoring… the site will be briefly unreachable while it restarts.';
          const res = await fetch(`/api/backup/${encodeURIComponent(b.name)}/restore`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
            body: JSON.stringify({ confirmPhrase: 'RESTORE' }),
          });
          if (res.ok) {
            restoreStatus.textContent = 'Restore complete — reloading…';
            setTimeout(() => window.location.reload(), 4000);
          } else {
            const body = await res.json().catch(() => ({}));
            restoreStatus.textContent = body.error ?? 'Restore failed.';
          }
        });
