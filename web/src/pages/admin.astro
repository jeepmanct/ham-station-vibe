---
import Base from '../layouts/Base.astro';
---
<Base title="Admin" active="admin">
  <h1>Admin</h1>

  <section id="login-section">
    <div class="card">
      <h2>Log in</h2>
      <form id="login-form">
        <input type="password" id="password" placeholder="Admin password" autocomplete="current-password" required />
        <p id="login-status" class="status-line"></p>
        <button type="submit" class="btn">Log in</button>
      </form>
    </div>
  </section>

  <section id="admin-tools" hidden>
    <div style="display:flex;justify-content:flex-end;margin-bottom:1rem;">
      <button type="button" id="logout-btn" class="btn secondary">Log out</button>
    </div>
    <div class="card">
      <h2>Upload photo</h2>
      <form id="upload-form" style="display:flex;flex-direction:column;gap:0.75rem;">
        <input type="file" id="photo-file" accept="image/*" required />
        <input type="text" id="photo-caption" placeholder="Caption (optional)" />
        <p id="upload-status" class="status-line"></p>
        <button type="submit" class="btn" style="align-self:flex-start;">Upload</button>
      </form>
    </div>

    <section>
      <div class="card">
        <h2>Station Info</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">
          Your callsign is used throughout the site (page branding, POTA/PSK Reporter/WSPR/RBN lookups, QSL cards, ADIF export) -- set this first, before anything else, on a fresh install. Location is used for grayline, satellite pass predictions, reception-report map centers, and anything else that needs to know where this station is; leave it unset to keep inferring it from whichever coordinate appears on the most logged QSOs.
        </p>
        <form id="station-location-form" class="form-grid">
          <label>Callsign<input type="text" id="sl-callsign" placeholder="e.g. W1AW" required /></label>
          <label style="grid-column:1 / -1;">City/State
            <span style="display:flex;gap:0.5rem;">
              <input type="text" id="sl-place" placeholder="e.g. Manchester, NH" style="flex:1;max-width:320px;" />
              <button type="button" id="sl-locate" class="btn secondary" style="white-space:nowrap;">Locate</button>
            </span>
          </label>
          <label>Latitude<input type="text" id="sl-lat" placeholder="e.g. 42.9956" /></label>
          <label>Longitude<input type="text" id="sl-lon" placeholder="e.g. -71.4548" /></label>
          <p id="sl-locate-status" class="status-line" style="grid-column:1 / -1;margin:-0.4rem 0 0;"></p>
          <p id="station-location-status" class="status-line"></p>
          <div style="grid-column:1 / -1;display:flex;gap:0.5rem;">
            <button type="submit" class="btn">Save</button>
            <button type="button" id="sl-clear" class="btn secondary">Clear location (use log inference)</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
          <h2 style="margin:0;">Page Layout</h2>
          <button type="button" class="btn secondary" id="tl-toggle">Show</button>
        </div>
        <div id="tl-section" hidden>
          <p style="margin:0.75rem 0 0.75rem;color:var(--muted);font-size:0.9rem;">
            Reorder or hide the links in the site's top navigation bar. Drag a row by its handle to reorder; uncheck a tile to hide it. Changes apply to every visitor once saved.
            Every other page's own tiles (Home, Tools, Electronics, Conditions, Awards, Stats, Radio, Digital Voice, Reference, Status) are edited the same way but <em>in place</em> instead &mdash; visit that page while logged in and use its floating "Edit Layout" button.
          </p>
          <ul id="tl-list" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:0.4rem;max-width:480px;"></ul>
          <p id="tl-status" class="status-line"></p>
          <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
            <button type="button" id="tl-save" class="btn">Save order</button>
            <button type="button" id="tl-reset" class="btn secondary">Reset to default</button>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Distance Units</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">
          Units used for distance displays across the site (Longest DX, reception reports, lightning strikes, etc). Doesn't affect /tools' calculators, which always show both, or the /stats distance-distribution chart, which is bucketed in fixed mile widths.
        </p>
        <form id="distance-unit-form" class="form-grid">
          <label style="max-width:220px;">Unit
            <select id="du-unit">
              <option value="mi">Miles</option>
              <option value="km">Kilometers</option>
            </select>
          </label>
          <p id="distance-unit-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>FlexRadio Hardware Status</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">
          Whether the Monitor toggle, On the Air, meters, and Recent Sessions show up on /radio at all &mdash; if you don't own a FlexRadio, turn this off instead of leaving a non-functional dashboard visible. Turning it off also turns monitoring off. PSK Reporter/WSPR/RBN reception reports stay up regardless &mdash; they're independent of this station's own radio.
        </p>
        <form id="radio-hardware-visibility-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="rhv-visible" /> Show FlexRadio hardware status on /radio</label>
          <p id="radio-hardware-visibility-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Remote Radio Control</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">
          Whether the Remote Control (Receive Only) card shows up on /radio at all &mdash; off by default while that feature's still being worked on. Hides it for everyone, not just while logged out. Also requires FlexRadio Hardware Status above to be on, since remote control needs the same live connection.
        </p>
        <form id="radio-control-visibility-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="rcv-visible" /> Show Remote Control card on /radio</label>
          <p id="radio-control-visibility-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>FlexRadio Configuration</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">The LAN IP address monitoring/control connects to &mdash; leave blank if you don't have a FlexRadio. Takes effect the next time monitoring reconnects, not immediately.</p>
        <form id="flex-config-form" class="form-grid">
          <label style="grid-column:1 / -1;">FlexRadio IP Address
            <span style="display:flex;gap:0.5rem;">
              <input type="text" id="cr-flex-ip" placeholder="e.g. 192.168.1.50" style="flex:1;max-width:220px;" />
              <button type="button" id="flex-detect" class="btn secondary" style="white-space:nowrap;">Detect</button>
            </span>
          </label>
          <p id="flex-detect-status" class="status-line" style="grid-column:1 / -1;margin:-0.4rem 0 0;"></p>
          <p id="flex-config-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>KiwiSDR Visibility</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Whether the /kiwisdr page shows its waterfall/audio/tuning at all &mdash; on by default. Turning this off stops any in-progress listeners too.</p>
        <form id="kiwi-visibility-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="kv-visible" /> Show KiwiSDR page content</label>
          <p id="kiwi-visibility-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>KiwiSDR Configuration</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">The LAN address the /kiwisdr page's waterfall and audio connect to &mdash; leave blank if you don't have a KiwiSDR. Port defaults to 8073 if omitted.</p>
        <form id="kiwi-config-form" class="form-grid">
          <label style="grid-column:1 / -1;">KiwiSDR Host<input type="text" id="cr-kiwi-host" placeholder="e.g. 192.168.1.50:8073" style="max-width:220px;" /></label>
          <p id="kiwi-config-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Lightning Monitoring</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Whether the persistent Blitzortung lightning-strike connection is running at all &mdash; off by default. Needs a Station Location set above to know what "nearby" means. Powers the map on /conditions and the Lightning alert below.</p>
        <form id="lightning-monitoring-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="lm-enabled" /> Lightning monitoring enabled</label>
          <p id="lightning-monitoring-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>DMR Talkgroups (BrandMeister)</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Which talkgroup(s) to show recent activity for on /radio's DMR Last Heard panel &mdash; no API key needed. Leave blank to hide that panel's activity feed.</p>
        <form id="dmr-config-form" class="form-grid">
          <label style="grid-column:1 / -1;">Talkgroup IDs (comma-separated)<input type="text" id="cr-dmr-tgs" placeholder="e.g. 91, 3120" /></label>
          <p id="dmr-config-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Service Credentials</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Stored server-side, never sent back to the browser once saved &mdash; leave a password field blank to keep what's already set.</p>
        <form id="creds-form" class="form-grid">
          <label>QRZ Logbook API Key<input type="password" id="cr-qrz-key" placeholder="leave blank to keep existing" autocomplete="new-password" /></label>
          <label>eQSL Callsign<input type="text" id="cr-eqsl-user" placeholder="W1AW" /></label>
          <label>eQSL Password<input type="password" id="cr-eqsl-pass" placeholder="leave blank to keep existing" autocomplete="new-password" /></label>
          <label>LoTW Callsign<input type="text" id="cr-lotw-user" placeholder="W1AW" /></label>
          <label>LoTW Password<input type="password" id="cr-lotw-pass" placeholder="leave blank to keep existing" autocomplete="new-password" /></label>
          <label>HamQTH Username<input type="text" id="cr-hamqth-user" placeholder="W1AW" /></label>
          <label>HamQTH Password<input type="password" id="cr-hamqth-pass" placeholder="leave blank to keep existing" autocomplete="new-password" /></label>
          <p style="grid-column:1 / -1;margin:-0.4rem 0 0;color:var(--muted);font-size:0.78rem;">Free account at <a href="https://www.hamqth.com/authenticate.php" target="_blank" rel="noopener">hamqth.com</a> &mdash; powers the public Callsign Lookup tool on /tools.</p>
          <p id="creds-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Repeater Lookup (Open Repeater)</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Admin-only reference tool, not shown anywhere on the public site.</p>
        <form id="or-config-form" class="form-grid">
          <label>Open Repeater API Key<input type="password" id="cr-or-key" placeholder="leave blank to keep existing" autocomplete="new-password" /></label>
          <label style="grid-column:1 / -1;">Search Location
            <span style="display:flex;gap:0.5rem;">
              <input type="text" id="or-place" placeholder="e.g. Manchester, NH" style="flex:1;max-width:320px;" />
              <button type="button" id="or-locate" class="btn secondary" style="white-space:nowrap;">Locate</button>
            </span>
          </label>
          <label>Latitude<input type="text" id="cr-or-lat" placeholder="e.g. 42.9956" /></label>
          <label>Longitude<input type="text" id="cr-or-lng" placeholder="e.g. -71.4548" /></label>
          <label>Search Radius (km)<input type="text" id="cr-or-radius" placeholder="50" /></label>
          <p id="or-locate-status" class="status-line" style="grid-column:1 / -1;margin:-0.4rem 0 0;"></p>
          <p style="grid-column:1 / -1;margin:-0.4rem 0 0;color:var(--muted);font-size:0.78rem;">Get a free key at <a href="https://www.openrepeater.org/api-docs" target="_blank" rel="noopener">openrepeater.org/api-docs</a> &mdash; type a city/state above and click Locate to fill in coordinates, or enter them directly.</p>
          <p id="or-config-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
        <button type="button" id="rb-verify" class="btn secondary" style="margin-top:0.75rem;">Verify connection</button>
        <p id="rb-verify-status" class="status-line"></p>
        <form id="rb-search-form" class="form-grid" style="margin-top:0.75rem;">
          <label class="form-grid-checkbox"><input type="checkbox" id="rb-mode-dmr" checked />DMR</label>
          <label class="form-grid-checkbox"><input type="checkbox" id="rb-mode-dstar" checked />D-STAR</label>
          <label class="form-grid-checkbox"><input type="checkbox" id="rb-mode-analog" checked />Analog FM</label>
          <label class="form-grid-checkbox"><input type="checkbox" id="rb-band-2m" checked />2m</label>
          <label class="form-grid-checkbox"><input type="checkbox" id="rb-band-440" checked />440 (70cm)</label>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Search</button>
          </div>
        </form>
        <p id="rb-search-status" class="status-line"></p>
        <div style="overflow-x:auto;">
          <table id="rb-results" hidden>
            <thead>
              <tr><th>Callsign</th><th>City</th><th>Freq</th><th>Offset</th><th>Mode</th><th>Band</th><th>Status</th></tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Sync from QRZ.com</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Pulls what's changed since the last sync via the QRZ Logbook API &mdash; Full Resync re-pulls the entire logbook.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <button type="button" id="qrz-sync" class="btn">Sync now</button>
          <button type="button" id="qrz-full-sync" class="btn secondary">Full Resync</button>
        </div>
        <p id="qrz-last-synced" class="status-line" style="font-size:0.8rem;"></p>
        <p id="qrz-status" class="status-line"></p>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Sync from eQSL.cc</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Marks already-logged QSOs as eQSL-confirmed, pulling only what's changed since the last sync &mdash; Full Resync re-checks the entire inbox.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <button type="button" id="eqsl-sync" class="btn">Sync now</button>
          <button type="button" id="eqsl-full-sync" class="btn secondary">Full Resync</button>
        </div>
        <p id="eqsl-last-synced" class="status-line" style="font-size:0.8rem;"></p>
        <p id="eqsl-status" class="status-line"></p>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Sync from LoTW</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Pulls every QSO on file via LoTW's own report mechanism &mdash; not just confirmations &mdash; incrementally since the last sync (Full Resync re-pulls everything). An alternative to downloading and importing the ADIF file by hand below.</p>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <button type="button" id="lotw-sync" class="btn">Sync now</button>
          <button type="button" id="lotw-full-sync" class="btn secondary">Full Resync</button>
        </div>
        <p id="lotw-last-synced" class="status-line" style="font-size:0.8rem;"></p>
        <p id="lotw-status" class="status-line"></p>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Import LoTW ADIF</h2>
        <form id="adif-form" style="display:flex;flex-direction:column;gap:0.75rem;">
          <input type="file" id="adif-file" accept=".adi,.adif" required />
          <p id="adif-status" class="status-line"></p>
          <button type="submit" class="btn" style="align-self:flex-start;">Import</button>
        </form>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Solar data</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">Refreshes recent SFI/A/K-index data associated with each QSO &mdash; Full Resync rebuilds the entire 1932&ndash;present history.</p>
        <button type="button" id="solar-sync" class="btn">Sync now</button>
        <button type="button" id="solar-full-sync" class="btn secondary">Full Resync</button>
        <p id="solar-last-synced" class="status-line" style="font-size:0.8rem;"></p>
        <p id="solar-status" class="status-line"></p>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Backups</h2>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.9rem;">A nightly job snapshots the database and photos to <code id="backup-destination">&mdash;</code>, keeping the last 3 on a rolling basis. Runs on its own timer &mdash; this button is just for an on-demand copy right now. Download a backup to save a copy to iCloud Drive (or wherever) via your device's own Save/Share sheet; upload one the same way to bring it back.</p>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button type="button" id="backup-run" class="btn">Back up now</button>
          <label class="btn secondary" style="cursor:pointer;">
            Upload a backup&hellip;
            <input type="file" id="backup-upload-input" accept=".gz,.tar.gz" style="display:none;" />
          </label>
        </div>
        <p id="backup-status" class="status-line"></p>
        <div id="backup-list" style="margin-top:0.75rem;display:flex;flex-direction:column;gap:0.5rem;"></div>
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Alerts &amp; Notifications</h2>
        <p style="margin:0 0 1.25rem;color:var(--muted);font-size:0.9rem;">
          Email and/or push notification for the alert types below &mdash; set up either delivery channel, or both, then turn on whichever ones you want.
        </p>

        <h3 style="margin:0 0 0.5rem;font-size:0.95rem;">Email</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          For iCloud Mail, use <code>smtp.mail.me.com</code> port <code>587</code> with an
          <a href="https://appleid.apple.com" target="_blank" rel="noopener">app-specific password</a> (your regular iCloud password won't work).
        </p>
        <form id="alert-email-form" class="form-grid">
          <label>SMTP Host<input type="text" id="ae-host" placeholder="smtp.mail.me.com" required /></label>
          <label>SMTP Port<input type="text" id="ae-port" placeholder="587" required /></label>
          <label>Username (from address)<input type="text" id="ae-user" placeholder="you@icloud.com" required /></label>
          <label>App Password<input type="password" id="ae-pass" placeholder="leave blank to keep existing" autocomplete="new-password" /></label>
          <label>Send Alerts To<input type="text" id="ae-to" placeholder="you@icloud.com" required /></label>
          <label class="form-grid-checkbox"><input type="checkbox" id="ae-enabled" /> Email alerts enabled</label>
          <p id="alert-email-status" class="status-line"></p>
          <div style="grid-column:1 / -1;display:flex;gap:0.75rem;flex-wrap:wrap;">
            <button type="submit" class="btn">Save</button>
            <button type="button" id="alert-email-test" class="btn secondary">Send test email</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Push Notification (ntfy.sh)</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          No account needed &mdash; install the <a href="https://ntfy.sh" target="_blank" rel="noopener">ntfy app</a> (iOS/Android), subscribe to the topic name below, and save it here to match.
          Treat the topic like a password: anyone who knows it can see (and send) your alerts, so keep it long and hard to guess.
        </p>
        <form id="alert-ntfy-form" class="form-grid">
          <label class="form-grid-wide">Topic name
            <div style="display:flex;gap:0.5rem;">
              <input type="text" id="an-topic" placeholder="e.g. dx-alert-7f3a9c2e" style="flex:1;" required />
              <button type="button" id="an-generate" class="btn secondary" style="white-space:nowrap;">Generate random</button>
            </div>
          </label>
          <label class="form-grid-checkbox"><input type="checkbox" id="an-enabled" /> Push alerts enabled</label>
          <p id="alert-ntfy-status" class="status-line"></p>
          <div style="grid-column:1 / -1;display:flex;gap:0.75rem;flex-wrap:wrap;">
            <button type="submit" class="btn">Save</button>
            <button type="button" id="alert-ntfy-test" class="btn secondary">Send test push</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Browser Push</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Real OS-level notifications straight from this site &mdash; no app or account needed, unlike ntfy above. Click &quot;Enable on this device&quot; separately from each phone/desktop you want alerts on.
        </p>
        <form id="alert-webpush-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="awp-enabled" /> Browser push enabled</label>
          <p id="alert-webpush-status" class="status-line"></p>
          <div style="grid-column:1 / -1;display:flex;gap:0.75rem;flex-wrap:wrap;">
            <button type="submit" class="btn">Save</button>
            <button type="button" id="awp-subscribe" class="btn secondary">Enable on this device</button>
            <button type="button" id="awp-unsubscribe" class="btn secondary">Disable on this device</button>
            <button type="button" id="awp-test" class="btn secondary">Send test push</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Needed-DX Spots</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when a live DX spot is a DXCC entity you haven't worked yet &mdash; checked every 10 minutes. Reuses whichever channel(s) above are enabled.
        </p>
        <form id="alert-dx-filter-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="adx-us-only" /> US spotters only &mdash; skip spots posted by a non-US station, since propagation heard by a US-based spotter is a much better sign you could actually work it</label>
          <p id="alert-dx-filter-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">VHF Band Openings (6m/2m Sporadic-E)</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when 6m or 2m DX-cluster activity shows up &mdash; checked every 5 minutes. Reuses whichever channel(s) above are enabled.
        </p>
        <form id="alert-vhf-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="av-enabled" /> VHF band-opening alerts enabled</label>
          <label class="form-grid-checkbox"><input type="checkbox" id="av-us-only" /> US spotters only &mdash; skip spots posted by a non-US station</label>
          <p id="alert-vhf-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">X-Class Solar Flares</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when an X-class flare (HF blackout risk) is in progress, via NOAA's real-time GOES X-ray flux &mdash; checked every 5 minutes, once per event. Reuses whichever channel(s) above are enabled.
        </p>
        <form id="alert-flare-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="af-enabled" /> Solar flare alerts enabled</label>
          <p id="alert-flare-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Solar Wind (Incoming Geomagnetic Storm)</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when the interplanetary magnetic field turns strongly southward &mdash; often 15-60 minutes ahead of a K-index rise or VHF/aurora opening. Checked every 5 minutes, once per event. Reuses whichever channel(s) above are enabled.
        </p>
        <form id="alert-wind-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="aw-enabled" /> Solar wind alerts enabled</label>
          <p id="alert-wind-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Geomagnetic Storm (Kp-Index / Aurora)</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when NOAA's planetary K-index reaches 5 or higher (G1 minor storm or stronger) &mdash; aurora often visible further south than usual, and possible 6m/2m aurora-mode openings. Checked every 5 minutes, once per event. Reuses whichever channel(s) above are enabled.
        </p>
        <form id="alert-kp-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="ak-enabled" /> Geomagnetic storm alerts enabled</label>
          <p id="alert-kp-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Tropospheric Ducting (VHF/UHF)</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when the atmosphere near your configured Station Location favors VHF/UHF tropo ducting &mdash; computed from real weather-forecast data (Open-Meteo), not a global feed, so it's specific to where you actually are. Requires a Station Location set above. Checked hourly, once per event.
        </p>
        <form id="alert-tropo-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="at-enabled" /> Tropo ducting alerts enabled</label>
          <p id="alert-tropo-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Satellite Passes</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you shortly before a good pass (20&deg;+ max elevation) of any enabled satellite over your configured Station Location. Requires a Station Location set above. Checked every 5 minutes, once per pass.
        </p>
        <form id="alert-sat-pass-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="asp-enabled" /> Satellite pass alerts enabled</label>
          <p id="alert-sat-pass-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Lightning</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when a lightning strike lands within 20km of your Station Location -- at most once every 30 minutes even during an active nearby storm. Requires Lightning Monitoring turned on above.
        </p>
        <form id="alert-lightning-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="al-enabled" /> Lightning alerts enabled</label>
          <p id="alert-lightning-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">DXCC Confirmations</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          Notifies you when a DXCC entity you'd worked but not yet confirmed becomes confirmed via LoTW &mdash; checked once daily, shortly after the QRZ/eQSL/LoTW syncs. Turning this on for the first time marks every entity already confirmed as known, so it only ever alerts on genuinely new confirmations, not your whole existing history.
        </p>
        <form id="alert-dxcc-confirmed-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="adc-enabled" /> DXCC confirmation alerts enabled</label>
          <p id="alert-dxcc-confirmed-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>

        <h3 style="margin:1.75rem 0 0.5rem;font-size:0.95rem;">Weekly DX Digest</h3>
        <p style="margin:0 0 0.75rem;color:var(--muted);font-size:0.85rem;">
          A weekly summary (new QSOs, new confirmations, newly-worked entities, best DX) &mdash; sent every Sunday regardless of activity level, unlike the threshold-triggered alerts above.
        </p>
        <form id="alert-dx-digest-form" class="form-grid">
          <label class="form-grid-checkbox"><input type="checkbox" id="add-enabled" /> Weekly DX Digest enabled</label>
          <p id="alert-dx-digest-status" class="status-line"></p>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn">Save</button>
          </div>
        </form>
      </div>
    </section>
  </section>

  <script>
    import { autoScrollWhileDragging } from '../lib/tileLayout';

    const TOKEN_KEY = 'hamstation_admin_token';

    const loginSection = document.getElementById('login-section')!;
    const adminTools = document.getElementById('admin-tools')!;
    const loginStatus = document.getElementById('login-status')!;

    function showAdmin() {
      loginSection.setAttribute('hidden', '');
      adminTools.removeAttribute('hidden');
      loadAlertConfig();
      loadServiceCredentials();
      loadSyncStatus();
      loadRadioControlVisibility();
      loadRadioHardwareVisibility();
      loadStationLocation();
      loadTileLayout(TL_PAGE);
      loadBackupStatus();
      loadKiwiVisibility();
      loadLightningMonitoring();
      loadDistanceUnit();
    }

    document.getElementById('login-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      loginStatus.textContent = 'Checking…';
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      if (res.ok) {
        const { token } = await res.json();
        sessionStorage.setItem(TOKEN_KEY, token);
        loginStatus.textContent = '';
        showAdmin();
      } else {
        loginStatus.textContent = 'Wrong password.';
      }
    });

    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      const token = sessionStorage.getItem(TOKEN_KEY);
      if (token) {
        await fetch('/api/auth/logout', { method: 'POST', headers: { Authorization: `Bearer ${token}` } }).catch(() => {});
      }
      sessionStorage.removeItem(TOKEN_KEY);
      adminTools.setAttribute('hidden', '');
      loginSection.removeAttribute('hidden');
    });

    // --- Station Info (callsign + QTH) -- callsign is used broadly across
    // the site (branding, POTA/PSK/WSPR/RBN lookups, ADIF export); location
    // feeds /api/conditions/home, used by grayline, satellite passes, and
    // reception-report map centers. ---
    type StationLocationData = { label: string | null; lat: number; lon: number; grid: string | null } | null;
    type StationInfoResponse = { callsign: string | null; location: StationLocationData };
    const slCallsign = document.getElementById('sl-callsign') as HTMLInputElement;
    const slPlace = document.getElementById('sl-place') as HTMLInputElement;
    const slLat = document.getElementById('sl-lat') as HTMLInputElement;
    const slLon = document.getElementById('sl-lon') as HTMLInputElement;
    const slLocateStatus = document.getElementById('sl-locate-status')!;
    const stationLocationStatus = document.getElementById('station-location-status')!;

    function renderStationInfoStatus(data: StationInfoResponse) {
      const parts: string[] = [];
      parts.push(data.callsign ? `Callsign: ${data.callsign}.` : 'No callsign set yet -- most site features need one.');
      parts.push(
        data.location
          ? `Location set${data.location.grid ? ` (grid ${data.location.grid})` : ''}.`
          : 'Location not set -- inferring from the most common logged QSO coordinate.',
      );
      stationLocationStatus.textContent = parts.join(' ');
    }

    async function loadStationLocation() {
      const res = await fetch('/api/station-location');
      if (!res.ok) return;
      const data: StationInfoResponse = await res.json();
      slCallsign.value = data.callsign ?? '';
      if (data.location) {
        slPlace.value = data.location.label ?? '';
        slLat.value = String(data.location.lat);
        slLon.value = String(data.location.lon);
      }
      renderStationInfoStatus(data);
    }

    document.getElementById('sl-locate')!.addEventListener('click', async () => {
      const place = slPlace.value.trim();
      if (!place) {
        slLocateStatus.textContent = 'Type a city/state first.';
        return;
      }
      slLocateStatus.textContent = 'Looking up…';
      const res = await fetch(`/api/geocode?q=${encodeURIComponent(place)}`);
      const body = await res.json().catch(() => null);
      if (!res.ok || !body) {
        slLocateStatus.textContent = 'Lookup failed.';
        return;
      }
      slLat.value = String(body.lat);
      slLon.value = String(body.lon);
      slLocateStatus.textContent = `Found: ${body.displayName}. Click Save to keep it.`;
    });

    document.getElementById('station-location-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!slCallsign.value.trim()) {
        stationLocationStatus.textContent = 'Callsign is required.';
        return;
      }
      stationLocationStatus.textContent = 'Saving…';
      const hasLocation = slLat.value.trim() && slLon.value.trim();
      const res = await fetch('/api/station-location', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
        body: JSON.stringify({
          callsign: slCallsign.value,
          ...(hasLocation ? { label: slPlace.value || undefined, lat: Number(slLat.value), lon: Number(slLon.value) } : {}),
        }),
      });
      if (res.ok) {
        const data: StationInfoResponse = await res.json();
        renderStationInfoStatus(data);
      } else {
        const body = await res.json().catch(() => ({}));
        stationLocationStatus.textContent = body.error ?? 'Save failed.';
      }
    });

    document.getElementById('sl-clear')!.addEventListener('click', async () => {
      stationLocationStatus.textContent = 'Clearing…';
      const res = await fetch('/api/station-location', {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
      });
      if (res.ok) {
        slPlace.value = '';
        slLat.value = '';
        slLon.value = '';
        slLocateStatus.textContent = '';
        const data: StationInfoResponse = await res.json();
        renderStationInfoStatus(data);
      } else {
        stationLocationStatus.textContent = 'Clear failed.';
      }
    });

    // --- Page Layout (tile order/visibility for Home, Tools, Electronics) ---
    // Each page's own tile IDs/labels are duplicated here since there's no
    // dynamic component registry to read them from -- keep in sync with the
    // data-tile-id attributes in index.astro/tools.astro/electronics.astro.
    // Every other page's own tiles (Home, Tools, Electronics, Conditions,
    // Awards, Stats, Radio, Digital Voice, Reference, Status) used to be
    // listed here too, back when this was the only way to reorder/hide
    // them -- now that each of those pages can be edited in place (see
    // lib/tileLayout.ts's enableInlineTileEditing()), this list only needs
    // to cover the one thing that still can't be: the nav bar itself, which
    // doesn't fit a drag-a-card metaphor.
    const PAGE_TILES: Record<string, { id: string; label: string }[]> = {
      nav: [
        { id: 'about', label: 'About' },
        { id: 'guestbook', label: 'Guestbook' },
        { id: 'photos', label: 'Photos' },
        { id: 'log', label: 'QSO Log' },
        { id: 'map', label: 'QSO Map' },
        { id: 'awards', label: 'Awards' },
        { id: 'stats', label: 'Stats' },
        { id: 'activations', label: 'Activations' },
        { id: 'conditions', label: 'Conditions' },
        { id: 'radio', label: 'Radio' },
        { id: 'digital-voice', label: 'Digital Voice' },
        { id: 'kiwisdr', label: 'KiwiSDR' },
        { id: 'satellites', label: 'Satellites' },
        { id: 'tools', label: 'Tools' },
        { id: 'electronics', label: 'Electronics' },
        { id: 'reference', label: 'Reference' },
        { id: 'status', label: 'Status' },
        { id: 'admin', label: 'Admin' },
      ],
    };

    const TL_PAGE = 'nav'; // the only page this editor still covers -- see PAGE_TILES's own comment for why
    const tlList = document.getElementById('tl-list')!;
    const tlStatus = document.getElementById('tl-status')!;
    const tlSection = document.getElementById('tl-section')!;
    const tlToggle = document.getElementById('tl-toggle') as HTMLButtonElement;

    // Starts collapsed -- this card's row list can get long (up to 15 nav
    // items), and unlike the other admin cards it's not something most
    // visits to this page actually need open.
    tlToggle.addEventListener('click', () => {
      const nowHidden = !tlSection.hidden;
      tlSection.hidden = nowHidden;
      tlToggle.textContent = nowHidden ? 'Show' : 'Hide';
    });

    // Pointer-based drag reorder -- works for mouse and touch alike, no
    // library needed. The listener is on the whole row (not just the
    // handle icon) so any part of the row starts a drag -- a handle-only
    // hit target turned out to be too easy to miss. The "Visible" checkbox
    // opts itself out below so it still just toggles normally.
    //
    // move/up/cancel are tracked on `document`, not the row itself -- an
    // earlier version relied on setPointerCapture() retargeting events back
    // to the row, but that turned out not to reliably deliver pointermove
    // in practice. Listening globally and filtering by pointerId sidesteps
    // that entirely and needs no capture API at all.
    function makeRowDraggable(row: HTMLLIElement) {
      row.addEventListener('pointerdown', (e) => {
        const ev = e as PointerEvent;
        if ((ev.target as HTMLElement).closest('label')) return; // let the checkbox's own click through
        // Without this, iOS Safari claims the gesture for its own touch
        // handling (text-selection callout) before pointermove ever gets a
        // chance to fire; on desktop it also stops an accidental text
        // selection drag from competing with the reorder.
        ev.preventDefault();
        const draggingPointerId = ev.pointerId;
        row.classList.add('dragging');

        let lastClientY = ev.clientY;
        const stopAutoScroll = autoScrollWhileDragging(() => lastClientY);

        function onMove(moveEv: PointerEvent) {
          if (moveEv.pointerId !== draggingPointerId) return;
          lastClientY = moveEv.clientY;
          const rows = Array.from(tlList.querySelectorAll<HTMLLIElement>('.tl-row:not(.dragging)'));
          const after = rows.find((r) => {
            const box = r.getBoundingClientRect();
            return moveEv.clientY < box.top + box.height / 2;
          });
          if (after) tlList.insertBefore(row, after);
          else tlList.appendChild(row);
        }
        function onEnd(endEv: PointerEvent) {
          if (endEv.pointerId !== draggingPointerId) return;
          row.classList.remove('dragging');
          stopAutoScroll();
          document.removeEventListener('pointermove', onMove);
          document.removeEventListener('pointerup', onEnd);
          document.removeEventListener('pointercancel', onEnd);
        }
        document.addEventListener('pointermove', onMove);
        document.addEventListener('pointerup', onEnd);
        document.addEventListener('pointercancel', onEnd);
      });
    }

    function renderTileRow(id: string, label: string, hidden: boolean): HTMLLIElement {
      const row = document.createElement('li');
      row.className = 'tl-row';
      row.dataset.id = id;
      row.innerHTML = `
        <span class="tl-handle">&#9776;</span>
        <span class="tl-label">${label}</span>
        <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.85rem;color:var(--muted);white-space:nowrap;cursor:default;">
          <input type="checkbox" class="tl-visible" ${hidden ? '' : 'checked'} /> Visible
        </label>
      `;
      makeRowDraggable(row);
      return row;
    }

    async function loadTileLayout(page: string) {
      tlStatus.textContent = 'Loading…';
      tlList.innerHTML = '';
      const manifest = PAGE_TILES[page] ?? [];
      let saved: { tileId: string; hidden: boolean }[] = [];
      try {
        const res = await fetch(`/api/tile-layout/${page}`);
        if (res.ok) saved = await res.json();
      } catch {
        // fall through with an empty saved layout -- default order, nothing hidden
      }
      const hiddenById = new Map(saved.map((e) => [e.tileId, e.hidden]));
      const orderedIds = [...saved.map((e) => e.tileId), ...manifest.map((t) => t.id)];
      const finalOrder = [...new Set(orderedIds)];
      const byId = new Map(manifest.map((t) => [t.id, t.label]));
      for (const id of finalOrder) {
        const label = byId.get(id);
        if (!label) continue; // saved layout referenced a tile that no longer exists on this page
        tlList.appendChild(renderTileRow(id, label, hiddenById.get(id) ?? false));
      }
      tlStatus.textContent = '';
    }

    document.getElementById('tl-save')!.addEventListener('click', async () => {
      const tiles = Array.from(tlList.querySelectorAll<HTMLLIElement>('.tl-row')).map((row) => ({
        id: row.dataset.id!,
        hidden: !(row.querySelector('.tl-visible') as HTMLInputElement).checked,
      }));
      tlStatus.textContent = 'Saving…';
      const res = await fetch(`/api/tile-layout/${TL_PAGE}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
        body: JSON.stringify({ tiles }),
      });
      tlStatus.textContent = res.ok ? 'Saved.' : 'Save failed.';
    });

    document.getElementById('tl-reset')!.addEventListener('click', async () => {
      tlStatus.textContent = 'Resetting…';
      const res = await fetch(`/api/tile-layout/${TL_PAGE}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
      });
      if (res.ok) {
        await loadTileLayout(TL_PAGE);
        tlStatus.textContent = 'Reset to default.';
      } else {
        tlStatus.textContent = 'Reset failed.';
      }
    });

    document.getElementById('upload-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fileInput = document.getElementById('photo-file') as HTMLInputElement;
      const caption = (document.getElementById('photo-caption') as HTMLInputElement).value;
      const status = document.getElementById('upload-status')!;
      if (!fileInput.files?.length) return;
      const form = new FormData();
      form.append('photo', fileInput.files[0]);
      form.append('caption', caption);
      status.textContent = 'Uploading…';
      const res = await fetch('/api/photos', {
        method: 'POST',
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
        body: form,
      });
      status.textContent = res.ok ? 'Uploaded!' : 'Upload failed.';
    });

    document.getElementById('adif-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fileInput = document.getElementById('adif-file') as HTMLInputElement;
      const status = document.getElementById('adif-status')!;
      if (!fileInput.files?.length) return;
      const form = new FormData();
      form.append('adif', fileInput.files[0]);
      status.textContent = 'Importing…';
      const res = await fetch('/api/qsos/import', {
        method: 'POST',
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
        body: form,
      });
      if (res.ok) {
        const { imported } = await res.json();
        status.textContent = `Imported ${imported} contacts.`;
      } else {
        status.textContent = 'Import failed.';
      }
    });

    // --- Service credentials (QRZ API key, eQSL login) -- stored server-side,
    // secrets never sent back to the browser once saved. ---
    type ServiceCredentialsPublic = {
      qrzApiKeyConfigured: boolean;
      eqslUsername: string;
      eqslPasswordConfigured: boolean;
      lotwUsername: string;
      lotwPasswordConfigured: boolean;
      flexRadioIp: string;
      openRepeaterApiKeyConfigured: boolean;
      openRepeaterLat: number | null;
      openRepeaterLng: number | null;
      openRepeaterRadiusKm: number;
      hamqthUsername: string;
      hamqthPasswordConfigured: boolean;
      brandmeisterTalkgroups: string;
      kiwisdrHost: string;
    };

    const crQrzKey = document.getElementById('cr-qrz-key') as HTMLInputElement;
    const crEqslUser = document.getElementById('cr-eqsl-user') as HTMLInputElement;
    const crEqslPass = document.getElementById('cr-eqsl-pass') as HTMLInputElement;
    const crLotwUser = document.getElementById('cr-lotw-user') as HTMLInputElement;
    const crLotwPass = document.getElementById('cr-lotw-pass') as HTMLInputElement;
    const crHamqthUser = document.getElementById('cr-hamqth-user') as HTMLInputElement;
    const crHamqthPass = document.getElementById('cr-hamqth-pass') as HTMLInputElement;
    const crFlexIp = document.getElementById('cr-flex-ip') as HTMLInputElement;
    const crOrKey = document.getElementById('cr-or-key') as HTMLInputElement;
    const crOrLat = document.getElementById('cr-or-lat') as HTMLInputElement;
    const crOrLng = document.getElementById('cr-or-lng') as HTMLInputElement;
    const crOrRadius = document.getElementById('cr-or-radius') as HTMLInputElement;
    const crDmrTgs = document.getElementById('cr-dmr-tgs') as HTMLInputElement;
    const crKiwiHost = document.getElementById('cr-kiwi-host') as HTMLInputElement;
    const credsStatus = document.getElementById('creds-status')!;
    const flexConfigStatus = document.getElementById('flex-config-status')!;
    const orConfigStatus = document.getElementById('or-config-status')!;
    const dmrConfigStatus = document.getElementById('dmr-config-status')!;
    const kiwiConfigStatus = document.getElementById('kiwi-config-status')!;

    async function loadServiceCredentials() {
      const res = await fetch('/api/service-credentials', {
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
      });
      if (!res.ok) return;
      const cfg: ServiceCredentialsPublic = await res.json();
