    async function loadAlertConfig() {
      const res = await fetch('/api/alert-config', {
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
      });
      if (!res.ok) return;
      const cfg: AlertConfigPublic = await res.json();
      aeHost.value = cfg.email.smtpHost || 'smtp.mail.me.com';
      aePort.value = String(cfg.email.smtpPort || 587);
      aeUser.value = cfg.email.smtpUser;
