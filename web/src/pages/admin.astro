    // --- Open Repeater lookup -- admin-only, never rendered on a public page. ---
    type OpenRepeaterEntry = {
      callsign: string;
      city: string | null;
      frequencyMhz: number;
      offsetMhz: number | null;
      mode: string;
      band: string;
      status: string;
    };

