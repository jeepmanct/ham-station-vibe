    const rbSearchStatus = document.getElementById('rb-search-status')!;
    const rbResultsTable = document.getElementById('rb-results') as HTMLTableElement;
    document.getElementById('rb-search-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const modes: string[] = [];
      if ((document.getElementById('rb-mode-dmr') as HTMLInputElement).checked) modes.push('DMR');
      if ((document.getElementById('rb-mode-dstar') as HTMLInputElement).checked) modes.push('D-Star');
      if ((document.getElementById('rb-mode-analog') as HTMLInputElement).checked) modes.push('FM');
      const bands = [
        ['2m', 'rb-band-2m'],
        ['70cm', 'rb-band-440'],
      ]
        .filter(([, id]) => (document.getElementById(id) as HTMLInputElement).checked)
        .map(([band]) => band);

      rbSearchStatus.textContent = 'Searching…';
      rbResultsTable.hidden = true;
      const params = new URLSearchParams({ modes: modes.join(','), bands: bands.join(',') });
      const res = await fetch(`/api/openrepeater/search?${params}`, {
        headers: { Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        rbSearchStatus.textContent = body.error ?? 'Search failed.';
        return;
      }
      const results: OpenRepeaterEntry[] = body.results;
      rbSearchStatus.textContent = `${results.length} repeater(s) found.`;
      const tbody = rbResultsTable.querySelector('tbody')!;
      tbody.replaceChildren(
        ...results.map((r) => {
          const tr = document.createElement('tr');
          const cells = [r.callsign, r.city ?? '', String(r.frequencyMhz), r.offsetMhz != null ? String(r.offsetMhz) : '', r.mode, r.band, r.status];
          for (const text of cells) {
            const td = document.createElement('td');
            td.textContent = text;
            tr.appendChild(td);
          }
          return tr;
        }),
      );
      rbResultsTable.hidden = results.length === 0;
    });

    // --- "Last synced" readouts for every sync button below, one shared
    // fetch against the small aggregated status endpoint rather than each
    // sync feature tracking/formatting its own. Refreshed on page load and
    // again after any sync completes, so a successful click updates its own
    // line immediately instead of waiting for the next page visit. ---
    // countLabel lets each source use its own wording (QRZ/LoTW import new
    // QSOs, eQSL only matches confirmations against QSOs already logged) --
    // shown even when 0, since "ran and found nothing new" vs "hasn't run
    // at all" is exactly the distinction this is for (e.g. confirming an
    // overnight auto-sync actually ran, not just guessing from the time).
    function formatLastSynced(iso: string | null, count: number | null, countLabel: string): string {
      if (!iso) return 'Never synced';
      const countText = count == null ? '' : ` — ${count} ${countLabel}`;
      return `Last synced ${new Date(iso).toLocaleString()}${countText}`;
    }
    async function loadSyncStatus() {
      const status: {
        qrz: string | null; qrzCount: number | null;
        eqsl: string | null; eqslCount: number | null;
        lotw: string | null; lotwCount: number | null;
        solar: string | null;
      } = await fetch('/api/sync-status').then((r) => r.json());
      document.getElementById('qrz-last-synced')!.textContent = formatLastSynced(status.qrz, status.qrzCount, 'imported');
      document.getElementById('eqsl-last-synced')!.textContent = formatLastSynced(status.eqsl, status.eqslCount, 'matched');
      document.getElementById('lotw-last-synced')!.textContent = formatLastSynced(status.lotw, status.lotwCount, 'imported');
      document.getElementById('solar-last-synced')!.textContent = formatLastSynced(status.solar, null, '');
    }

