        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${sessionStorage.getItem(TOKEN_KEY)}` },
        body: JSON.stringify({
          email: {
            smtpHost: aeHost.value.trim(),
            smtpPort: Number(aePort.value) || 587,
            smtpUser: aeUser.value.trim(),
            smtpPass: aePass.value || undefined,
            alertTo: aeTo.value.trim(),
            enabled: aeEnabled.checked,
          },
        }),
      });
      if (res.ok) {
        const cfg: AlertConfigPublic = await res.json();
        aePass.value = '';
        aePass.placeholder = cfg.email.passwordConfigured ? 'leave blank to keep existing' : 'app-specific password';
        alertEmailStatus.textContent = 'Saved.';
      } else {
        const body = await res.json().catch(() => ({}));
        alertEmailStatus.textContent = body.error ?? 'Save failed.';
