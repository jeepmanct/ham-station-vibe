__DOMAIN__ {
	# Compresses every response (HTML, JS/CSS, and JSON API payloads alike)
	# -- there was no compression at all before this, so e.g. the QSO map's
	# ~3MB geo JSON response went out fully uncompressed on every load.
	encode zstd gzip

	# Photo/log data and admin actions go to the Hono API.
	handle /api/* {
		reverse_proxy localhost:3000
	}
	handle /media/* {
		reverse_proxy localhost:3000
	}
	# Radio audio relay -- a real WebSocket, not request/response, so it
	# needs the same proxy treatment as the API rather than falling through
	# to the static file server below. Caddy's reverse_proxy handles the
	# Upgrade handshake automatically, no extra config needed for that part.
	handle /ws/* {
		reverse_proxy localhost:3000
	}

	# Device Stats and Sync Status merged into one /status page -- keep old
	# bookmarks/links working rather than letting them silently fall through
	# to the homepage via try_files below.
	redir /device-stats /status permanent
	redir /sync-status /status permanent

	# Astro content-hashes every filename under _astro/ (a rebuild produces
	# a new hash), so these are safe to cache forever -- without this,
	# every page load re-validates every JS/CSS chunk with the server
	# instead of using what's already in the browser's cache.
	@astroAssets path /_astro/*
	header @astroAssets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is the prebuilt Astro static site.
	handle {
		root * __APP_DIR__/web/dist
		file_server
		try_files {path} {path}/ /index.html
	}
}
